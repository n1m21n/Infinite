{"nodes": [{"id": "$graphify-root$_claude_skills_git_branch_workflow_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/skills/git-branch-workflow/SKILL.md", "source_location": "L1", "frontmatter": {"name": "git-branch-workflow", "description": "The standard branching workflow for this repo \u2014 every feature or bug fix request gets its own branch off main (feature/&lt;slug&gt; or bugfix/&lt;slug&gt;), work happens there, and it merges directly back into main (no PR, solo repo) once done. Replaces the old repo-privacy-split system. Use whenever the user asks for a new feature, a bug fix, or says &quot;start work on X&quot; \u2014 before writing any code \u2014 and when a piece of work is done and ready to land on main."}}, {"id": "$graphify-root$_claude_skills_git_branch_workflow_skill_the_rule", "label": "The rule", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/git-branch-workflow/SKILL.md", "source_location": "L9"}, {"id": "$graphify-root$_claude_skills_git_branch_workflow_skill_workflow", "label": "Workflow", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/git-branch-workflow/SKILL.md", "source_location": "L23"}, {"id": "$graphify-root$_claude_skills_git_branch_workflow_skill_notes", "label": "Notes", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/git-branch-workflow/SKILL.md", "source_location": "L49"}], "edges": [{"source": "$graphify-root$_claude_skills_git_branch_workflow_skill_md", "target": "$graphify-root$_claude_skills_git_branch_workflow_skill_the_rule", "relation": "contains", "confidence": "EXTRACTED", "source_file": ".claude/skills/git-branch-workflow/SKILL.md", "source_location": "L9", "weight": 1.0}, {"source": "$graphify-root$_claude_skills_git_branch_workflow_skill_md", "target": "$graphify-root$_claude_skills_git_branch_workflow_skill_workflow", "relation": "contains", "confidence": "EXTRACTED", "