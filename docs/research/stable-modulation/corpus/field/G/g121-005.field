# G set g121-005, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = (exp(p0) - 1)
f1 = if(p0 > 0.475930912, 1, 0)
f2 = p1*p1
f3 = sin(3.14159265358979*p1)
nx_z0 = 0.757436139*z0 + 0.247923666*z1 + f0*(0.176729706*z0) + f1*(-0.362205456*z0) + in
nx_z1 = -0.835404065*z0 + 0.637953193*z1 + f2*(-1.36067175*z0) + f3*(-0.482247567*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
