f1 = if(p0 > 0.614048477, 1, 0)
f2 = sin(3.14159265358979*p0)
f3 = if(p0 > 0.480768615, 1, 0)
f4 = (exp(p0) - 1)
nx_z0 = 0.266761533*z0 + 0.0862542325*z1 + -0.486976175*z2 + f0*(0.0278736193*z0 + 0.104269471*z2) + f1*(-0.520749405*z0) + f2*(-0.843775272*z1) + f3*(-0.357544943*z2) + in
nx_z1 = -0.638633414*z0 + -0.424018988*z1
nx_z2 = 0.588139679*z2 + f4*(-0.00151739266*z2) + f0*(-0.549992581*z2)
z0 = nx_z0
