# G set g121-179, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0*p0
f1 = sin(3.14159265358979*p1)
f2 = (exp(p0) - 1)
f3 = p0
f4 = p1
f5 = if(p1 > 0.749358706, 1, 0)
nx_z0 = 0.128437306*z0 + -0.00707312148*z1 + f0*(-0.767833443*z0) + f1*(0.187616951*z0) + in
nx_z1 = -0.437359962*z0 + -0.0124730582*z1 + 0.00856076227*z2 + f0*(2.66115026*z0) + f2*(-0.225860816*z0) + f3*(-0.0366682655*z2) + f4*(0.568872463*z2)
nx_z2 = 0.178104111*z1 + 0.0599351873*z2 + f5*(-2.14181263*z1)
z0 = nx_z0
