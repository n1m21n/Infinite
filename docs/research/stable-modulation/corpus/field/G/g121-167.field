# G set g121-167, n 2, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = (exp(p0) - 1)
f1 = if(p0 > 0.548104178, 1, 0)
f2 = p0*p0
nx_z0 = 0.121296149*z0 + f0*(-0.083252489*z0 + -0.255157648*z0) + in
nx_z1 = -0.152072212*z0 + -0.321391776*z1 + f1*(-0.649242733*z1) + f2*(0.0476135837*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
