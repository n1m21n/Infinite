f7 = if(p0 > 0.619079261, 1, 0)
nx_z0 = 0.339516269*z0 + -0.13359525*z1 + -0.0849015708*z2 + f0*(-0.204893922*z0) + f1*(-0.423365219*z0) + f2*(0.17207544*z2) + f3*(-0.286462551*z2) + in
nx_z1 = 0.53609729*z1 + -0.120547261*z2 + f4*(-0.283153458*z1) + f5*(0.230890081*z1) + f2*(-0.22624594*z2) + f6*(-0.214636839*z2)
nx_z2 = -0.284370943*z1 + -0.296649599*z2 + f7*(-0.424162169*z1)
