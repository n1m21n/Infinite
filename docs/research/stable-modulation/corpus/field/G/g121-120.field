nx_z0 = 0.733904671*z0 + -0.229587853*z3 + 0.0476317188*z4 + f0*(-0.281403905*z0) + in
nx_z1 = 0.368015357*z1 + 0.149990099*z3 + f1*(0.340489732*z3)
