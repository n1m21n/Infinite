# G set g121-000, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = (exp(p0) - 1)
f1 = p0
f2 = p1
f3 = if(p0 > 0.224524379, 1, 0)
f4 = p1*p1
f5 = p0*p0
nx_z0 = 0.669905615*z0 + -0.446776218*z1 + 0.243337584*z2 + f0*(0.280770883*z0) + f1*(0.122076371*z0 + -0.343524223*z1) + f2*(-0.083752383*z2) + in
nx_z1 = 0.145813156*z0 + 0.191963354*z1 + 0.057627072*z2 + f1*(0.759863939*z0) + f3*(-0.58825265*z2) + f4*(0.126314431*z2)
nx_z2 = 0.0795555639*z2 + f5*(0.103829481*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
