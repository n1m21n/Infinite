# G set g121-067, n 4, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
state float z3 = 0
f0 = p0*p0
f1 = (exp(p2) - 1)
f2 = if(p1 > 0.454437864, 1, 0)
f3 = p0
f4 = if(p1 > 0.686487898, 1, 0)
f5 = (exp(p0) - 1)
f6 = if(p0 > 0.624382731, 1, 0)
f7 = p2*p2
nx_z0 = 0.283136485*z0 + 0.404774887*z1 + -0.0392769837*z2 + f0*(-0.371487438*z0) + f1*(0.417636046*z0) + f2*(-0.815776312*z2) + f3*(-0.260499934*z2) + in
nx_z1 = -0.104397346*z1 + 0.0272984705*z2 + f4*(0.0573586442*z1) + f0*(0.233670469*z1)
nx_z2 = 0.602338878*z2 + -0.28374325*z3 + f5*(-0.37265167*z3)
nx_z3 = 0.356271255*z1 + -0.108459648*z3 + f6*(0.100352995*z1) + f7*(0.161970786*z3)
