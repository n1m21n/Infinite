# G set g121-069, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = sin(3.14159265358979*p1)
f1 = p0*p0
f2 = p1
f3 = (exp(p0) - 1)
nx_z0 = -0.538723881*z0 + -0.118389879*z1 + f0*(0.358675218*z0 + 0.666334982*z0) + f1*(-0.629513731*z1) + in
nx_z1 = 0.0762687993*z0 + 0.126597987*z1 + f2*(0.595931356*z0) + f3*(-0.448840374*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
