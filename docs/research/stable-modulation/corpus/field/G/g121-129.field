# G set g121-129, n 2, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p0 > 0.397651298, 1, 0)
f1 = (exp(p0) - 1)
f2 = if(p0 > 0.745628178, 1, 0)
f3 = p0
nx_z0 = 0.484745996*z0 + 0.63647394*z1 + f0*(-0.0178076782*z1) + f1*(-0.00968589182*z1) + in
nx_z1 = 0.776394977*z0 + -0.126164608*z1 + f2*(-0.306057753*z0) + f3*(0.731073862*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
