# G set g121-054, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p2*p2
f1 = (exp(p2) - 1)
f2 = sin(3.14159265358979*p0)
f3 = sin(3.14159265358979*p2)
nx_z0 = 0.98*z0 + f0*(-0.243685676*z0) + f1*(-0.0460345374*z0) + in
nx_z1 = 0.139000013*z1 + 0.126681274*z2
nx_z2 = 0.595565778*z2 + f2*(0.331280206*z2) + f3*(0.0434585123*z2)
z0 = nx_z0
