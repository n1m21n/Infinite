# G set g121-151, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0
f1 = if(p0 > 0.334794409, 1, 0)
f2 = (exp(p1) - 1)
f3 = p1*p1
f4 = p1
nx_z0 = 0.302058729*z0 + 0.18621549*z1 + -0.227138417*z2 + f0*(-0.125336906*z0) + f1*(-0.0113863252*z0) + in
nx_z1 = 0.434617303*z1 + f0*(0.517176122*z1)
nx_z2 = -0.134208159*z0 + 0.0682447474*z2 + f2*(0.219413176*z0) + f3*(0.422890439*z0) + f0*(-0.154591751*z2) + f4*(0.468419009*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
