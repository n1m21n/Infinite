f0 = if(p0 > 0.432758181, 1, 0)
f1 = if(p1 > 0.636574611, 1, 0)
f2 = (exp(p0) - 1)
f3 = p0
f4 = (exp(p1) - 1)
f5 = sin(3.14159265358979*p0)
f6 = if(p0 > 0.530033818, 1, 0)
f7 = p0*p0
f8 = sin(3.14159265358979*p1)
f9 = if(p0 > 0.644576227, 1, 0)
nx_z0 = 0.259803994*z0 + -0.10563065*z1 + 0.445767905*z3 + f0*(0.178157458*z0) + f1*(-0.0716120658*z0) + f2*(0.42511682*z1) + f3*(-0.0405303854*z3) + f4*(-0.0516679161*z3) + in
nx_z1 = 0.140767204*z1 + -0.162469918*z2 + f4*(0.433172153*z1) + f5*(-0.256559829*z1) + f6*(-0.08680722*z2) + f7*(-0.133751769*z2)
nx_z2 = -0.270981428*z0 + 0.0239185994*z2 + -0.201786042*z3 + f7*(0.0677904107*z0) + f8*(0.228369747*z0) + f3*(-0.458114715*z2) + f2*(0.173867638*z2) + f5*(0.0349691949*z3)
nx_z3 = 0.121495123*z0 + -0.0845136855*z2 + 0.219638742*z3 + f5*(0.205511776*z0) + f9*(-0.100472832*z2) + f7*(-0.0498931459*z3) + f8*(0.217062803*z3)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
z3 = nx_z3
out = z0
