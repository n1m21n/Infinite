# G set g121-088, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p0
f1 = sin(3.14159265358979*p0)
f2 = (exp(p0) - 1)
f3 = p2
nx_z0 = 0.149082848*z0 + -0.0122812497*z1 + f0*(0.00791703152*z0) + f1*(0.0556352107*z0) + f2*(-0.34098512*z1) + f3*(0.362630144*z1) + in
nx_z1 = 0.98*z1
z0 = nx_z0
z1 = nx_z1
out = z0
