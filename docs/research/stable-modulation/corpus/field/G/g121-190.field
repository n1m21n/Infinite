# G set g121-190, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p2)
f1 = (exp(p1) - 1)
f2 = p1*p1
f3 = if(p1 > 0.763286161, 1, 0)
f4 = if(p0 > 0.389739407, 1, 0)
f5 = (exp(p2) - 1)
f6 = p1
nx_z0 = 0.207129554*z0 + -0.612232052*z1 + -0.100390581*z2 + f0*(0.296299898*z1) + in
nx_z1 = -0.293754935*z0 + 0.182784364*z1 + -0.0172465536*z2 + f1*(0.49564833*z0) + f2*(0.656259835*z1) + f3*(0.046322812*z1) + f4*(-0.452479473*z2)
nx_z2 = 0.0803317324*z0 + 0.622731135*z2 + f5*(-0.335566363*z0) + f6*(-0.0721898102*z0)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
