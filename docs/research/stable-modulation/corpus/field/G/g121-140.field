# G set g121-140, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p0)
f1 = if(p1 > 0.219358843, 1, 0)
f2 = p1
f3 = if(p2 > 0.460410638, 1, 0)
f4 = (exp(p1) - 1)
f5 = if(p0 > 0.386744167, 1, 0)
f6 = (exp(p2) - 1)
f7 = p2*p2
nx_z0 = 0.411264471*z0 + -0.180724557*z2 + f0*(-0.342412516*z0) + f1*(-0.686849453*z0) + f2*(-0.742951507*z2) + in
nx_z1 = -0.533021628*z0 + 0.164311438*z1 + f3*(0.399836753*z0) + f4*(-0.206140749*z0) + f5*(-0.0781091572*z1)
nx_z2 = 0.174412697*z1 + 0.120485542*z2 + f0*(-0.22954456*z1) + f6*(-0.23799289*z1 + -0.388528427*z2) + f7*(0.108407993*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
