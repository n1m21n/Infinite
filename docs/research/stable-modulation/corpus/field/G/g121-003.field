# G set g121-003, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0
f1 = sin(3.14159265358979*p0)
f2 = p1
f3 = if(p1 > 0.367702263, 1, 0)
f4 = (exp(p1) - 1)
f5 = if(p1 > 0.550380164, 1, 0)
nx_z0 = 0.455689912*z0 + 0.355763303*z1 + 0.035838107*z2 + f0*(0.135784311*z1) + f1*(0.48785802*z1) + f2*(0.112364118*z2) + f3*(0.390934823*z2) + in
nx_z1 = -0.0487084303*z0 + 0.428534517*z1 + f1*(-0.0897308179*z0 + 0.545403924*z0)
nx_z2 = 0.227004471*z0 + 0.261359258*z2 + f4*(-0.43553714*z2) + f5*(0.459238237*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
