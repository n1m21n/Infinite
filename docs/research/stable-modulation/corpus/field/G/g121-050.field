nx_z0 = 0.0185779326*z0 + -0.0150409163*z2 + 0.126290167*z3 + f0*(0.110291197*z0) + f1*(0.0575532767*z2) + f2*(0.224064623*z3) + f3*(0.11593786*z3) + in
