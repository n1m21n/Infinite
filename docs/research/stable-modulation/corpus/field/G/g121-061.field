# G set g121-061, n 3, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p0)
f1 = if(p0 > 0.75309884, 1, 0)
f2 = p0*p0
nx_z0 = 0.360121599*z0 + 0.176046953*z2 + in
nx_z1 = 0.340103721*z0 + -0.436123541*z1 + -0.0441400565*z2 + f0*(0.593498836*z0 + 0.324954058*z2 + -0.368075943*z2) + f1*(0.0924520945*z0) + f2*(0.10205262*z1 + 0.20845311*z1)
nx_z2 = 1.03122024*z2 + f0*(0.0801062646*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
