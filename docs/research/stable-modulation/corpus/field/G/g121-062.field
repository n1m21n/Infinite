# G set g121-062, n 4, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
state float z3 = 0
f0 = p0
f1 = (exp(p0) - 1)
f2 = if(p0 > 0.659298951, 1, 0)
f3 = if(p0 > 0.274090278, 1, 0)
nx_z0 = 0.144567252*z0 + -0.104339185*z3 + f0*(0.0675071016*z0 + 0.15379689*z0) + in
nx_z1 = 0.124339809*z1 + f1*(0.4979743*z1)
nx_z2 = 0.0499190047*z0 + 0.198125301*z2 + f2*(-0.196339405*z0) + f3*(0.502075645*z0)
nx_z3 = 0.31635575*z3
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
z3 = nx_z3
out = z0
