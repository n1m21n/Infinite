# G set g121-048, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = sin(3.14159265358979*p0)
f1 = (exp(p1) - 1)
f2 = if(p0 > 0.381326621, 1, 0)
f3 = if(p0 > 0.492024745, 1, 0)
nx_z0 = 0.98*z0 + f0*(-0.319820633*z0) + in
nx_z1 = 0.0614849294*z0 + -0.0541984335*z1 + f1*(0.0655215469*z0) + f2*(-0.571648333*z0) + f3*(0.348069516*z1) + f0*(0.0575228718*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
