# G set g121-198, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0*p0
f1 = (exp(p1) - 1)
f2 = if(p0 > 0.3714172, 1, 0)
f3 = p0
f4 = if(p2 > 0.327904503, 1, 0)
f5 = sin(3.14159265358979*p1)
nx_z0 = 0.260156986*z0 + -0.206337516*z2 + f0*(-0.0587314516*z0) + f1*(0.354957317*z0) + f2*(-0.0876549216*z2) + in
nx_z1 = 0.394519719*z1 + -0.467796564*z2 + f1*(0.23761688*z1) + f3*(0.116741664*z2)
nx_z2 = -0.0273579883*z0 + -0.239076652*z1 + 0.106298297*z2 + f4*(-0.0724049636*z1) + f5*(-0.147373407*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
