# G set g121-146, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0
f1 = p1*p1
f2 = p2*p2
f3 = sin(3.14159265358979*p1)
nx_z0 = 0.245599912*z0 + f0*(-0.52052735*z0) + in
nx_z1 = 0.0279561194*z1 + -0.0467135145*z2 + f1*(0.930856738*z1) + f2*(-0.551319036*z1) + f3*(-0.3288307*z2)
nx_z2 = 0.98*z2 + f3*(-0.627102518*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
