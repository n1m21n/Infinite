f6 = if(p1 > 0.781113238, 1, 0)
nx_z0 = -0.455649388*z0 + 0.326889949*z2 + f0*(0.0680270473*z0) + f1*(-0.309373946*z0) + f2*(0.209537817*z2) + in
nx_z1 = -0.368953568*z0 + 0.672995021*z1 + 0.339315912*z2 + f3*(-0.122522846*z0) + f4*(-0.075915325*z0) + f5*(-0.727220525*z1) + f6*(-0.235569296*z2)
nx_z2 = 0.0928823802*z0 + 0.26758879*z2 + f2*(0.678950675*z0)
