# G set g121-018, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p0)
f1 = p0*p0
f2 = p0
f3 = (exp(p1) - 1)
f4 = if(p0 > 0.745640415, 1, 0)
f5 = p1
nx_z0 = 0.0906474632*z0 + f0*(-0.0663967484*z0) + f1*(0.0508225606*z0) + in
nx_z1 = 0.459131712*z1 + 0.0223734608*z2 + f2*(0.112893709*z2) + f3*(0.49773103*z2)
nx_z2 = 0.046533321*z0 + -0.0151926536*z1 + 0.104933825*z2 + f4*(0.235453525*z0) + f0*(-0.352558739*z0) + f5*(-0.253870115*z1) + f3*(-0.379390214*z1)
z0 = nx_z0
z1 = nx_z1
