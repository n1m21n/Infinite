# G set g121-094, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = sin(3.14159265358979*p0)
f1 = (exp(p2) - 1)
nx_z0 = 0.576765024*z0 + -0.34665132*z1 + f0*(0.213467855*z0) + f1*(0.303696785*z1) + in
nx_z1 = -0.559502125*z0 + -0.0420535038*z1
z0 = nx_z0
z1 = nx_z1
out = z0
