# G set g121-150, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = (exp(p0) - 1)
f1 = sin(3.14159265358979*p2)
nx_z0 = 0.326524547*z0 + in
nx_z1 = 0.389385943*z1 + f0*(0.343723624*z1) + f1*(-0.198157854*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
