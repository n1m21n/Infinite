f1 = p0
f2 = (exp(p1) - 1)
f3 = if(p1 > 0.577716047, 1, 0)
f4 = if(p1 > 0.586197482, 1, 0)
f5 = if(p0 > 0.435794617, 1, 0)
f6 = sin(3.14159265358979*p1)
nx_z0 = 0.937715201*z0 + 0.310277829*z1 + 0.39771789*z2 + f0*(0.39975656*z1) + f1*(-0.234120619*z1) + f2*(0.0519551601*z2) + in
nx_z1 = 0.0957781128*z0 + 0.585792156*z1 + -0.154995456*z2 + f3*(0.538998989*z0) + f2*(-0.252123995*z1) + f4*(0.620053183*z2)
nx_z2 = -0.243995026*z1 + 0.580200362*z2 + f5*(-0.150190352*z1) + f2*(-0.53529692*z1) + f6*(-0.197566621*z2)
