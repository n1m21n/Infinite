f1 = (exp(p0) - 1)
f2 = p0
nx_z0 = 1.02753099*z0 + 0.256666672*z2 + f0*(0.116376222*z2) + in
nx_z1 = 0.664666834*z1 + f1*(0.0796035966*z1)
nx_z2 = -0.0658728597*z1 + 0.605405985*z2 + f2*(0.309215632*z2)
z0 = nx_z0
