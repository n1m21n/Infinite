state float z1 = 0
f0 = sin(3.14159265358979*p2)
f1 = if(p2 > 0.473481996, 1, 0)
f2 = (exp(p0) - 1)
f3 = sin(3.14159265358979*p1)
nx_z0 = 0.465077351*z0 + 0.17397109*z1 + f0*(0.397043545*z0) + f1*(0.133842421*z1) + f2*(-0.43569088*z1) + in
nx_z1 = 0.145005721*z0 + 0.444587717*z1 + f3*(-0.399036199*z1) + f0*(-0.612743603*z1)
z0 = nx_z0
