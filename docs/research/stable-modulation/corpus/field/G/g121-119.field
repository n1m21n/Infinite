# G set g121-119, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p1*p1
f1 = p1
f2 = if(p1 > 0.349332782, 1, 0)
f3 = p0*p0
f4 = (exp(p0) - 1)
nx_z0 = 0.762002111*z0 + -0.254759026*z1 + f0*(0.184676108*z0) + f1*(-0.289066857*z0) + f2*(0.161538279*z1) + f3*(0.17115302*z1) + in
nx_z1 = 0.576100562*z1 + f4*(-0.154599028*z1 + 0.394351476*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
