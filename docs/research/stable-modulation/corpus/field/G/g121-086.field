# G set g121-086, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p0 > 0.577750972, 1, 0)
f1 = if(p0 > 0.548739916, 1, 0)
f2 = (exp(p1) - 1)
nx_z0 = 0.157932293*z0 + -1.61776098*z1 + f0*(0.512998652*z0) + in
nx_z1 = 0.324648407*z0 + -0.381472313*z1 + f1*(-0.193505404*z1) + f2*(0.712120329*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
