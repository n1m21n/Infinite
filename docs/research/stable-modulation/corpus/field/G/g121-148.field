f0 = p1
f1 = p0*p0
f2 = sin(3.14159265358979*p0)
nx_z0 = 0.376000644*z0 + 0.0774060098*z1 + f0*(-0.35698833*z0) + f1*(-0.436247102*z0) + in
nx_z1 = 0.855485119*z1
nx_z2 = 1.36294408*z1 + 0.154669273*z2 + f2*(-1.13466927*z2)
z0 = nx_z0
