# G set g121-036, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p0*p0
f1 = p0
f2 = p1*p1
f3 = p1
f4 = sin(3.14159265358979*p0)
nx_z0 = 0.251294913*z0 + f0*(0.532844333*z0) + f1*(-0.0999555113*z0) + in
nx_z1 = -0.449760726*z0 + 0.517680125*z1 + f2*(-0.299506802*z0) + f3*(-0.502655124*z0) + f4*(0.462319875*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
