# G set g121-037, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p1)
f1 = (exp(p0) - 1)
f2 = p0
f3 = if(p0 > 0.398437347, 1, 0)
nx_z0 = 0.159013647*z0 + 0.460616005*z1 + 0.154367304*z2 + f0*(0.826249902*z0 + -0.462746168*z1) + f1*(0.364433252*z2) + in
nx_z1 = 0.238202679*z1 + f2*(-0.411106647*z1)
nx_z2 = -0.0170884919*z0 + 0.464694539*z2 + f3*(0.0499325529*z0)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
