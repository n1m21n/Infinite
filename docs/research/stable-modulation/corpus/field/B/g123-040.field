# G set g123-040, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p0
f1 = if(p0 > 0.562767942, 1, 0)
f2 = if(p1 > 0.561731108, 1, 0)
f3 = if(p0 > 0.542457417, 1, 0)
nx_z0 = 0.859090166*z0 + -0.284459636*z1 + f0*(-0.440625341*z0) + f1*(-0.27328531*z0) + f2*(-0.930344551*z1) + in
nx_z1 = 0.144830438*z0 + 0.131873838*z1 + f3*(0.614045474*z0)
z0 = nx_z0
z1 = nx_z1
out = z0
