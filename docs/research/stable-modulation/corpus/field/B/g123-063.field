# G set g123-063, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0
f1 = if(p1 > 0.440355601, 1, 0)
f2 = if(p1 > 0.400384209, 1, 0)
f3 = p1*p1
f4 = p1
f5 = (exp(p1) - 1)
f6 = sin(3.14159265358979*p0)
nx_z0 = -0.139715551*z0 + -0.0549245389*z1 + 0.228976576*z2 + f0*(0.299184826*z2) + f1*(-0.049887239*z2) + in
nx_z1 = 0.0258788933*z0 + 0.693592727*z1 + -0.169175709*z2 + f2*(0.34196271*z1) + f3*(-0.465611421*z2)
nx_z2 = 0.195415494*z0 + 0.215478466*z2 + f4*(0.173261024*z0) + f5*(-0.0345759877*z0 + 0.189606042*z2) + f6*(0.205138434*z2)
