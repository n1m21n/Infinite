# G set g123-072, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = if(p1 > 0.530488816, 1, 0)
f1 = p0*p0
f2 = if(p1 > 0.745915478, 1, 0)
f3 = sin(3.14159265358979*p1)
f4 = if(p1 > 0.208480644, 1, 0)
f5 = (exp(p1) - 1)
f6 = if(p0 > 0.453434902, 1, 0)
nx_z0 = 0.62530196*z0 + -1.45043789*z1 + 1.23341936*z2 + f0*(-0.000034250680775*z0) + f1*(0.159837228*z0) + f2*(-0.536231079*z1) + f3*(1.40618079*z2) + f4*(-0.123935654*z2) + in
nx_z1 = 0.0480335592*z1 + f5*(0.228548632*z1) + f6*(0.228945335*z1)
nx_z2 = 0.98*z2
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
