# G set g123-155, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p0 > 0.40468926, 1, 0)
f1 = p1
nx_z0 = 0.679559104*z0 + 0.0848469579*z1 + f0*(0.171089973*z0) + in
nx_z1 = 0.274862773*z0 + 0.182223502*z1 + f1*(0.462229607*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
