# G set g123-143, n 4, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
state float z3 = 0
f0 = if(p0 > 0.751339642, 1, 0)
f1 = if(p0 > 0.265189255, 1, 0)
f2 = (exp(p0) - 1)
nx_z0 = 0.574601447*z0 + in
nx_z1 = 0.125900275*z1 + -0.604224024*z2 + f0*(0.118057912*z2)
nx_z2 = 0.0307556805*z0 + 0.365664692*z2
nx_z3 = 0.476732526*z2 + 0.502031662*z3 + f1*(0.0168803863*z3) + f2*(0.332804862*z3)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
z3 = nx_z3
out = z0
