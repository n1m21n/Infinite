# G set g123-132, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p0*p0
f1 = sin(3.14159265358979*p1)
nx_z0 = 0.592575554*z0 + 0.186737595*z1 + f0*(-0.403438902*z0) + in
nx_z1 = -0.0720897702*z0 + 0.355465612*z1 + f0*(1.13698507*z0) + f1*(0.373092736*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
