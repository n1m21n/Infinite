# G set g123-097, n 3, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = (exp(p0) - 1)
f1 = if(p0 > 0.489307516, 1, 0)
f2 = sin(3.14159265358979*p0)
f3 = if(p0 > 0.521506792, 1, 0)
f4 = if(p0 > 0.491595499, 1, 0)
nx_z0 = 0.67670974*z0 + -0.404579853*z1 + f0*(0.194581096*z1) + f1*(0.522899813*z1) + in
nx_z1 = 0.473142133*z0 + 0.113887863*z1 + f2*(-0.290025858*z1)
nx_z2 = 0.32108711*z1 + -0.290858425*z2 + f3*(0.0835888099*z2) + f4*(-0.124897167*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
