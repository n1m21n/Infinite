# G set g123-111, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p2*p2
f1 = p0*p0
f2 = sin(3.14159265358979*p1)
f3 = if(p2 > 0.517974484, 1, 0)
nx_z0 = 0.765194927*z0 + 0.150291874*z2 + f0*(0.320725022*z2) + in
nx_z1 = 1.01483226*z1 + -0.225714153*z2 + f1*(-0.138701579*z1) + f2*(-0.122790069*z1)
nx_z2 = -0.317011359*z1 + 0.281268191*z2 + f1*(-0.196860266*z2) + f3*(0.303792343*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
