# G set g123-158, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = sin(3.14159265358979*p1)
f1 = sin(3.14159265358979*p2)
f2 = if(p1 > 0.611841967, 1, 0)
f3 = if(p0 > 0.742348854, 1, 0)
f4 = (exp(p2) - 1)
nx_z0 = -0.205380475*z0 + -0.0518203317*z1 + f0*(-0.736763589*z0) + f1*(0.528248693*z0) + f2*(0.548718804*z1) + in
nx_z1 = 0.350577743*z1 + f3*(0.249288906*z1) + f4*(0.221228755*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
