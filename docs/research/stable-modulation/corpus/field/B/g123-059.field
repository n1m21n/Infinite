# G set g123-059, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p1 > 0.750929652, 1, 0)
f1 = p2
f2 = if(p0 > 0.775914381, 1, 0)
nx_z0 = -0.527925665*z0 + 0.111203545*z1 + f0*(-0.453027824*z1) + in
nx_z1 = -0.0365226459*z0 + 0.455949854*z1 + f1*(0.197949008*z0) + f2*(0.601891202*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
