f1 = p0*p0
f2 = if(p2 > 0.210798238, 1, 0)
nx_z0 = 1.14263855*z0 + 0.0850238049*z1 + f0*(-0.166354183*z0) + in
nx_z1 = -2.56720642*z0 + 0.634002274*z1 + f1*(0.707369391*z0) + f2*(-0.208069978*z0)
z0 = nx_z0
