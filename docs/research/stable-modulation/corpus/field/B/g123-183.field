f5 = (exp(p1) - 1)
nx_z0 = 0.832564642*z0 + 0.169552363*z1 + f0*(0.185280297*z0) + f1*(-0.0388830202*z0) + f2*(-0.436283552*z1) + f3*(0.65065278*z1) + in
nx_z1 = 0.118262026*z1 + 0.454544229*z2 + f4*(-0.525933543*z2) + f2*(0.362686143*z2)
nx_z2 = -0.0389669419*z2 + f5*(0.119709011*z2) + f2*(-0.967769483*z2)
