# G set g123-198, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p0 > 0.653087996, 1, 0)
f1 = sin(3.14159265358979*p1)
nx_z0 = 0.60668818*z0 + f0*(-0.064041208*z0) + f1*(0.37331182*z0) + in
nx_z1 = 0.530291608*z1
z0 = nx_z0
z1 = nx_z1
out = z0
