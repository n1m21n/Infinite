f1 = sin(3.14159265358979*p0)
f2 = p0*p0
f3 = (exp(p0) - 1)
f4 = if(p0 > 0.21423057, 1, 0)
f5 = p0
nx_z0 = 0.100479701*z0 + -0.492787417*z2 + f0*(0.719564277*z0) + f1*(0.159956022*z0) + f2*(0.288482797*z2) + f3*(-1.07614845*z2) + in
nx_z1 = 0.0260882874*z1 + 0.798216176*z2 + f3*(0.0118699774*z1) + f2*(0.297910541*z1) + f4*(-0.0180123647*z2) + f5*(-0.0266297869*z2)
nx_z2 = 0.736865939*z2
