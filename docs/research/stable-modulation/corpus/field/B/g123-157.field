# G set g123-157, n 3, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = sin(3.14159265358979*p0)
f1 = p0*p0
f2 = sin(3.14159265358979*p1)
f3 = if(p1 > 0.503786545, 1, 0)
f4 = if(p1 > 0.447345017, 1, 0)
f5 = if(p1 > 0.718533928, 1, 0)
nx_z0 = 0.923279256*z0 + 0.175225484*z1 + f0*(0.0229929286*z1) + f1*(0.225600877*z1) + in
nx_z1 = 0.0158306496*z1 + -0.0302271414*z2 + f2*(0.154082567*z2) + f3*(0.257011761*z2)
nx_z2 = 0.267783515*z1 + 0.718106904*z2 + f4*(-0.0677193542*z1) + f5*(-0.687645918*z1)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
