# G set g123-088, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p0*p0
f1 = if(p0 > 0.26027759, 1, 0)
f2 = sin(3.14159265358979*p2)
f3 = p1*p1
f4 = p1
f5 = p2
nx_z0 = 0.396447819*z0 + 0.673637552*z2 + f0*(-1.08511755*z0) + f1*(0.326734332*z2) + f2*(-0.108682659*z2) + in
nx_z1 = 0.961063569*z1 + f3*(-0.676779941*z1) + f4*(0.226415241*z1)
nx_z2 = 0.329863823*z2 + f5*(-0.376187883*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
