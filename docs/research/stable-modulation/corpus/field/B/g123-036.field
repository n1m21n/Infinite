# G set g123-036, n 3, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = if(p0 > 0.285737493, 1, 0)
f1 = sin(3.14159265358979*p0)
f2 = p0
f3 = (exp(p0) - 1)
f4 = if(p0 > 0.785124627, 1, 0)
nx_z0 = 0.50907893*z0 + in
nx_z1 = 0.0968942578*z1 + -0.256569134*z2 + f0*(0.14476283*z2) + f1*(0.749005491*z2)
nx_z2 = -0.277233593*z0 + 0.557850356*z1 + 0.074246749*z2 + f1*(-0.330769692*z0) + f2*(0.923093807*z0) + f3*(0.446381817*z1 + 0.0954288985*z2) + f4*(0.442909787*z2)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
