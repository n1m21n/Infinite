# G set g123-017, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = p2
f1 = if(p1 > 0.277404458, 1, 0)
f2 = sin(3.14159265358979*p0)
f3 = sin(3.14159265358979*p2)
nx_z0 = 0.762277471*z0 + -0.149436606*z1 + 0.00271603492*z2 + f0*(0.192879722*z0) + in
nx_z1 = -0.170787429*z1 + -0.109073901*z2 + f1*(-0.0129415131*z1)
nx_z2 = 0.546617941*z2 + f2*(0.180496315*z2) + f3*(-0.420068427*z2)
z0 = nx_z0
