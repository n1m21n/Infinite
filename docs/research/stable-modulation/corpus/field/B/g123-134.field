# G set g123-134, n 2, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p2
f1 = if(p2 > 0.493421161, 1, 0)
f2 = p0*p0
f3 = sin(3.14159265358979*p1)
nx_z0 = 0.597665559*z0 + f0*(0.39758006*z0) + f1*(-0.015245619*z0) + in
nx_z1 = -1.30422161*z0 + -0.136258108*z1 + f2*(0.218288308*z1) + f3*(-0.721180566*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
