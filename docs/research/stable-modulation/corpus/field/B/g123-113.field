# G set g123-113, n 3, knobs 3
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
param float p2 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
f0 = if(p1 > 0.478174586, 1, 0)
f1 = p2
f2 = if(p1 > 0.601856925, 1, 0)
f3 = (exp(p1) - 1)
f4 = p1*p1
nx_z0 = 0.296399455*z0 + -0.300159398*z1 + 0.0517705029*z2 + f0*(0.292732154*z1) + f1*(0.259762615*z1) + in
nx_z1 = -0.0778125494*z0 + 0.366867874*z1 + f2*(-0.00129029983*z0) + f3*(0.405050205*z1)
nx_z2 = 0.0469952212*z0 + -0.172898717*z1 + 0.105208697*z2 + f4*(0.423724628*z0)
z0 = nx_z0
z1 = nx_z1
z2 = nx_z2
out = z0
