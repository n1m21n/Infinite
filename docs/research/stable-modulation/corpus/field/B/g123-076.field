# G set g123-076, n 4, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
state float z2 = 0
state float z3 = 0
f0 = p1
f1 = if(p0 > 0.512944974, 1, 0)
f2 = (exp(p1) - 1)
f3 = p1*p1
f4 = if(p1 > 0.748049527, 1, 0)
nx_z0 = 0.185331363*z0 + 0.351437736*z1 + 0.442089329*z3 + f0*(-0.165352392*z3) + in
nx_z1 = -0.0292323269*z1 + f1*(0.113583458*z1) + f2*(0.157462876*z1)
nx_z2 = -0.171955099*z1 + 0.699972675*z2 + f3*(0.216378559*z2) + f0*(0.0636487653*z2)
nx_z3 = 0.163300779*z0 + -0.416672183*z2 + -0.0733196315*z3 + f4*(-0.286950014*z2)
z0 = nx_z0
