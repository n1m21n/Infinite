# G set g123-050, n 2, knobs 1
param float p0 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = if(p0 > 0.459119381, 1, 0)
f1 = p0*p0
f2 = p0
f3 = (exp(p0) - 1)
nx_z0 = 0.565077068*z0 + f0*(0.243538694*z0) + f1*(0.171384238*z0) + in
nx_z1 = -0.0331463061*z0 + -0.0750487857*z1 + f2*(-0.157360628*z0) + f3*(-0.143232225*z1) + f1*(0.147037048*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
