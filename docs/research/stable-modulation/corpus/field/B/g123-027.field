# G set g123-027, n 2, knobs 2
param float p0 = 0.5 [0, 1]
param float p1 = 0.5 [0, 1]
state float z0 = 0
state float z1 = 0
f0 = p1
f1 = (exp(p0) - 1)
f2 = p0
f3 = if(p1 > 0.455415959, 1, 0)
nx_z0 = -0.683680645*z0 + -0.567003635*z1 + f0*(-0.279738278*z0) + f1*(0.183289932*z0) + f2*(0.874669532*z1) + f3*(-0.31093765*z1) + in
nx_z1 = 0.345857936*z1 + f2*(0.0794078116*z1)
z0 = nx_z0
z1 = nx_z1
out = z0
