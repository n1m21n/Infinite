# L set: diode, McClellan DAFx26, trapezoidal in the paper's state form
param float g = 1 [0.00001, 1000]
param float k = 2 [0, 10]
state float x0 = 0
state float x1 = 0
state float x2 = 0
state float x3 = 0
m00 = 1 - g*(-2)
m01 = -g*(1)
m03 = -g*(-k)
r0 = x0 + g*((-2)*x0 + (1)*x1 + (-k)*x3) + 2*g*in
m10 = -g*(1)
m11 = 1 - g*(-2)
m12 = -g*(1)
r1 = x1 + g*((1)*x0 + (-2)*x1 + (1)*x2)
m21 = -g*(1)
m22 = 1 - g*(-2)
m23 = -g*(1)
r2 = x2 + g*((1)*x1 + (-2)*x2 + (1)*x3)
m32 = -g*(1)
m33 = 1 - g*(-1)
r3 = x3 + g*((1)*x2 + (-1)*x3)
f10 = m10 / m00
m11_1 = m11 - f10*m01
m13_1 = -f10*m03
r1_1 = r1 - f10*r0
f21 = m21 / m11_1
m22_2 = m22 - f21*m12
m23_2 = m23 - f21*m13_1
r2_2 = r2 - f21*r1_1
f32 = m32 / m22_2
m33_3 = m33 - f32*m23_2
r3_3 = r3 - f32*r2_2
y3 = (r3_3) / m33_3
y2 = (r2_2 - m23_2*y3) / m22_2
y1 = (r1_1 - m12*y2 - m13_1*y3) / m11_1
y0 = (r0 - m01*y1 - m03*y3) / m00
nx_x0 = y0
nx_x1 = y1
nx_x2 = y2
nx_x3 = y3
x0 = nx_x0
x1 = nx_x1
x2 = nx_x2
x3 = nx_x3
out = x3
