# L set: rbj_df1, textbook form
param float fc = 1000 [20, 20000]
param float Q = 0.707 [0.5, 20]
state float x1 = 0
state float x2 = 0
state float y1 = 0
state float y2 = 0
w0 = 2*3.14159265358979*fc/sr
cw = cos(w0)
al = sin(w0)/(2*Q)
a0 = 1 + al
b0 = (1 - cw)/2/a0
b1 = (1 - cw)/a0
b2 = b0
a1 = -2*cw/a0
a2 = (1 - al)/a0
y = b0*in + b1*x1 + b2*x2 - a1*y1 - a2*y2
nx_x1 = in
nx_x2 = x1
nx_y1 = y
nx_y2 = y1
x1 = nx_x1
x2 = nx_x2
y1 = nx_y1
y2 = nx_y2
out = x1
