# L set, kernel 22. Timoney and Lazzarini, Forum Acusticum 2011: configuration 3 (saturation in the feedback path only).
# Saturation eq. (2) (A = 1, c = 3), filter eq. (6) with eq. (7) g = 0.122340 (1 kHz), beta = 0.9.
state float y = 0
sy = if(y < 0, -1.0, 1.0) * (1.0 - exp(-3.0 * abs(y)))
u = in * 2.0 - 0.9 * sy
y = 0.122340 * (0.769231 * u + 0.230769 * delay(u, 1)) + 0.877660 * y
out = y * 0.5
