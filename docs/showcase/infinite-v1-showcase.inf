node 19 Source FieldPixel
  uid 1030
  pos 4800 300
  flags 0 0 0 0
  s code p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);g = uv.y;base = mix(vec3(0.035, 0.04, 0.09), vec3(0.08, 0.09, 0.2), g);w1 = sin(p.x * 2.6 + t * 0.35) * 0.07 + sin(p.x * 6.3 - t * 0.6) * 0.025;a1 = exp(-pow((p.y - 0.16 - w1) * 8.0, 2.0));w2 = sin(p.x * 1.9 - t * 0.27 + 1.7) * 0.09;a2 = exp(-pow((p.y + 0.02 - w2) * 11.0, 2.0));glow = exp(-pow(length(vec2(p.x, p.y + 0.55)) * 1.6, 2.0));col = base + vec3(0.55, 0.6, 1.0) * a1 * 0.42 + vec3(1.0, 0.42, 0.21) * a2 * 0.3 + vec3(1.0, 0.42, 0.21) * glow * 0.12;
  f width 1280
  f height 720
  b animate 1
  b exposeAuxTexture 0
  i field_nextParamId 1
  s field_paramMap 
  s __outputPins 
  s __inputPins 
end
