infinite-patch 1
# A pocket game console: 3D nodes, a GLSL game on its screen, chiptune sounds.
node 1 Source Formula
  id shellTex
  pos 2320 352
  f width 1024.0
  f height 1024.0
  s formula // Speckled beige plastic for the shell: fine grain plus sparse dark and lime flecks.\nvec2 px = uv * 1024.0;\nvec3 col = vec3(0.80, 0.70, 0.64) * (0.97 + 0.05 * rand(floor(px)));\nfloat r = rand(floor(px / 6.0));\nif (r > 0.993) col = vec3(0.30, 0.26, 0.24);\nelse if (r > 0.989) col = vec3(0.78, 0.95, 0.20);\nreturn vec4(col, 1.0);
end
