 "idea": {
  "belief": "connection",
  "line": "A DAW for you.",
  "concept": "Two ends, one loop. The lemniscate's warm end (Ember) is the human act: the hand word, the key cable, the call to action. Its cool end (Signal, on the Midnight hue) is the structure: lines, diagrams, data. Midnight is the space they connect across.",
  "personality": [
   "calm",
   "precise",
   "a little playful",
   "confident, never hype"
  ],
  "references": [
   "Anthropic",
   "Nothing",
   "Apple",
   "1X NEO"
  ]
 },
