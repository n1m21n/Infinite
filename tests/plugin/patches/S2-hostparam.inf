infinite-patch 1
# S2 (host automation): host audio -> Gain -> out; the Gain knob itself is on host slot 1
# (right-click > Host automation), no Macro. Slot 0 -> -60 dB, slot 1 -> +12 dB.
node 1 Utility Audio In
  id in
  pos 0 0
end
node 2 Utility Gain
  id amp
  pos 400 0
end
node 3 Utility Audio Out
  id speakers
  pos 800 0
end
aud amp 0 in
aud speakers 0 amp
hostparam 0 2 0
