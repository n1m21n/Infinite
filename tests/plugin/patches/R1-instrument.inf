infinite-patch 1
# R1 (frozen reference, step 1.4): host MIDI -> Analog -> Delay -> Reverb -> out, plus a shape that grows with the sound.
node 1 Notes MIDI Notes
  id midi
  pos 0 0
end
node 2 Synths Analog
  id synth
  f volume 0.5
  pos 400 0
end
node 3 AudioEffects Delay
  id echo
  pos 800 0
end
node 4 AudioEffects Reverb
  id room
  pos 1200 0
end
node 5 Utility Audio Out
  id speakers
  pos 1600 0
end
node 6 Modulators Audio Analyze
  id hear
  pos 800 300
end
node 7 Source Shape
  id shape
  c fillColor 1 0.45 0.3
  pos 1200 300
end
node 8 Utility Output
  id out
  pos 1600 300
end
note synth 0 midi
aud echo 0 synth
aud room 0 echo
aud speakers 0 room
aud hear 0 synth
cable out 0 shape
mod shape sizeX hear 0 0 1 0.5 0.12 0.4
mod shape sizeY hear 0 0 1 0.5 0.12 0.4
