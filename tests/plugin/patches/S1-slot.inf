infinite-patch 1
# S1 (step 2.2): host audio -> Gain -> out; the Gain's dB is driven by a Macro Knob bound to host slot 1.
# knob 0 -> -60 dB, knob 1 -> 0 dB.
node 1 Utility Audio In
  id in
  pos 0 0
end
node 2 Utility Gain
  id amp
  pos 400 0
end
node 3 Utility Audio Out
  id speakers
  pos 800 0
end
node 4 Macros Macro Knob
  id knob
  pos 400 300
  s label Level
  f value 1
  i hostSlot 1
end
aud amp 0 in
aud speakers 0 amp
mod amp gainDb knob 0 0 1 0 -60 0
