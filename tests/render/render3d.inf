infinite-patch 1
# 3D render: two overlapping half-transparent cubes through a camera.
node 1 3D Cube
  id red
  f posX 0.6
  c color 1 0 0
  f opacity 0.5
end
node 2 3D Cube
  id blue
  f posX -0.6
  c color 0 0 1
  f opacity 0.5
end
node 3 3D Camera
end
node 4 3D Render 3D
  id r3d
  f camAzimuth 20
  f camElevation 15
  f width 256
  f height 256
end
node 5 Utility Output
end
geo r3d 0 red
geo r3d 1 blue
geo r3d 4 3
cable 5 0 r3d
