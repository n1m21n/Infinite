infinite-patch 1
# Compositing: trails behind a moving shape
node 1 Source Shape
  id shape
  pos 0 156
  c fillColor 1 0.45 0.3
  f size 0.18
end
node 2 Modulators LFO
  id lfo
  pos 0 980
  f rateBeats 5
end
node 3 Compositing Trails
  id tr
  pos 460 318
end
node 4 Utility Output
  id out
  pos 920 156
end
node 5 Compositing Comment
  pos 0 0
  s text Compositing combines and reshapes pictures: stack them, fade them, trail them.
  f width 340
  f height 120
end
node 6 Compositing Comment
  pos 460 156
  s text Trails leaves a fading copy of what came before. Try Decay: higher is longer trails.
  f width 300
  f height 126
end
node 7 Compositing Comment
  pos 0 818
  s text The LFO swings the shape left and right, so the trail has something to follow.
  f width 300
  f height 126
end
cable tr 0 shape
cable out 0 tr
mod shape posX lfo 0 0 0.3 0.5
