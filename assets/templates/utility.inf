infinite-patch 1
# Utility: mix and meter sound
node 1 Notes Random Note Generator
  id a
  pos 0 156
end
node 2 Synths Analog
  id s1
  pos 480 156
  f volume 0.4
end
node 3 Synths Analog
  id s2
  pos 480 1166
  f volume 0.4
end
node 4 Utility Mixer
  id mixer
  pos 1340 318
end
node 5 Utility Audio Meter
  id meter
  pos 2240 318
end
node 6 Utility Audio Out
  id speakers
  pos 2720 156
end
node 7 Compositing Comment
  pos 0 0
  s text Utility nodes route and check things: mixers, meters, outputs.
  f width 340
  f height 120
end
node 8 Compositing Comment
  pos 1340 156
  s text The Mixer blends several sounds. Each channel has a volume, a pan and mute/solo.
  f width 300
  f height 126
end
node 9 Compositing Comment
  pos 2240 156
  s text The Meter shows how loud the sound is. It passes sound through unchanged.
  f width 300
  f height 126
end
note s1 0 a
note s2 0 a
aud mixer in_1 s1
aud mixer in_2 s2
aud meter 0 mixer
aud speakers 0 meter
