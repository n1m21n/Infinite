<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Infinite</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="license.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <background file="background.png" alignment="bottomleft" scaling="none"/>
  <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <os-version min="12.0"/>
  <choices-outline>
    <line choice="app"/>
    <line choice="vst3"/>
    <line choice="au"/>
    <line choice="engine"/>
  </choices-outline>
  <choice id="app" title="Infinite app" description="The standalone app, in ~/Applications. Without it, the plugins still work.">
    <pkg-ref id="org.infinitedevices.installer.app"/>
  </choice>
  <choice id="vst3" title="VST3" description="Infinite Instrument and Infinite FX for Ableton Live, Bitwig, Reaper, Cubase, Studio One and other VST3 hosts.">
    <pkg-ref id="org.infinitedevices.installer.vst3"/>
  </choice>
  <choice id="au" title="Audio Unit" description="Infinite Instrument and Infinite FX for Logic Pro, GarageBand and other AU hosts.">
    <pkg-ref id="org.infinitedevices.installer.au"/>
  </choice>
  <choice id="engine" title="Infinite engine" visible="false" enabled="false" selected="true">
    <pkg-ref id="org.infinitedevices.installer.engine"/>
  </choice>
  <pkg-ref id="org.infinitedevices.installer.app" version="__VERSION__" onConclusion="none">choice-app.pkg</pkg-ref>
  <pkg-ref id="org.infinitedevices.installer.vst3" version="__VERSION__" onConclusion="none">choice-vst3.pkg</pkg-ref>
  <pkg-ref id="org.infinitedevices.installer.au" version="__VERSION__" onConclusion="none">choice-au.pkg</pkg-ref>
  <pkg-ref id="org.infinitedevices.installer.engine" version="__VERSION__" onConclusion="none">engine.pkg</pkg-ref>
</installer-gui-script>
