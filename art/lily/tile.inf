node 103 Source FieldPixel
  id tileMap
  f width 2048
  f height 2048
  b animate 0
  s code e = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y)); grout = 1.0 - smoothstep(0.008, 0.014, e); pool = smoothstep(0.012, 0.09, e); n = 0.5 + 0.25 * sin(uv.x * 9.0 + 2.0 * sin(uv.y * 7.0)) * sin(uv.y * 8.0 + 1.3) + 0.25 * sin(uv.x * 23.0 + uv.y * 17.0); glaze = mix(vec3(0.70, 0.66, 0.58), vec3(0.86, 0.83, 0.76), pool * (0.85 + 0.15 * n)); q = vec2(uv.x * 9.0 + 0.3 * sin(uv.y * 13.0), uv.y * 9.0 + 0.3 * sin(uv.x * 11.0)); fq = fract(q); craze = 1.0 - smoothstep(0.0, 0.02, min(min(fq.x, 1.0 - fq.x), min(fq.y, 1.0 - fq.y))); glaze = glaze * (1.0 - 0.06 * craze); col = mix(glaze, vec3(0.42, 0.40, 0.37), grout)
end
node 104 Source FieldPixel
  id tileBump
  f width 2048
  f height 2048
  b animate 0
  s code e = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y)); edge = smoothstep(0.008, 0.03, e); wave = 0.04 * sin(uv.x * 6.0 + 1.1) * sin(uv.y * 5.0 + 0.4) + 0.02 * sin(uv.x * 19.0 + uv.y * 13.0); q = vec2(uv.x * 9.0 + 0.3 * sin(uv.y * 13.0), uv.y * 9.0 + 0.3 * sin(uv.x * 11.0)); fq = fract(q); craze = 1.0 - smoothstep(0.0, 0.015, min(min(fq.x, 1.0 - fq.x), min(fq.y, 1.0 - fq.y))); h = 0.3 + 0.55 * edge + wave * edge - 0.03 * craze; col = vec3(h, h, h)
end
