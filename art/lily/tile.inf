infinite-patch 1
node 1 Source FieldPixel
  id tepalMap
  f width 1024
  f height 2048
  b animate 0
  s code a = abs(uv.x - 0.5) * 2.0; s = uv.y; w = 0.035 * sin(s * 19.0) + 0.02 * sin(s * 37.0 + 1.3); streak = 0.09 * sin(uv.x * 95.0 + 2.0 * sin(s * 7.0)) * sin(uv.x * 23.0 + 1.7); rim = smoothstep(0.52 + w, 0.86 + w, a + streak + 0.3 * smoothstep(0.7, 1.0, s)); blue = mix(vec3(0.13, 0.16, 0.72), vec3(0.40, 0.46, 0.95), smoothstep(0.0, 0.75, a)); blue = mix(blue, vec3(0.30, 0.34, 0.86), smoothstep(0.6, 1.0, s) * 0.5); c = mix(blue, vec3(0.94, 0.95, 1.0), rim); c = mix(vec3(0.82, 0.92, 0.80), c, smoothstep(0.03, 0.16, s)); vein = 0.95 + 0.05 * sin(uv.x * 160.0 + 3.0 * sin(s * 9.0)); c = c * mix(1.0, vein, 1.0 - rim); g = vec2(uv.x * 17.0, s * 26.0); cell = floor(g); h1 = fract(sin(cell.x * 127.1 + cell.y * 311.7) * 43758.5453); h2 = fract(sin(cell.x * 269.5 + cell.y * 183.3) * 43758.5453); h3 = fract(sin(cell.x * 419.2 + cell.y * 371.9) * 43758.5453); d = length(g - cell - vec2(0.2 + 0.6 * h1, 0.2 + 0.6 * h2)); keep = step(h3, 0.75 - 0.75 * smoothstep(0.1, 0.85, s)) * (1.0 - smoothstep(0.55, 0.72, a)) * smoothstep(0.08, 0.15, s); dot1 = (1.0 - smoothstep(0.11 + 0.14 * h1, 0.19 + 0.14 * h1, d)) * keep; c = mix(c, vec3(0.04, 0.04, 0.22), dot1 * 0.9); col = c
end
node 2 Source FieldPixel
  id tepalBump
  f width 1024
  f height 2048
  b animate 0
  s code a = abs(uv.x - 0.5) * 2.0; s = uv.y; vx = (uv.x - 0.5) / (0.25 + 0.75 * sqrt(max(s, 0.02))); vein = pow(abs(sin(vx * 70.0 + 0.8 * sin(s * 11.0))), 6.0) * 0.5 + pow(abs(sin(vx * 18.0)), 12.0) * 0.5; mid = exp(-pow(a / 0.06, 2.0)) * (1.0 - smoothstep(0.5, 0.95, s)); g = vec2(uv.x * 17.0, s * 26.0); cell = floor(g); h1 = fract(sin(cell.x * 127.1 + cell.y * 311.7) * 43758.5453); h2 = fract(sin(cell.x * 269.5 + cell.y * 183.3) * 43758.5453); h3 = fract(sin(cell.x * 419.2 + cell.y * 371.9) * 43758.5453); d = length(g - cell - vec2(0.2 + 0.6 * h1, 0.2 + 0.6 * h2)); keep = step(h3, 0.75 - 0.75 * smoothstep(0.1, 0.85, s)) * (1.0 - smoothstep(0.55, 0.72, a)) * smoothstep(0.08, 0.15, s); pap = (1.0 - smoothstep(0.0, 0.22 + 0.14 * h1, d)) * keep; g2 = vec2(uv.x * 60.0, s * 90.0); c2 = floor(g2); k1 = fract(sin(c2.x * 91.3 + c2.y * 47.9) * 43758.5453); d2 = length(g2 - c2 - vec2(0.5, 0.5)); pap2 = (1.0 - smoothstep(0.0, 0.45, d2)) * step(k1, 0.6) * (1.0 - smoothstep(0.08, 0.3, s)) * (1.0 - smoothstep(0.4, 0.7, a)); g3 = vec2(uv.x * 420.0, s * 700.0); c3 = floor(g3); grain = fract(sin(c3.x * 12.9898 + c3.y * 78.233) * 43758.5453); hgt = 0.5 + 0.18 * vein + 0.1 * mid + 0.35 * pap + 0.22 * pap2 + 0.05 * (grain - 0.5); col = vec3(hgt, hgt, hgt)
end
