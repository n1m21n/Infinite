node 109 Source FieldPixel
  id tileMap
  pos 5060 1290
  f width 2048
  f height 2048
  b animate 0
  s code u = fract(uv * 4.0); e = min(min(u.x, 1.0 - u.x), min(u.y, 1.0 - u.y)); grout = 1.0 - smoothstep(0.008, 0.014, e); pool = smoothstep(0.012, 0.09, e); n = 0.5 + 0.25 * sin(u.x * 9.0 + 2.0 * sin(u.y * 7.0)) * sin(u.y * 8.0 + 1.3) + 0.25 * sin(u.x * 23.0 + u.y * 17.0); glaze = mix(vec3(0.80, 0.79, 0.76), vec3(0.93, 0.92, 0.89), pool * (0.85 + 0.15 * n)); q = vec2(u.x * 9.0 + 0.3 * sin(u.y * 13.0), u.y * 9.0 + 0.3 * sin(u.x * 11.0)); fq = fract(q); craze = 1.0 - smoothstep(0.0, 0.02, min(min(fq.x, 1.0 - fq.x), min(fq.y, 1.0 - fq.y))); glaze = glaze * (1.0 - 0.06 * craze); col = mix(glaze, vec3(0.30, 0.29, 0.27), grout)
end
node 110 Source FieldPixel
  id tileBump
  pos 5060 1780
  f width 2048
  f height 2048
  b animate 0
  s code u = fract(uv * 4.0); e = min(min(u.x, 1.0 - u.x), min(u.y, 1.0 - u.y)); edge = smoothstep(0.008, 0.03, e); wave = 0.04 * sin(u.x * 6.0 + 1.1) * sin(u.y * 5.0 + 0.4) + 0.02 * sin(u.x * 19.0 + u.y * 13.0); q = vec2(u.x * 9.0 + 0.3 * sin(u.y * 13.0), u.y * 9.0 + 0.3 * sin(u.x * 11.0)); fq = fract(q); craze = 1.0 - smoothstep(0.0, 0.015, min(min(fq.x, 1.0 - fq.x), min(fq.y, 1.0 - fq.y))); h = 0.3 + 0.55 * edge + wave * edge - 0.03 * craze; col = vec3(h, h, h)
end
