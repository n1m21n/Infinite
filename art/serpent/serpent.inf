* 0.85);\n  return r;\n}\nvar RIG = null, RIGT = -1;\nfunction rig(t, n) {               // n samples with parallel-transport frames, cached per frame\n  if (RIG && RIGT === t && RIG.length === n + 1) return RIG;\n  var ph = TAU * t / LOOP, pts = [], i;\n  for (i = 0; i <= n; i++) pts.push(spline(i / n));\n  var T = [], out = [];\n  for (i = 0; i <= n; i++) T.push(nrm(sub(pts[Math.min(i + 1, n)], pts[Math.max(i - 1, 0)])));\n  var Nn = nrm(crs(T[0], [0, 0, 1]));\n  for (i = 0; i <= n; i++) {\n    if (i > 0) { Nn = sub(Nn, mul(T[i], dot(Nn, T[i]))); Nn = nrm(Nn); }\n    var Bn = crs(T[i], Nn), s = i / n;\n    // slither: travelling side wave, damped at tail tip and where the body threads the ring\n    var env = Math.min(1, s * 4) * (1 - 0.8 * Math.exp(-Math.pow((s - 0.66) / 0.07, 2))) * (1 - 0.7 * Math.max(0, (s - 0.9) / 0.1));\n    var w = slither * env * Math.sin(TAU * s * 3.2 - ph);\n    var lift = 0.5 * slither * env * Math.cos(TAU * s * 3.2 - ph);\n    out.push({ p: add(add(pts[i], mul(Bn, w)), mul(Nn, lift)), T: T[i], N: Nn, B: Bn, s: s, r: radius(s) });\n  }\n  RIG = out; RIGT = t;\n  return out;\n}\n// plate phase: segments travel tail->head over one loop\nfunction plate(s, t) { return s * 34 - glide * 2 * t / LOOP * 2; }\nfunction ringPt(f, a, rr) { var c = Math.cos(a), d = Math.sin(a); return add(f.p, add(mul(f.N, c * rr), mul(f.B, d * rr))); }\n// loft a closed tube around the rig with radius fn(f, a)\nfunction loft(R, M, rfn, i0, i1) {\n  beginShape(QUADS);\n  for (var i = i0; i < i1; i++) {\n    var f0 = R[i], f1 = R[i + 1];\n    for (var j = 0; j < M; j++) {\n      var a0 = TAU * j / M, a1 = TAU * (j + 1) / M;\n      var p00 = ringPt(f0, a0, rfn(f0, a0)), p01 = ringPt(f0, a1, rfn(f0, a1));\n      var p11 = ringPt(f1, a1, rfn(f1, a1)), p10 = ringPt(f1, a0, rfn(f1, a0));\n      vertex(p00[0], p00[1], p00[2], j / M, f0.s); vertex(p10[0], p10[1], p10[2], j / M, f1.s);\n      vertex(p11[0], p11[1], p11[2], (j + 1) / M, f1.s); vertex(p01[0], p01[1], p01[2], (j + 1) / M, f0.s);\n    }\n  }\n  endShape();\n}\n\nfunction draw(t) {\n  var R = rig(t, 300), n = R.length - 1, f = R[Math.floor(n * 0.965)];\n  fill(1.0, 0.35, 0.42);\n  for (var b = -1; b <= 1; b += 2) {\n    var e = add(f.p, add(mul(f.B, b * f.r * 0.78), add(mul(f.N, f.r * 0.32), mul(f.T, f.r * 0.1))));\n    push(); translate(e[0], e[1], e[2]); sphere(f.r * 0.22, 16); pop();\n  }\n}
