# near ground
node 48 Source Shadertoy
  id ground
  f width 1080
  f height 1350
  i mode 1
  s stImage float h21(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }\nfloat n2(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);\n  return mix(mix(h21(i),h21(i+vec2(1,0)),f.x), mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x), f.y); }\nfloat fbm(vec2 p){ float a=.5, s=0.; for(int i=0;i<5;i++){ s+=a*n2(p); p*=2.03; a*=.5; } return s; }\nvoid mainImage(out vec4 o, in vec2 fc){\n  vec2 uv = fc/iResolution.xy;\n  vec2 p = (fc - .5*iResolution.xy)/iResolution.y;\n  float T = 6.2831853*iTime/8.0;                 // 8 s loop\n  vec2 q = p + 0.06*vec2(sin(T), cos(T));\n  float f = fbm(q*2.2 + vec2(fbm(q*3.0 + 0.3*vec2(cos(T), sin(T))), fbm(q*3.0 + 4.0)));\n  vec3 ink = vec3(0.016, 0.022, 0.024);\n  vec3 jade = vec3(0.05, 0.36, 0.25), acid = vec3(0.45, 0.85, 0.2), coral = vec3(0.9, 0.22, 0.3);\n  // a soft resin slab behind the subject (the Florax square), rounded, lit from the top left\n  vec2 b = abs(p - vec2(0.02, 0.0)) - vec2(0.33, 0.42);\n  float slab = length(max(b, 0.0)) + min(max(b.x, b.y), 0.0) - 0.04;\n  float inS = smoothstep(0.02, -0.06, slab + 0.03*(f-0.5));\n  vec3 col = ink;\n  vec3 resin = mix(jade*0.35, jade*0.9, f) + acid*0.25*smoothstep(0.55, 0.8, f);\n  resin += coral*0.18*smoothstep(0.35, 0.0, length(p - vec2(-0.12, -0.08)));\n  col = mix(col, resin, inS*0.55);\n  col += jade*0.10*smoothstep(0.12, -0.2, slab);      // halo\n  col *= 1.0 - 0.55*length(uv - 0.5);                  // vignette\n  col += (h21(fc + fract(iTime)*97.0) - 0.5)*0.025;     // grain\n  o = vec4(col, 1.0);\n}
end
# near poster
node 49 Source Sketch
  id poster
  s code // Swiss poster overlay: 12x15 grid, label card (Florax style), registration marks, type.\nparam("gridAlpha", 0.10, 0, 0.4);\nparam("scan", 0, 0, 1);\nfunction draw(t) {\n  background(0, 0, 0, 0);\n  var m = 54, cw = (width - 2 * m) / 12, rh = (height - 2 * m) / 15;\n  // grid\n  stroke(0.8, 1.0, 0.85, gridAlpha); strokeWeight(1);\n  for (var i = 0; i <= 12; i++) line(m + i * cw, m, m + i * cw, height - m);\n  for (var j = 0; j <= 15; j++) line(m, m + j * rh, width - m, m + j * rh);\n  // crosshair registration marks on the corners\n  stroke(0.85, 1.0, 0.9, 0.7); strokeWeight(1.2);\n  [[m, m], [width - m, m], [m, height - m], [width - m, height - m]].forEach(function (c) {\n    line(c[0] - 10, c[1], c[0] + 10, c[1]); line(c[0], c[1] - 10, c[0], c[1] + 10);\n    noFill(); circle(c[0], c[1], 9);\n  });\n  // title, top left on the grid\n  noStroke(); fill(0.85, 1.0, 0.88);\n  textSize(86); text("SERPENS", m, m + 2 * rh + 14);\n  textSize(86); fill(0.72, 0.95, 0.3); text("-09", m + 6.4 * cw, m + 2 * rh + 14);\n  textSize(15); fill(0.85, 1.0, 0.88, 0.75);\n  text("CYBERNETIC ORGANISM / GLASS + CHROME / LOOP 08 S", m, m + 2 * rh + 44);\n  // label card, top right (cols 9-12, rows 4-7)\n  var x0 = m + 9 * cw, y0 = m + 3 * rh, w = 3 * cw, h = 4 * rh;\n  fill(0.03, 0.04, 0.04, 0.82); stroke(1.0, 0.36, 0.42, 0.9); strokeWeight(1.5); rect(x0, y0, w, h);\n  noStroke(); fill(1.0, 0.4, 0.46); textSize(30); text("SERPENS", x0 + 12, y0 + 40);\n  textSize(10.5); fill(1.0, 0.55, 0.6, 0.9);\n  var lines = ["SPECIMEN 09 // ARCHIVE EDEN-2026", "GLASS SHELL, ACID CORE,", "CHROME VERTEBRAE. BRED TO",\n               "THREAD RINGS AND BUBBLES", "IN A CLOSED RESIN WORLD.", "", "MADE WITH INFINITE"];\n  for (var k = 0; k < lines.length; k++) text(lines[k], x0 + 12, y0 + 66 + k * 15);\n  // a rotating sun glyph in the card (the Florax star)\n  push(); translate(x0 + w / 2, y0 + h - 52); rotate(TAU * t / 8);\n  stroke(1.0, 0.4, 0.46); strokeWeight(1.3);\n  for (var r = 0; r < 16; r++) { rotate(TAU / 16); line(6, 0, r % 2 ? 22 : 30, 0); }\n  noFill(); circle(0, 0, 10); pop();\n  // footer ticks + index numbers on the bottom row\n  noStroke(); fill(0.85, 1.0, 0.88, 0.6); textSize(11);\n  for (var i2 = 0; i2 < 12; i2++) text(("0" + (i2 + 1)).slice(-2), m + i2 * cw + 4, height - m + 18);\n  text("N 19.07  E 72.87", width - m - 3 * cw + 4, m - 14);\n  text("PLATE 3 / 9", m + 4, m - 14);\n  // scan line that sweeps once per loop\n  var sy = m + ((t / 8) % 1) * (height - 2 * m);\n  stroke(0.7, 1.0, 0.4, 0.25 * (1 - scan) + 0.05); strokeWeight(1); line(m, sy, width - m, sy);\n}
  f width 1080
  f height 1350
end
