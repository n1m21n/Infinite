// Build settings for Infinite Remote. Do not edit this file: put your own values in Config/Local.xcconfig
// (copy Local.xcconfig.example; scripts/build_watch_app.sh does that for you). Local.xcconfig is not committed.
// Defaults come first so that Local.xcconfig, included last, wins.

DEVELOPMENT_TEAM =
INFINITE_BUNDLE_PREFIX = org.example.changeme
INFINITE_WATCH_HEALTH = 0

#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(INFINITE_BUNDLE_PREFIX).infiniteremote
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Config/Health$(INFINITE_WATCH_HEALTH).entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) INFINITE_HEALTH_$(INFINITE_WATCH_HEALTH)
