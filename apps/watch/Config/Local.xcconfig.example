// Your own signing values for Infinite Remote. Copy this file to Local.xcconfig (same folder) and edit it.
// Local.xcconfig is not committed.

// Your Apple ID's team id: Xcode > Settings > Accounts > select your Personal Team, or the 10-character id
// shown in Signing & Capabilities. Example: ABCDE12345
DEVELOPMENT_TEAM =

// A reverse-domain prefix that is unique to you (free teams cannot reuse someone else's bundle id).
// Example: com.yourname
INFINITE_BUNDLE_PREFIX = com.yourname

// 0 = keep the app awake with an extended runtime session. Works on every free team. Heart rate is not sent.
// 1 = keep it awake with a workout session and send heart rate. Needs a team that has the HealthKit capability.
INFINITE_WATCH_HEALTH = 0
