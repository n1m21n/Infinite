// Windows resources for Infinite.exe.
//
// Generated from Infinite.rc.in by CMake's configure_file() - do not edit the
// generated .rc directly, edit this template. The version block comes from
// INFINITE_VERSION/INFINITE_VERSION_RC in CMakeLists.txt, so it can't drift
// from the macOS bundle version or the in-app update checker's baseline the
// way a hand-maintained literal here did before.
//
// Without an icon resource the exe gets the generic Win32 application icon in
// Explorer, the taskbar and Alt-Tab. IDI_ICON1 being the LOWEST-numbered icon
// resource is what makes Explorer pick it as the file's display icon, so keep
// it first if more icons are ever added.
//
// The version block is what shows in the file's Properties > Details tab, and
// is also what SmartScreen and most enterprise software inventories read. An
// unsigned exe with no version info looks maximally anonymous, so it is worth
// having even before code signing.

#include <windows.h>

// Absolute path: this generated .rc lives in the build directory, not next
// to Infinite.ico, so a relative reference would fail to resolve.
// GLFW specifically looks for a resource named "GLFW_ICON" when registering its
// window class, while Windows Explorer uses the first icon in the resource table.
// Defining GLFW_ICON first ensures Explorer, GLFW window registration, and taskbar
// pick up the application logo.
GLFW_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/platform/win/Infinite.ico"
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/platform/win/Infinite.ico"
1         ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/platform/win/Infinite.ico"
IDI_DEVICE_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/platform/win/InfiniteDevice.ico"

#define INFINITE_VERSION      @INFINITE_VERSION_RC@
#define INFINITE_VERSION_STR  "@INFINITE_VERSION_RC_STR@"

VS_VERSION_INFO VERSIONINFO
   FILEVERSION    INFINITE_VERSION
   PRODUCTVERSION INFINITE_VERSION
   FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
   FILEFLAGS      VS_FF_DEBUG
#else
   FILEFLAGS      0x0L
#endif
   FILEOS         VOS_NT_WINDOWS32
   FILETYPE       VFT_APP
   FILESUBTYPE    VFT2_UNKNOWN
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      // 0409 = en-US, 04B0 = Unicode.
      BLOCK "040904B0"
      BEGIN
         VALUE "CompanyName",      "Infinite"
         VALUE "FileDescription",  "Infinite - realtime modular visual and audio synthesizer"
         VALUE "FileVersion",      INFINITE_VERSION_STR
         VALUE "InternalName",     "Infinite"
         VALUE "OriginalFilename", "Infinite.exe"
         VALUE "ProductName",      "Infinite"
         VALUE "ProductVersion",   INFINITE_VERSION_STR
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x409, 0x4B0
   END
END
