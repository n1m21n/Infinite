<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>English</string>
	<key>CFBundleExecutable</key><string>@AU_NAME@</string>
	<key>CFBundleIdentifier</key><string>org.infinitedevices.plugin.@AU_ID@</string>
	<key>CFBundleName</key><string>@AU_NAME@</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundlePackageType</key><string>BNDL</string>
	<key>CFBundleSignature</key><string>????</string>
	<key>CFBundleShortVersionString</key><string>@INFINITE_VERSION@</string>
	<key>CFBundleVersion</key><string>@INFINITE_VERSION@</string>
	<key>NSHumanReadableCopyright</key><string>Infinite, https://infinitedevices.org</string>
	<key>AudioComponents</key>
	<array>
		<dict>
			<key>factoryFunction</key><string>AUWrapperFactory</string>
			<key>description</key><string>@AU_NAME@</string>
			<key>manufacturer</key><string>Infn</string>
			<key>name</key><string>Infinite: @AU_NAME@</string>
			<key>subtype</key><string>@AU_SUBTYPE@</string>
			<key>type</key><string>@AU_TYPE@</string>
			<key>version</key><integer>@AU_VERSION_INT@</integer>
			<key>sandboxSafe</key><true/>
			<key>tags</key><array><string>@AU_TAG@</string></array>
		</dict>
	</array>
	<key>AudioUnit SupportedNumChannels</key>
	<array>
@AU_CHANNELS@
	</array>
</dict>
</plist>
