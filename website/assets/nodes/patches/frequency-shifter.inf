infinite-patch 1
rev 2
# Frequency Shifter: a starting patch for the Frequency Shifter node
node 1 AudioEffects Frequency Shifter
  id node
  pos 520 300
end
node 2 Synths Oscillator
  id in0
  pos 0 300
end
node 3 Utility Audio Out
  id speakers
  pos 1080 300
end
aud node 0 in0
aud speakers 0 node
