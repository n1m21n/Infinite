infinite-patch 1
rev 2
# Mixer: a starting patch for the Mixer node
node 1 Utility Mixer
  id node
  pos 520 300
end
node 2 Synths Oscillator
  id in0
  pos 0 220
end
node 3 Synths Oscillator
  id in1
  pos 0 510
end
node 4 Synths Oscillator
  id in2
  pos 0 800
end
node 5 Synths Oscillator
  id in3
  pos 0 1090
end
node 6 Utility Audio Out
  id speakers
  pos 1080 300
end
aud node 0 in0
aud node 1 in1
aud node 2 in2
aud node 3 in3
aud speakers 0 node
