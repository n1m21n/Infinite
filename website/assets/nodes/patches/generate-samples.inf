infinite-patch 1
rev 2
# Generate Samples: a starting patch for the Generate Samples node
node 1 Synths Generate Samples
  id node
  pos 520 300
end
node 2 Notes Random Note Generator
  id in0
  pos 0 300
end
node 3 Utility Audio Out
  id speakers
  pos 1080 300
end
note node 0 in0
aud speakers 0 node
