  s code param float pulseSpeed = 2.4195 [0.5, 4.0];\nparam float tentacles = 9.5877 [4.0, 16.0];\nparam float glow = 0.6552 [0.2, 3.0];\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\npulse = sin(t * pulseSpeed) * 0.06;\nbellP = p - vec2(0.0, 0.1);\nbellD = length(vec2(bellP.x * 1.3, bellP.y * (1.0 + pulse)));\nbellMask = smoothstep(0.24, 0.22, bellD) * step(0.0, -bellP.y + 0.08);\nrim = smoothstep(0.23, 0.20, bellD) - smoothstep(0.20, 0.16, bellD);\ntentX = p.x + sin(p.y * 14.0 + t * pulseSpeed * 1.5) * 0.035 * (0.1 - p.y);\ntentWave = sin(tentX * tentacles * 20.0) * step(p.y, 0.08) * step(-0.45, p.y);\ntentMask = smoothstep(0.85, 0.98, tentWave) * (1.0 - smoothstep(-0.45, 0.05, p.y));\ndeepBlue = vec3(0.02, 0.04, 0.1);\nneonCyan = vec3(0.1, 0.85, 0.95);\nmagenta = vec3(0.9, 0.2, 0.8);\njellyCol = mix(neonCyan, magenta, bellD * 3.5) * glow;\ncol = deepBlue + jellyCol * (bellMask * 0.6 + rim * 0.9 + tentMask * 0.85);
  f width 424.878
end
