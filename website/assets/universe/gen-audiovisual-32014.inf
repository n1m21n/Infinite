n(width, height);\n  _s = 213442642;\n  background(0, 0, 0, 0);\n  translate(S * 0.012 * sin(t * 0.4 + 0), S * 0.012 * cos(t * 0.33 + 2));\n  const n = floor(ri(2, 3 + 1));\n  const P = place('thirds', n);\n  for (let i = 0; i < P.length; i++) {\n    const p = P[i];\n    const s = S * (0.2000 + (0.4500 - 0.2000) * (p[2])) ;\n    const c = pal(pick(COLS)); CUR = c;\n    push(); translate(p[0], p[1]);\n    fill(c);\n    noStroke();\n    mark('square', s, 0, true);\n    pop();\n  }\n}
