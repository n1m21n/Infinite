  s code param("depth", 5.000, 2.000, 7.000);\nparam("angle", 0.646, 0.200, 1.200);\nparam("spin", 1.456, 0.000, 2.000);\nparam("hue", 0.719, 0.000, 1.000);\nparam("wob", 1.700, 0.000, 3.000);\n\nfunction draw(t) {\n  background(0.04);\n  translate(width / 2, height * 0.95);\n  stroke(1);\n  strokeWeight(2);\n  branch(height * 0.22, depth, t);\n}\n\nfunction branch(len, d, t) {\n  if (d < 1) return;\n  stroke(hsl((hue + d * 0.08) % 1, 0.7, 0.6));\n  line(0, 0, 0, -len);\n  translate(0, -len);\n  push();\n  rotate(angle + wob * 0.05 * sin(t * spin + d));\n  branch(len * 0.72, d - 1, t);\n  pop();\n  push();\n  rotate(0 - angle - wob * 0.05 * sin(t * spin + d));\n  branch(len * 0.72, d - 1, t);\n  pop();\n}\n
end
