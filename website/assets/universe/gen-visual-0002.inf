node 1 Source Sketch
  pos 0 0
  s code // Radial burst. Every param() is a knob you can modulate.\nparam("count", 12, 1, 64);\nparam("spin", 0.2, 0, 2);\nparam("size", 48, 4, 160);\n\nfunction draw(t) {\n  background(0.05);\n  translate(width / 2, height / 2);\n  noStroke();\n  const r = min(width, height) * 0.3;\n  for (let i = 0; i < count; i++) {\n    rotate(TAU / count + spin * t * 0.1);\n    fill(hsl(i / count, 0.7, 0.6));\n    circle(r * 1.2 + r * 0.4 * sin(t + i), 0, size);\n  }\n}\n
  f height 141.64
end
