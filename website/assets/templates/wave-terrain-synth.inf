infinite-patch 1
# Wave Terrain Synth: 2D orbital terrain scanning Field Synth
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 36
  i rangeHigh 64
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float radiusX = 1.6 [0.2, 4.0]\nparam float radiusY = 1.2 [0.2, 4.0]\nparam float terrainMult = 2.5 [1.0, 8.0]\nparam float warp = 0.45 [0.0, 1.0]\nparam float envDecay = 0.4 [0.05, 2.0]\nstate float phase = 0\nstate float subPhase = 0\nstate float env = 0\nstate float lp = 0\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * envDecay), 0.00005, 0.02)\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.1, env - env * decayRate)\n\npStep = clamp(freq, 20.0, 5000.0) / sr\nphase = (phase + pStep) % 1.0\nsubPhase = (subPhase + pStep * 0.5) % 1.0\n\nradX = radiusX * (0.6 + 0.4 * env)\nradY = radiusY * (0.5 + 0.5 * env)\nx = radX * sin(6.2831853 * phase)\ny = radY * cos(6.2831853 * phase * 1.5 + warp * sin(6.2831853 * subPhase))\n\nz1 = sin(x * terrainMult) * cos(y * terrainMult * 0.7)\nz2 = sin(x * y * (1.0 + warp * 3.0))\nraw = (z1 * 0.7 + z2 * 0.3) * (0.2 + 0.8 * env)\n\nfCut = clamp(3500.0 / sr * 2.2, 0.01, 0.45)\nlp = lp + fCut * (raw - lp)\n\nout = lp * 0.85\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 1 0.42 0.21
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Wave Terrain Synth. 2D orbit scanning a continuous non-linear height surface.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
