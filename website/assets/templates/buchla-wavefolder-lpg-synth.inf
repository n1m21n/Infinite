infinite-patch 1
# Buchla Wavefolder LPG Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 55
  i note2 60
  i note3 51
  i note4 48
  i note5 62
  i note6 58
  i note7 55
  i note8 46
  i note9 53
  i note10 58
  i note11 60
  i note12 48
  i note13 55
  i note14 63
  i note15 60
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float fmIndex = 1.65 [0.0, 4.5];\nparam float foldDrive = 2.8 [1.0, 6.0];\nparam float symmetry = 0.22 [-0.6, 0.6];\nparam float vactrol = 0.9993 [0.997, 0.9998];\nparam float drive = 1.35 [0.6, 2.8];\nstate float p1 = 0; state float p2 = 0;\nstate float lpg = 0; state float lp = 0;\n\nlpg = if(gate > 0.5, lpg + (1.0 - lpg) * 0.28, lpg * vactrol);\nf0 = clamp(freq, 40.0, 4200.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 1.503) / sr) % 1.0;\n\nmod = sin(6.2831853 * p2) * fmIndex * (0.35 + 0.65 * lpg);\ncarrier = sin(6.2831853 * p1 + mod) + symmetry;\nfolded = sin(carrier * foldDrive * (0.45 + 0.75 * lpg));\nfolded2 = sin(folded * 1.75 + carrier * 0.45);\n\ncutHz = clamp(180.0 + lpg * lpg * 4200.0, 80.0, 9000.0);\ng = clamp(2.0 * sin(3.14159265 * cutHz / sr), 0.015, 0.78);\nlp = lp + g * (folded2 * lpg - lp);\nsig = lp * drive;\nout = (sig / (1.0 + abs(sig) * 0.55)) * 0.52;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.14 0.34 0.62
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Buchla Wavefolder LPG Synth. West-Coast complex dual-oscillator FM into an asymmetric multi-stage sine wavefolder and vactrol low-pass gate.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
