{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Cumbia Rebajada Tape Slow FX",
    "author": "Infinite",
    "description": "Monterrey cumbia rebajada varispeed tape processor with capstan flutter drift, wooly oxide low-pass saturation, and warm spring feedback.",
    "domain": "effect"
  },
  "device": {
    "code": "param float toneHz = 1150.0 [280.0, 4200.0];\nparam float flutter = 0.42 [0.0, 0.9];\nparam float drive = 1.85 [0.7, 3.5];\nparam float feedback = 0.36 [0.0, 0.78];\nparam float mix = 0.85 [0.0, 1.0];\nstate float lp1 = 0; state float lp2 = 0; state float ap = 0; state float lfo = 0; state float fb = 0;\n\nlfo = (lfo + 0.65 / sr) % 1.0;\nmod = 0.55 + 0.35 * sin(6.2831853 * lfo) * flutter;\nx = in + fb * feedback;\ny = -mod * x + ap;\nap = x + mod * y;\n\nfHz = clamp(toneHz * (0.85 + 0.25 * sin(12.56637 * lfo)), 180.0, 5000.0);\ng = clamp(2.0 * sin(3.14159265 * fHz / sr), 0.02, 0.82);\nlp1 = lp1 + g * (y - lp1);\nlp2 = lp2 + g * (lp1 - lp2);\nfb = clamp(lp2, -1.0, 1.0);\n\nsat = (lp2 * drive) / (1.0 + abs(lp2 * drive) * 0.68);\nout = (in * (1.0 - mix) + sat * mix) * 0.82;\n",
    "params": {
      "toneHz": 1150.0,
      "flutter": 0.42,
      "drive": 1.85,
      "feedback": 0.36,
      "mix": 0.85
    }
  }
}
