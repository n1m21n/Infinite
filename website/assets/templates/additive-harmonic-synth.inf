infinite-patch 1
# Additive Harmonic Synth: 8-partial harmonic overtone generator Field Synth
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float tilt = 1.25 [0.4, 3.0]\nparam float oddEven = 0.5 [0.0, 1.0]\nparam float shimmer = 0.35 [0.0, 1.0]\nparam float decay = 2.2 [0.1, 6.0]\nparam float warmth = 1.35 [1.0, 3.5]\nstate float phase = 0\nstate float ampEnv = 0\nstate float tiltEnv = 0\nstate float lp = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nampDecayRate = clamp(1.0 / (sr * decay), 0.00002, 0.02)\ntiltDecayRate = clamp(1.0 / (sr * (decay * 0.6)), 0.00003, 0.025)\nampEnv = if(target > ampEnv, ampEnv + (target - ampEnv) * 0.18, ampEnv - ampEnv * ampDecayRate)\ntiltEnv = if(target > tiltEnv, tiltEnv + (target - tiltEnv) * 0.22, tiltEnv - tiltEnv * tiltDecayRate)\n\nf0 = clamp(freq, 20.0, 5000.0)\nstep = f0 / sr\nphase = (phase + step) % 1.0\n\ncurTilt = tilt + tiltEnv * 0.45\nevenScale = (1.0 - oddEven) * 2.0\noddScale = oddEven * 2.0\n\nh1 = sin(6.2831853 * phase) * oddScale\nh2 = sin(12.5663706 * phase) * (pow(2.0, -curTilt) * evenScale)\nh3 = sin(18.8495559 * phase) * (pow(3.0, -curTilt) * oddScale)\nh4 = sin(25.1327412 * phase) * (pow(4.0, -curTilt) * evenScale)\nh5 = sin(31.4159265 * phase) * (pow(5.0, -curTilt) * oddScale)\nh6 = sin(37.6991118 * phase) * (pow(6.0, -curTilt) * evenScale)\nh7 = sin(43.9822971 * phase) * (pow(7.0, -curTilt) * (oddScale + shimmer * 1.5))\nh8 = sin(50.2654824 * phase) * (pow(8.0, -curTilt) * (evenScale + shimmer * 1.5))\n\nraw = (h1 + h2 + h3 + h4 + h5 + h6 + h7 + h8) * (warmth * 0.55)\nsat = raw / (1.0 + abs(raw) * 0.22)\n\nlp = lp + 0.42 * (sat - lp)\nout = lp * ampEnv * 0.52\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Additive Harmonic Synth. 8-partial harmonic overtone generator with spectral tilt and odd/even balance.
  f width 360
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.18 0.5
mod pic sizeY ana 0 0 1 0.5 0.18 0.5
