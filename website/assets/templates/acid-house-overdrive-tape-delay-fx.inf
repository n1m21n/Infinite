infinite-patch 1
# Acid House Overdrive Tape Delay FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 38
  i note1 38
  i note2 50
  i note3 45
  i note4 38
  i note5 39
  i note6 48
  i note7 38
  i note8 38
  i note9 38
  i note10 50
  i note11 45
  i note12 38
  i note13 50
  i note14 43
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2800.0
  f resonance 0.25
  f decay 0.35
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float feedback = 0.52 [0.0, 0.85];\nparam float damping = 0.45 [0.1, 0.95];\nparam float drive = 1.8 [0.5, 4.0];\nparam float mix = 0.55 [0.0, 1.0];\nstate float d1 = 0;\nstate float d2 = 0;\nstate float lp = 0;\n\nx = in * drive;\nsat = x / (1.0 + abs(x));\n\nd1 = d1 + 0.14 * (sat + d2 * feedback - d1);\nd2 = d2 + 0.09 * (d1 - d2);\n\nfCut = clamp(1.0 - damping * 0.72, 0.08, 0.85);\nlp = lp + fCut * (d2 - lp);\n\nout = clamp((in * (1.0 - mix) + lp * mix * 1.15) * 0.62, -0.92, 0.92);\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.30 0.20
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House Overdrive Tape Delay FX. Punchy saturated analog delay with warm feedback damping and rhythmic echo smear.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
