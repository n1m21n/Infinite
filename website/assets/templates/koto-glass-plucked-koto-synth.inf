infinite-patch 1
# Koto Glass Plucked Koto Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 62
  i note1 64
  i note2 69
  i note3 71
  i note4 64
  i note5 69
  i note6 74
  i note7 71
  i note8 62
  i note9 67
  i note10 69
  i note11 76
  i note12 69
  i note13 64
  i note14 67
  i note15 62
  b en0 1
  b en1 1
