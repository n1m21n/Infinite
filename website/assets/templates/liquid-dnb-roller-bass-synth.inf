infinite-patch 1
# Liquid DnB Roller Bass Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 38
  i note1 38
  i note2 41
  i note3 41
  i note4 45
  i note5 45
  i note6 43
  i note7 43
  i note8 38
  i note9 38
  i note10 41
  i note11 41
  i note12 46
  i note13 46
  i note14 45
  i note15 43
  b en0 1
  b en1 1
