infinite-patch 1
# Karplus Sympathetic Bridge FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 1.0
  i steps 16
  i note0 48
  i note1 52
  i note2 55
  i note3 59
  i note4 60
  i note5 59
  i note6 55
  i note7 52
  i note8 45
  i note9 48
  i note10 52
  i note11 55
  i note12 57
  i note13 55
  i note14 52
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id src
  pos 340 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 680 1024
  s code param float bridgeFreq = 420.0 [120.0, 1800.0];\nparam float coupling = 0.64 [0.0, 0.88];\nparam float dampHz = 2800.0 [600.0, 7500.0];\nparam float driftHz = 0.45 [0.05, 3.0];\nparam float mix = 0.62 [0.0, 1.0];\nstate float lfo = 0; state float fb = 0;\nstate float z1 = 0; state float z2 = 0; state float z3 = 0; state float z4 = 0;\nstate float lp1 = 0; state float lp2 = 0;\n\nlfo = (lfo + driftHz / sr) % 1.0;\nsig = in + fb * coupling;\n\nk1 = clamp(0.65 + 0.12 * sin(6.2831853 * lfo), 0.1, 0.88);\ngB = clamp(2.0 * sin(3.14159265 * bridgeFreq / sr), 0.04, 0.82);\n\nz1 = z1 + gB * (sig - z1);\nz2 = z2 + (gB * 1.498) * (z1 - z2);\ny3 = -k1 * z2 + z3; z3 = z2 + k1 * y3;\ny4 = -0.68 * y3 + z4; z4 = y3 + 0.68 * y4;\n\ngD = clamp(2.0 * sin(3.14159265 * dampHz / sr), 0.04, 0.85);\nlp1 = lp1 + gD * (y4 - lp1);\nlp2 = lp2 + (gD * 0.72) * (lp1 - lp2);\ndrv = lp2 * 1.35;\nfb = drv / (1.0 + abs(drv));\n\nout = (in * (1.0 - mix) + fb * mix) * 0.78;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.42 0.64 0.56
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Karplus Sympathetic Bridge FX. Tuned sympathetic string-bridge resonator bank with lowpass bridge damping and nonlinear inter-string feedback.
  f width 340
  f height 120
end
note src 0 notes
aud fx 0 src
aud speakers 0 fx
cable out 0 pic
