infinite-patch 1
# Pulsar Train Synth: microsound pulsar train generator with duty-cycle morphing
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 36
  i rangeHigh 64
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float formantRatio = 3.2 [1.0, 8.0]\nparam float dutyCycle = 0.45 [0.05, 0.95]\nparam float envDecay = 0.7 [0.05, 3.0]\nparam float filterCutoff = 4800.0 [200.0, 14000.0]\nparam float subLevel = 0.35 [0.0, 1.0]\nstate float phase = 0\nstate float subPhase = 0\nstate float env = 0\nstate float lp = 0\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * envDecay), 0.00005, 0.02)\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.15, env - env * decayRate)\n\npStep = clamp(freq, 20.0, 5000.0) / sr\nphase = (phase + pStep) % 1.0\nsubPhase = (subPhase + pStep * 0.5) % 1.0\n\npulsaret = if(phase < dutyCycle, sin(6.2831853 * (phase / dutyCycle) * formantRatio) * (0.5 - 0.5 * cos(6.2831853 * (phase / dutyCycle))), 0.0)\nsub = sin(6.2831853 * subPhase) * subLevel\n\nraw = (pulsaret * 1.2 + sub) * env\n\nfCut = clamp(filterCutoff / sr * 2.0, 0.01, 0.46)\nlp = lp + fCut * (raw - lp)\n\nout = lp * 0.85\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Pulsar Train Synth. Microsound pulsar train generator with duty-cycle morphing.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
