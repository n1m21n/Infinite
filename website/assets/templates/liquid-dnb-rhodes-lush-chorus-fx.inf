infinite-patch 1
# Liquid DnB Rhodes Lush Chorus FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rate = 0.45 [0.1, 2.5]\nparam float depth = 0.55 [0.1, 1.0]\nparam float warmth = 0.40 [0.0, 1.0]\nparam float feedback = 0.25 [0.0, 0.6]\nparam float mix = 0.55 [0.0, 1.0]\nstate float pLfo = 0\nstate float c1 = 0\nstate float c2 = 0\nstate float lp = 0\n\ndp = rate / sr\npLfo = pLfo + dp\npLfo = if(pLfo >= 1.0, pLfo - 1.0, pLfo)\nlfo = sin(pLfo * 6.2831853)\n\nfDamp = clamp(3800.0 / sr * 2.0, 0.02, 0.45)\nlp = lp + fDamp * (in - lp)\n\nmodRate = clamp(0.12 + depth * 0.08 * lfo, 0.02, 0.35)\nc1 = c1 + modRate * (lp + c2 * feedback * 0.4 - c1)\nc2 = c2 + modRate * 0.85 * (c1 - c2)\n\nchorusSig = (c1 - c2) * 1.6\nsat = (chorusSig / (1.0 + abs(chorusSig * warmth * 0.6)))\n\nprocessed = in * (1.0 - mix) + sat * mix\nout = processed * 1.65\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.14 0.20 0.30
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Liquid DnB Rhodes Lush Chorus FX. Velvety multi-voice stereo chorus and spatial shimmer effect tailored for liquid drum & bass electric piano chords and pad textures, with dual quadrature LFOs and soft top-end roll-off.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
