infinite-patch 1
# Classic Trance Resonant Sweep FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3400.0
  f resonance 0.32
  f decay 0.28
  f volume 0.8
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float centerFreq = 1600.0 [300.0, 4500.0]\nparam float resonance = 0.48 [0.1, 0.88]\nparam float sweepDepth = 0.65 [0.0, 1.0]\nparam float sweepRate = 0.28 [0.05, 1.5]\nparam float mix = 0.65 [0.0, 1.0]\nstate float lp1 = 0\nstate float lp2 = 0\nstate float lfo = 0\n\nlfo = (lfo + sweepRate / sr) % 1.0\nmod = (sin(lfo * 6.2831853) * 0.5 + 0.5) * sweepDepth\n\nfMod = centerFreq * (1.0 + mod * 1.8)\nfCut = clamp(fMod / sr * 2.4, 0.012, 0.45)\n\nlp1 = lp1 + fCut * (in - lp1 - resonance * lp2)\nlp2 = lp2 + fCut * (lp1 - lp2)\n\nu = lp2 * 1.45\nsat = clamp(u - 0.22 * u * u * u, -0.95, 0.95)\n\nout = (in * (1.0 - mix) + sat * mix) * 1.32\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.28 0.45
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Classic Trance Resonant Sweep FX. Euphoric trance resonant state-variable filter and harmonic exciter with modulated peak sweep, warm analog saturation, and dynamic stereo presence.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
