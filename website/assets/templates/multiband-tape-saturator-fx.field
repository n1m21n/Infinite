{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Multiband Tape Saturator FX",
    "author": "Infinite",
    "description": "Three-band crossover tape saturator with low-end magnetic head hysteresis, even/odd harmonic drive, and dynamic tape bias.",
    "domain": "sample"
  },
  "device": {
    "code": "param float driveLow = 1.80 [0.5, 5.0];\nparam float driveMid = 1.40 [0.5, 4.0];\nparam float driveHigh = 1.10 [0.5, 3.0];\nparam float bias = 0.25 [-0.5, 0.5];\nparam float warmth = 0.65 [0.0, 1.0];\nparam float mix = 1.00 [0.0, 1.0];\nstate float lpLow = 0;\nstate float lpHpd = 0;\nstate float hpHigh = 0;\nstate float env = 0;\nstate float biasDrift = 0;\n\nenv = env + 0.003 * (abs(in) - env);\nbiasDrift = env * 0.35 * bias;\n\n// 3-band crossover (low: < 350 Hz, mid: 350 - 3800 Hz, high: > 3800 Hz)\nfLow = clamp(350.0 / sr * 2.0, 0.005, 0.45);\nlpLow = lpLow + fLow * (in - lpLow);\nsigLow = lpLow;\n\nfHigh = clamp(3800.0 / sr * 2.0, 0.01, 0.45);\nhpHigh = hpHigh + fHigh * (in - hpHigh);\nsigHigh = in - hpHigh;\n\nsigMid = in - sigLow - sigHigh;\n\n// Low-band magnetic core hysteresis saturation\nuLow = (sigLow * driveLow + biasDrift);\nsatLow = uLow / (1.0 + abs(uLow) * 0.4);\n\n// Mid-band even/odd harmonic tape saturation\nuMid = sigMid * driveMid;\nsatMid = tanh(uMid * 1.25) * 0.85;\n\n// High-band tape HF compression and softness\nuHigh = sigHigh * driveHigh;\nsatHigh = uHigh / (1.0 + abs(uHigh) + 0.3 * (uHigh * uHigh));\n\nprocessed = satLow * (1.0 + warmth * 0.25) + satMid + satHigh;\nout = in * (1.0 - mix) + processed * mix * 0.72;\n",
    "params": {
      "driveLow": 1.8,
      "driveMid": 1.4,
      "driveHigh": 1.1,
      "bias": 0.25,
      "warmth": 0.65,
      "mix": 1.0
    },
    "nodeSettings": {}
  }
}
