infinite-patch 1
# French Touch Disco Filter FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3000.0
  f resonance 0.35
  f decay 0.22
  f volume 0.55
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float sweepRate = 1.25 [0.1, 10.0]\nparam float resonance = 0.72 [0.1, 0.96]\nparam float cutoff = 1500.0 [80.0, 9000.0]\nparam float drive = 1.35 [0.5, 3.5]\nparam float mix = 0.75 [0.0, 1.0]\nstate float lfo = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float s4 = 0\n\nlfo = (lfo + sweepRate / sr) % 1.0\nsweep = sin(lfo * 6.2831853) * 0.42 + 0.58\n\nu = in * drive\nsat = clamp(u - 0.2 * u * u * u, -1.0, 1.0)\n\nfCut = clamp((cutoff * sweep) / sr * 3.14159265, 0.005, 0.48)\nfb = resonance * 3.6\ninputSignal = sat - s4 * fb\n\ns1 = s1 + fCut * (inputSignal - s1)\ns2 = s2 + fCut * (s1 - s2)\ns3 = s3 + fCut * (s2 - s3)\ns4 = s4 + fCut * (s3 - s4)\n\nout = (in * (1.0 - mix) + s4 * mix) * 1.15\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.45 0.15 0.22
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text French Touch Disco Filter FX. Classic 4-pole French Touch resonant low-pass filter with rhythmic LFO sweep, saturation drive, and disco pump character.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
