infinite-patch 1
# Spectral Gate Stutter FX: rhythmic spectral gating and micro-loop freeze stutter
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float rateHz = 8.0 [1.0, 20.0]\nparam float threshold = 0.12 [0.01, 0.5]\nparam float hysteresis = 0.45 [0.1, 0.9]\nparam float feedback = 0.62 [0.0, 0.95]\nparam float mix = 0.8 [0.0, 1.0]\nstate float phase = 0\nstate float gateState = 1.0\nstate float envIn = 0\nstate float buf = 0\nstate float lp = 0\n\nabsIn = abs(in)\nenvIn = envIn + if(absIn > envIn, 0.25, 0.002) * (absIn - envIn)\n\ngateState = if(envIn > threshold, 1.0, if(envIn < (threshold * hysteresis), 0.0, gateState))\n\nphase = (phase + rateHz / sr) % 1.0\nchop = if(phase < 0.5, 1.0, 0.0)\n\nfbSig = buf * feedback\nrawWet = (in + fbSig) * chop * gateState\nbuf = rawWet\n\nlp = lp + 0.15 * (rawWet - lp)\n\nout = in * (1.0 - mix) + lp * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Spectral Gate Stutter FX. Rhythmic spectral gating and micro-loop freeze stutter.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
