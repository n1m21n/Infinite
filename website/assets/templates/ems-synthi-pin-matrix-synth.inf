infinite-patch 1
# EMS Synthi Pin Matrix Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 51
  i note2 55
  i note3 54
  i note4 48
  i note5 55
  i note6 58
  i note7 54
  i note8 48
  i note9 51
  i note10 53
  i note11 58
  i note12 55
  i note13 54
  i note14 51
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
