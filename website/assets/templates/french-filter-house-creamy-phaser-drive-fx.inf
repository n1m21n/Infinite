infinite-patch 1
# French Filter House Creamy Phaser Drive FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.28
  f decay 0.30
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rate = 0.40 [0.05, 1.5];\nparam float depth = 0.60 [0.1, 0.95];\nparam float feedback = 0.45 [0.0, 0.85];\nparam float warmth = 0.70 [0.1, 1.0];\nparam float mix = 0.55 [0.0, 1.0];\nstate float lfo = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float fb = 0;\n\nlfo = (lfo + rate * 0.0015) % 1.0;\nmod = (0.5 + 0.5 * sin(6.2831853 * lfo)) * depth;\n\nkRate = clamp(0.08 + mod * 0.18, 0.02, 0.35);\n\nx = in + fb * feedback * 0.6;\nap1 = ap1 + kRate * (x - ap1);\nap2 = ap2 + kRate * (ap1 - ap2);\nap3 = ap3 + kRate * (ap2 - ap3);\nap4 = ap4 + kRate * (ap3 - ap4);\n\nphaseSig = ap4;\nu = phaseSig * (1.0 + warmth * 0.5);\nfb = u / (1.0 + abs(u) * 0.3);\n\nprocessed = in * (1.0 - mix) + fb * mix * 1.1;\nout = processed * 0.90;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text French Filter House Creamy Phaser Drive FX. Silky multi-stage vintage analog phaser and warm console saturation effect designed for French house rhodes stabs, guitars, and filtered disco master buses.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
