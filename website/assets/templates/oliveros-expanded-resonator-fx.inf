infinite-patch 1
# Oliveros Expanded Resonator FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 57
  i note2 53
  i note3 50
  i note4 57
  i note5 62
  i note6 60
  i note7 57
  i note8 48
  i note9 55
  i note10 52
  i note11 48
  i note12 55
  i note13 60
  i note14 57
  i note15 53
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2100.0
  f resonance 0.24
  f decay 0.55
  f volume 0.78
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float formantHz = 540.0 [160.0, 2200.0];\nparam float driftHz = 0.22 [0.04, 1.8];\nparam float smear = 0.68 [0.1, 0.9];\nparam float regen = 0.42 [0.0, 0.76];\nparam float mix = 0.78 [0.0, 1.0];\nstate float a1 = 0; state float a2 = 0; state float a3 = 0;\nstate float bp = 0; state float lp = 0; state float fb = 0; state float lfo = 0;\n\nlfo = (lfo + driftHz / sr) % 1.0;\nc = clamp(smear + 0.16 * sin(6.2831853 * lfo), 0.1, 0.88);\nx = in + fb * regen;\ny1 = -c * x + a1; a1 = x + c * y1;\ny2 = -c * y1 + a2; a2 = y1 + c * y2;\ny3 = -c * y2 + a3; a3 = y2 + c * y3;\n\nf0 = clamp(formantHz * (1.0 + 0.28 * sin(6.2831853 * lfo)), 120.0, 3600.0);\ng = clamp(2.0 * sin(3.14159265 * f0 / sr), 0.02, 0.78);\nbp = bp + g * (y3 - lp - 0.52 * bp);\nlp = lp + g * bp;\nfb = clamp(bp * 0.62 + lp * 0.28, -1.0, 1.0);\n\nwet = (y3 * 0.52 + bp * 0.55 + lp * 0.25) / (1.0 + abs(y3) * 0.48);\nout = (in * (1.0 - mix) + wet * mix) * 0.82;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.42 0.46
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Oliveros Expanded Resonator FX. Deep-listening allpass dispersion and drifting formant bandpass chamber with soft console saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
