infinite-patch 1
# BBD Bucket Brigade FX: analog bucket brigade device delay line and chorus
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float delayMs = 35.0 [5.0, 150.0]\nparam float depth = 0.4 [0.0, 1.0]\nparam float rateHz = 1.2 [0.1, 8.0]\nparam float feedback = 0.45 [0.0, 0.95]\nparam float warmth = 0.6 [0.0, 1.0]\nparam float mix = 0.5 [0.0, 1.0]\nstate float lfoPhase = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float lp = 0\nstate float fb = 0\n\nlfoPhase = (lfoPhase + rateHz / sr) % 1.0\nlfo = sin(6.2831853 * lfoPhase)\n\ncurSig = in + fb * feedback\nsatIn = tanh(curSig * (1.0 + warmth * 0.5))\n\nclockMod = clamp(delayMs * 0.001 * sr * (1.0 + lfo * depth * 0.3), 10.0, 4000.0)\ndecayFactor = clamp(1.0 / (clockMod * 0.33), 0.001, 0.4)\n\ns1 = s1 + (satIn - s1) * decayFactor\ns2 = s2 + (s1 - s2) * decayFactor\ns3 = s3 + (s2 - s3) * decayFactor\n\nbbdOut = s3\nfb = bbdOut\nlp = lp + clamp(4200.0 / sr * 2.0 * (1.0 - warmth * 0.4), 0.02, 0.45) * (bbdOut - lp)\n\nout = in * (1.0 - mix) + lp * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text BBD Bucket Brigade FX. Analog bucket brigade device delay line with discrete stage transfer and warmth.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
