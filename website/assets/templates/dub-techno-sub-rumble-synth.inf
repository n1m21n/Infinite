infinite-patch 1
# Dub Techno Sub Rumble Synth
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 36
  i rangeHigh 60
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float subDrive = 1.6 [1.0, 4.0]\nparam float subTone = 0.45 [0.0, 1.0]\nparam float punch = 0.55 [0.0, 1.0]\nparam float glideRate = 0.12 [0.02, 0.5]\nparam float decay = 0.55 [0.1, 2.0]\nstate float phase = 0\nstate float curFreq = 55\nstate float env = 0\nstate float pEnv = 0\nstate float s1 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01)\nenv = if(target > env, env + (target - env) * 0.15, env - env * decayRate)\n\npEnv = if(target > pEnv, 1.0, pEnv * 0.998)\ncurFreq = curFreq + (freq * 0.5 - curFreq) * glideRate\nf0 = clamp(curFreq + pEnv * punch * 40.0, 20.0, 600.0)\n\npStep = f0 / sr\nphase = (phase + pStep) % 1.0\n\nsin1 = sin(phase * 6.2831853)\nsin2 = sin((phase * 2.0) % 1.0 * 6.2831853) * subTone * 0.5\nraw = (sin1 + sin2) * env\n\nu = raw * subDrive\nsat = u / (1.0 + abs(u) * 0.5)\n\nfCut = clamp(240.0 / sr * 2.4, 0.005, 0.35)\ns1 = s1 + fCut * (sat - s1)\n\nout = s1 * 0.28\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.32 0.45
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Dub Techno Sub Rumble Synth. Sub-octave sinusoidal bass synthesizer with warm soft saturation, pitch glide envelope, and deep low-end punch.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
