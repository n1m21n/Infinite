{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Metallic Gong Inharmonic Synth",
    "author": "Infinite",
    "description": "Four-partial inharmonic bronze gong and metallophone synthesizer with mallet strike transient, shimmer beating, and warm nonlinear saturation.",
    "domain": "synth"
  },
  "device": {
    "code": "param float shimmer = 1.4 [0.1, 5.0];\nparam float inharm = 1.0 [0.7, 1.35];\nparam float strike = 0.55 [0.0, 1.0];\nparam float dampHz = 3800.0 [800.0, 7500.0];\nparam float decay = 0.9995 [0.997, 0.9998];\nstate float p1 = 0; state float p2 = 0; state float p3 = 0; state float p4 = 0;\nstate float env = 0; state float atk = 0; state float lp1 = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.12, env * decay);\natk = if(gate > 0.5, atk * 0.993, 1.0);\n\nf0 = clamp(freq, 40.0, 2400.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 2.756 * inharm + shimmer) / sr) % 1.0;\np3 = (p3 + (f0 * 5.404 * inharm - shimmer * 0.6) / sr) % 1.0;\np4 = (p4 + (f0 * 8.93 * inharm) / sr) % 1.0;\n\nm1 = sin(6.2831853 * p1 + 0.35 * atk * strike * sin(6.2831853 * p2));\nm2 = sin(6.2831853 * p2) * 0.48 * env;\nm3 = sin(6.2831853 * p3) * 0.24 * env * env;\nm4 = sin(6.2831853 * p4) * (0.14 + 0.22 * strike) * atk;\n\nraw = (m1 * 0.68 + m2 + m3 + m4) * env;\ng = clamp(2.0 * sin(3.14159265 * dampHz / sr), 0.05, 0.85);\nlp1 = lp1 + g * (raw - lp1);\n\ndrv = lp1 * 1.3;\nout = (drv / (1.0 + abs(drv))) * 0.62;\n",
    "params": {
      "shimmer": 1.4,
      "inharm": 1.0,
      "strike": 0.55,
      "dampHz": 3800.0,
      "decay": 0.9995
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
