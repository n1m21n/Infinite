infinite-patch 1
# Ambient Piano Cloud Reverb Diffusion FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float decay = 0.55 [0.1, 0.9]\nparam float tone = 0.50 [0.1, 1.0]\nparam float size = 0.60 [0.1, 1.0]\nparam float shimmer = 0.35 [0.0, 1.0]\nparam float mix = 0.55 [0.0, 1.0]\nstate float a1 = 0\nstate float a2 = 0\nstate float a3 = 0\nstate float a4 = 0\nstate float lp = 0\n\nfTone = clamp(0.06 + tone * 0.36, 0.02, 0.45)\nlp = lp + fTone * (in - lp)\n\nkDiff = clamp(0.12 * (1.0 + size * 0.8), 0.04, 0.38)\nkDecay = clamp(decay * 0.82, 0.1, 0.88)\n\na1 = a1 + kDiff * (lp + a4 * kDecay - a1)\na2 = a2 + kDiff * 0.85 * (a1 - a2)\na3 = a3 + kDiff * 0.72 * (a2 - a3)\na4 = a4 + kDiff * 0.65 * (a3 - a4)\n\nshim = (a1 - a3) * shimmer * 0.4\ndiff = (a2 + a4 * 0.8 + shim) * 0.92\n\nsat = diff / (1.0 + abs(diff * 0.25))\nwet = sat * 0.85\nprocessed = in * (1.0 - mix) + wet * mix\nout = processed * 0.70\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Ambient Piano Cloud Reverb Diffusion FX. Lush ambient space reverberator featuring multi-stage allpass diffusion network, soft tape saturation in the feedback path, and gentle high-cut air damping.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
