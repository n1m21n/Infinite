infinite-patch 1
# Spring Plate Dispersion Steel Plate FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 48
  i note5 55
  i note6 52
  i note7 50
  i note8 48
  i note9 50
  i note10 55
  i note11 60
  i note12 48
  i note13 55
  i note14 52
  i note15 57
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float density = 0.72 [0.15, 0.88];\nparam float shimmer = 0.42 [0.0, 1.0];\nparam float sheen = 0.74 [0.2, 1.0];\nparam float warmth = 1.35 [0.8, 2.8];\nparam float mix = 0.64 [0.0, 1.0];\nstate float lfo1 = 0;\nstate float lfo2 = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float lp = 0;\nstate float hpState = 0;\n\nlfo1 = (lfo1 + 0.62 / sr) % 1.0;\nlfo2 = (lfo2 + 1.18 / sr) % 1.0;\ng1 = clamp(density + sin(6.2831853 * lfo1) * 0.09 * shimmer, -0.88, 0.88);\ng2 = clamp(density * 0.88 + cos(6.2831853 * lfo2) * 0.09 * shimmer, -0.88, 0.88);\n\ny1 = -g1 * in + ap1;\nap1 = in + g1 * y1;\n\ny2 = -g2 * y1 + ap2;\nap2 = y1 + g2 * y2;\n\ny3 = -g1 * y2 + ap3;\nap3 = y2 + g1 * y3;\n\ny4 = -g2 * y3 + ap4;\nap4 = y3 + g2 * y4;\n\n# Plate sheen tilt + soft transformer warmth\nhpState = hpState + 0.06 * (y4 - hpState);\nbright = y4 + (y4 - hpState) * (sheen * 0.45);\nfCut = clamp(0.12 + sheen * 0.30, 0.05, 0.44);\nlp = lp + fCut * (bright - lp);\n\nsat = (lp * warmth) / (1.0 + abs(lp * warmth) * 0.40);\nout = in * (1.0 - mix) + sat * mix;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.26 0.16 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Spring Plate Dispersion Steel Plate FX. Dense steel plate diffusion lattice with early metallic reflections, phase-modulated allpass tank, and warm sheen tilt.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
