infinite-patch 1
# Dub Tape Dispersion FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 55
  i note2 58
  i note3 60
  i note4 58
  i note5 55
  i note6 51
  i note7 48
  i note8 48
  i note9 60
  i note10 63
  i note11 62
  i note12 58
  i note13 55
  i note14 53
  i note15 51
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 360 1024
  i wave1 1
  f cutoff 2400.0
  f resonance 0.25
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float wowHz = 0.52 [0.1, 2.2];\nparam float drive = 1.9 [0.8, 3.8];\nparam float dispersion = 0.62 [0.1, 0.9];\nparam float dubHz = 1350.0 [350.0, 4500.0];\nparam float mix = 0.72 [0.0, 1.0];\nstate float pWow = 0;\nstate float ap1 = 0; state float ap2 = 0; state float ap3 = 0; state float ap4 = 0;\nstate float bp = 0; state float lp = 0; state float fb = 0;\n\npWow = (pWow + wowHz / sr) % 1.0;\nc = clamp(dispersion + 0.18 * sin(6.2831853 * pWow), 0.12, 0.88);\n\nx = in + fb * 0.42;\n# Asymmetric magnetic tape saturation\nasym = x + 0.12 * x * x;\nsat = (asym * drive) / (1.0 + abs(asym * drive) * 0.72);\n\n# 4-stage allpass dispersion network\ny1 = -c * sat + ap1; ap1 = sat + c * y1;\ny2 = -c * y1 + ap2; ap2 = y1 + c * y2;\ny3 = -c * y2 + ap3; ap3 = y2 + c * y3;\ny4 = -c * y3 + ap4; ap4 = y3 + c * y4;\n\n# Damped dub bandpass feedback tone\ng = clamp(2.0 * sin(3.14159265 * dubHz / sr), 0.03, 0.82);\nbp = bp + g * (y4 - lp - 0.62 * bp);\nlp = lp + g * bp;\nfb = clamp(lp * 0.55 + bp * 0.45, -1.0, 1.0);\n\nwet = y4 * 0.55 + lp * 0.45;\nout = (in * (1.0 - mix) + wet * mix) * 0.64;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1080 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Dub Tape Dispersion FX. Asymmetric tape-saturated dub resonator with capstan wow drift, 4-stage allpass phase dispersion, and damped bandpass feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
