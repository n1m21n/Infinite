infinite-patch 1
# Op Art Frequency Shifter FX: single-sideband frequency shifter with barber-pole phasing
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2800.0
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float shiftHz = 14.0 [-100.0, 100.0]\nparam float barberRate = 0.45 [0.05, 2.0]\nparam float feedback = 0.35 [0.0, 0.85]\nparam float dispersion = 0.6 [0.0, 1.0]\nparam float mix = 0.5 [0.0, 1.0]\nstate float carrierPhase = 0\nstate float barberPhase = 0\nstate float q1 = 0\nstate float q2 = 0\nstate float prevOut = 0\n\ncarrierPhase = (carrierPhase + shiftHz / sr) % 1.0\nbarberPhase = (barberPhase + barberRate / sr) % 1.0\n\ndrive = in + prevOut * feedback * 0.6\n\nq1 = q1 + 0.5 * (drive - q1)\nq2 = q2 + 0.25 * (q1 - q2)\n\ncI = cos(carrierPhase * 6.2831853)\nsQ = sin(carrierPhase * 6.2831853)\n\nbarberTrem = sin(barberPhase * 6.2831853) * dispersion * 0.4 + 1.0\nshifted = (drive * cI - (drive - q2 * 1.5) * sQ) * barberTrem\n\nprevOut = tanh(shifted)\nout = in * (1.0 - mix) + prevOut * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Op Art Frequency Shifter FX. Single-sideband frequency shifter with quadrature phase splitting and endless barber-pole Shepard tone sweeps.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
