infinite-patch 1
# Schroeder QRD Prime Diffuser FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 55
  i note5 50
  i note6 48
  i note7 52
  i note8 48
  i note9 55
  i note10 57
  i note11 60
  i note12 57
  i note13 55
  i note14 52
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float scatter = 0.74 [0.15, 0.92];\nparam float dampingHz = 3200.0 [600.0, 9000.0];\nparam float feedback = 0.46 [0.0, 0.78];\nparam float drive = 1.35 [0.6, 2.6];\nparam float mix = 0.82 [0.0, 1.0];\nstate float a1 = 0; state float a2 = 0; state float a3 = 0; state float a4 = 0; state float a5 = 0;\nstate float lp = 0; state float fb = 0; state float lfo = 0;\n\nlfo = (lfo + 0.22 / sr) % 1.0;\nc = clamp(scatter + 0.08 * sin(6.2831853 * lfo), 0.1, 0.92);\n\nx = in + fb * feedback;\ny1 = -c * x + a1; a1 = x + c * y1;\ny2 = -(c * 0.91) * y1 + a2; a2 = y1 + (c * 0.91) * y2;\ny3 = -(c * 0.83) * y2 + a3; a3 = y2 + (c * 0.83) * y3;\ny4 = -(c * 0.77) * y3 + a4; a4 = y3 + (c * 0.77) * y4;\ny5 = -(c * 0.69) * y4 + a5; a5 = y4 + (c * 0.69) * y5;\n\ng = clamp(2.0 * sin(3.14159265 * dampingHz / sr), 0.04, 0.88);\nlp = lp + g * (y5 - lp);\nfb = clamp(lp, -1.0, 1.0);\n\nwd = lp * drive;\nwet = wd / (1.0 + abs(wd) * 0.65);\nout = (in * (1.0 - mix) + wet * mix) * 0.88;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Schroeder QRD Prime Diffuser FX. Quadratic-residue prime acoustic diffuser processor cascading prime-scaled allpass scattering stages with resonant room absorption and stereo width.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
