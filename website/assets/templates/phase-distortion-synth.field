{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Phase Distortion Synth",
    "author": "Infinite",
    "description": "Casio CZ-style phase distortion synthesizer with resonant formant windowing, exponential decay envelopes, sub-oscillator and analog saturation.",
    "domain": "synth"
  },
  "device": {
    "code": "param float resonance = 3.2 [0.5, 8.0];\nparam float envDepth = 4.5 [0.0, 10.0];\nparam float decay = 1.8 [0.1, 6.0];\nparam float subLevel = 0.35 [0.0, 1.0];\nparam float drive = 1.4 [1.0, 3.5];\nstate float phase = 0;\nstate float subPhase = 0;\nstate float ampEnv = 0;\nstate float filtEnv = 0;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nampDecayRate = clamp(1.0 / (sr * decay), 0.00002, 0.02);\nfiltDecayRate = clamp(1.0 / (sr * (decay * 0.65)), 0.00003, 0.03);\nampEnv = if(target > ampEnv, ampEnv + (target - ampEnv) * 0.18, ampEnv - ampEnv * ampDecayRate);\nfiltEnv = if(target > filtEnv, filtEnv + (target - filtEnv) * 0.22, filtEnv - filtEnv * filtDecayRate);\n\nf0 = clamp(freq, 20.0, 5000.0);\nstep = f0 / sr;\nphase = (phase + step) % 1.0;\nsubPhase = (subPhase + step * 0.5) % 1.0;\n\nresMult = 1.0 + resonance + filtEnv * envDepth;\nresPhase = (phase * resMult) % 1.0;\nresWindow = (1.0 - phase);\nczRes = sin(6.2831853 * resPhase) * resWindow;\n\nsubOsc = sin(6.2831853 * subPhase) * subLevel;\n\nraw = (czRes + subOsc) * drive;\nsat = raw / (1.0 + abs(raw) * 0.3);\n\nlp = lp + 0.35 * (sat - lp);\nout = lp * ampEnv * 0.5;\n",
    "params": {
      "resonance": 3.2,
      "envDepth": 4.5,
      "decay": 1.8,
      "subLevel": 0.35,
      "drive": 1.4
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
