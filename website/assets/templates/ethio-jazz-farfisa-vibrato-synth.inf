node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float vibratoHz = 5.4 [1.5, 9.0];\nparam float vibratoDepth = 0.0085 [0.0, 0.025];\nparam float drawbarMix = 0.68 [0.0, 1.0];\nparam float drive = 1.65 [0.8, 3.5];\nparam float decay = 0.9992 [0.995, 0.9998];\nstate float p1 = 0; state float p2 = 0; state float vibPh = 0;\nstate float env = 0; state float lp = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.22, env * decay);\nvibPh = (vibPh + vibratoHz / sr) % 1.0;\nf0 = clamp(freq * (1.0 + vibratoDepth * sin(6.2831853 * vibPh)), 40.0, 4200.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 2.0) / sr) % 1.0;\n\nw1 = sin(6.2831853 * p1);\nw2 = sin(6.2831853 * p2);\nw3 = sin(18.849556 * p1);\norgan = (w1 / (1.0 + abs(w1) * 0.5)) * 0.55 + (w2 * 0.36 + w3 * 0.24) * drawbarMix;\nsat = (organ * drive) / (1.0 + abs(organ * drive) * 0.65);\nlp = lp + 0.30 * (sat - lp);\nsig = lp * env * 0.42;\nout = sig / (1.0 + abs(sig) * 0.35);\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.18 0.14
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Ethio-Jazz Farfisa Vibrato Synth. 1970s Addis Ababa transistor organ synthesizer with 4-drawbar harmonic bank, key-click transient, diode saturation, and dual-rate vibrato.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
