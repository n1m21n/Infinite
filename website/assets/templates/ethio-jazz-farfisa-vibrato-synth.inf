infinite-patch 1
# Ethio-Jazz Farfisa Vibrato Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 51
  i note1 54
  i note2 56
  i note3 58
  i note4 61
  i note5 58
  i note6 56
  i note7 54
  i note8 51
  i note9 58
  i note10 61
  i note11 63
  i note12 61
  i note13 58
  i note14 56
  i note15 54
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
