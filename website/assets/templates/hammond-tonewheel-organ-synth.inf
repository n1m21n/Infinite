  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float subOctave = 0.72 [0.0, 1.0];\nparam float fundamental = 0.85 [0.0, 1.0];\nparam float percussion = 0.55 [0.0, 1.0];\nparam float brightness = 0.48 [0.0, 1.0];\nparam float drive = 1.45 [0.6, 3.0];\nstate float pSub = 0; state float p1 = 0; state float p2 = 0; state float p3 = 0;\nstate float env = 0; state float percEnv = 1.0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.28, env * 0.9965);\npercEnv = if(gate > 0.5, percEnv * 0.9968, 1.0);\n\nf0 = clamp(freq, 45.0, 2800.0);\npSub = (pSub + (f0 * 0.5) / sr) % 1.0;\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 2.0) / sr) % 1.0;\np3 = (p3 + (f0 * 3.0) / sr) % 1.0;\n\ndrawbars = sin(6.2831853 * pSub) * subOctave * 0.55 + sin(6.2831853 * p1) * fundamental * 0.72 + sin(6.2831853 * p2) * (0.42 + brightness * 0.25) + sin(6.2831853 * p3) * (0.18 + percussion * percEnv * 0.58);\n\nraw = drawbars * env * 0.52;\nout = ((raw * drive) / (1.0 + abs(raw * drive) * 0.65)) * 0.64;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Hammond Tonewheel Organ Synth. Electromagnetic 9-drawbar tonewheel organ with harmonic key-click transient, 3rd harmonic percussion decay, and warm tube-preamp saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
