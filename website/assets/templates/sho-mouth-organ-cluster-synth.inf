infinite-patch 1
# Sho Mouth Organ Cluster Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 57
  i note1 59
  i note2 62
  i note3 64
  i note4 66
  i note5 64
  i note6 62
  i note7 59
  i note8 57
  i note9 64
  i note10 67
  i note11 69
  i note12 66
  i note13 64
  i note14 62
