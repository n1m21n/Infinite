infinite-patch 1
# French Filter House Pumping Disco Sweep FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.28
  f decay 0.30
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float cutoff = 2200.0 [200.0, 6000.0];\nparam float resonance = 0.65 [0.0, 0.92];\nparam float pumpRate = 0.50 [0.1, 2.0];\nparam float pumpDepth = 0.65 [0.0, 1.0];\nparam float drive = 1.6 [1.0, 4.0];\nparam float mix = 0.70 [0.0, 1.0];\nstate float lfo = 0;\nstate float lp1 = 0;\nstate float lp2 = 0;\n\nlfo = (lfo + pumpRate * 0.002) % 1.0;\npump = (0.5 - 0.5 * cos(6.2831853 * lfo)) * pumpDepth;\n\nu = in * drive;\nsat = u / (1.0 + abs(u) * 0.25);\n\neffCut = clamp(cutoff * (1.0 - pump * 0.75), 150.0, 8000.0);\nfCut = clamp(effCut / sr * 3.14, 0.01, 0.45);\n\nfb = lp2 * resonance * 1.4;\nlp1 = lp1 + fCut * ((sat - fb) - lp1);\nlp2 = lp2 + fCut * (lp1 - lp2);\n\nprocessed = in * (1.0 - mix) + lp2 * mix * 1.15;\nout = processed * 0.90;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text French Filter House Pumping Disco Sweep FX. Classic French touch resonant disco lowpass sweep filter featuring rhythmic envelope ducking, warm transistor drive, and sweeping resonant cutoff modulation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
