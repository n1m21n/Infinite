infinite-patch 1
# Spectral Drone Synth: multi-timbral additive drone with Chebyshev partials
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 1.0
  i rangeLow 32
  i rangeHigh 56
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 2400.0 [100.0, 8000.0]\nparam float detune = 0.035 [0.001, 0.15]\nparam float morph = 0.45 [0.0, 1.0]\nparam float drive = 1.8 [1.0, 5.0]\nparam float warmth = 0.72 [0.0, 1.0]\nstate float p1 = 0\nstate float p2 = 0\nstate float p3 = 0\nstate float env = 0\nstate float lp = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenv = if(target > env, env + (target - env) * 0.02, env - env * 0.0003)\n\nbaseFreq = clamp(freq, 20.0, 3000.0) / sr\np1 = (p1 + baseFreq) % 1.0\np2 = (p2 + baseFreq * (1.0 + detune)) % 1.0\np3 = (p3 + baseFreq * (1.0 - detune)) % 1.0\n\ns1 = sin(6.2831853 * p1)\ns2 = sin(6.2831853 * p2)\ns3 = sin(6.2831853 * p3)\n\ncheb = 2.0 * s1 * s1 - 1.0\nraw = (s1 * 0.5 + s2 * 0.3 + s3 * 0.2) * (1.0 - morph) + cheb * morph\n\nfCut = clamp(cutoff / sr * 2.4, 0.005, 0.42)\nu = raw * drive\nsat = u / (1.0 + abs(u) * 0.3)\nlp = lp + fCut * (sat - lp)\n\nout = lp * env * (0.35 + warmth * 0.25)\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.25
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Spectral Drone Synth. Multi-timbral additive drone with Chebyshev partials and saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
