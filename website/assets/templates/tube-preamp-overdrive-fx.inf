infinite-patch 1
# Tube Preamp Overdrive FX: asymmetric triode tube saturation with grid-bias sag
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float drive = 2.5 [1.0, 8.0]\nparam float bias = 0.25 [-0.5, 0.5]\nparam float sag = 0.45 [0.0, 1.0]\nparam float tone = 0.55 [0.0, 1.0]\nparam float presence = 0.45 [0.0, 1.0]\nparam float mix = 1.0 [0.0, 1.0]\nstate float env = 0\nstate float biasDrift = 0\nstate float lpTone = 0\nstate float hpPres = 0\n\nenv = env + 0.004 * (abs(in) - env)\nbiasDrift = env * sag * 0.4\n\nu = in * drive + bias - biasDrift\nsat = u / (1.0 + abs(u) + 0.2 * (u * u))\n\nfTone = clamp((1200.0 + tone * 4800.0) / sr * 2.0, 0.01, 0.48)\nlpTone = lpTone + fTone * (sat - lpTone)\n\nfPres = clamp(2500.0 / sr * 2.0, 0.01, 0.48)\nhpPres = hpPres + fPres * (sat - hpPres)\npresSig = sat - hpPres\n\nshaped = mix(lpTone, sat + presSig * presence * 0.8, tone)\nout = in * (1.0 - mix) + shaped * mix * 0.65\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 1 0.42 0.21
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Tube Preamp Overdrive FX. Asymmetric triode tube saturation with grid sag.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
