infinite-patch 1
# Spectral Dub Chamber Pingpong Echo FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 51
  i note2 55
  i note3 58
  i note4 48
  i note5 53
  i note6 55
  i note7 60
  i note8 46
  i note9 51
  i note10 55
  i note11 58
  i note12 48
  i note13 55
  i note14 58
  i note15 62
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.24
  f decay 0.48
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float feedback = 0.60 [0.0, 0.88];\nparam float damping = 0.45 [0.05, 0.85];\nparam float wow = 0.32 [0.0, 1.0];\nparam float drive = 1.40 [0.8, 2.8];\nparam float mix = 0.60 [0.0, 1.0];\nstate float lfo = 0;\nstate float tap1 = 0;\nstate float tap2 = 0;\nstate float tap3 = 0;\nstate float lp = 0;\n\nlfo = (lfo + 0.48 / sr) % 1.0;\ndrift = 1.0 + sin(6.2831853 * lfo) * wow * 0.14;\n\nfCut = clamp(0.10 + (1.0 - damping) * 0.30, 0.03, 0.44);\nlp = lp + fCut * (in - lp);\n\nr1 = clamp(0.072 * drift, 0.02, 0.18);\nr2 = clamp(0.053 * drift, 0.02, 0.18);\nr3 = clamp(0.037 * drift, 0.02, 0.18);\n\ntap1 = tap1 + r1 * (lp + tap3 * feedback * 0.56 - tap1);\ntap2 = tap2 + r2 * (tap1 - tap2);\ntap3 = tap3 + r3 * (tap2 - tap3);\n\necho = (tap1 * 0.44 + tap2 * 0.34 + tap3 * 0.28) * drive;\nsat = echo / (1.0 + abs(echo) * 0.42);\nout = (in * (1.0 - mix) + sat * mix) * 0.88;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.52 0.36 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Spectral Dub Chamber Pingpong Echo FX. Multi-tap dub tape echo with asymmetric feedback damping, wow/flutter pitch drift, and warm oxide saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
