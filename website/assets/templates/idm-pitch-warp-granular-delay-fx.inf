infinite-patch 1
# IDM Pitch Warp Granular Delay FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3400.0
  f resonance 0.32
  f decay 0.28
  f volume 0.8
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float warpRate = 1.4 [0.2, 4.0]\nparam float delayFeedback = 0.58 [0.1, 0.88]\nparam float drive = 0.38 [0.0, 1.0]\nparam float mix = 0.65 [0.0, 1.0]\nstate float ph = 0\nstate float d1 = 0\nstate float d2 = 0\nstate float d3 = 0\nstate float lp = 0\n\nph = ph + warpRate / sr\nph = if(ph >= 1.0, ph - 1.0, ph)\nwarpMod = sin(ph * 6.2831853) * 0.08\n\nfb = clamp(delayFeedback, 0.1, 0.86)\nfCut = clamp(0.22 + warpMod * 0.05, 0.02, 0.40)\nlp = lp + fCut * (in - lp)\n\nd1 = d1 + (0.16 + warpMod) * (lp + d3 * fb - d1)\nd2 = d2 + (0.12 - warpMod) * (d1 * 0.8 + d2 * fb * 0.4 - d2)\nd3 = d3 + 0.09 * (d2 * 0.85 - d3)\n\ngran = (d1 + d2 * 0.7 - d3 * 0.5) * 1.2\nsat = clamp(gran * 1.5, -0.85, 0.85)\n\nout = in * (1.0 - mix) + sat * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.05 0.15 0.35
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text IDM Pitch Warp Granular Delay FX. Micro-modulated granular delay with pitch-warping buffer sweeps, asymmetric waveshaping distortion, and diffuse spatial feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
