infinite-patch 1
# Spring Plate Dispersion Belton Tank FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 48
  i note5 55
  i note6 52
  i note7 50
  i note8 48
  i note9 50
  i note10 55
  i note11 60
  i note12 48
  i note13 55
  i note14 52
  i note15 57
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float chirp = 0.68 [0.1, 0.9];\nparam float tension = 0.45 [0.0, 1.0];\nparam float drive = 1.55 [0.8, 3.2];\nparam float damping = 0.62 [0.15, 1.0];\nparam float mix = 0.68 [0.0, 1.0];\nstate float lfo = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float ap5 = 0;\nstate float tankFb = 0;\nstate float lp = 0;\n\nlfo = (lfo + 0.95 / sr) % 1.0;\ng = clamp(chirp + sin(6.2831853 * lfo) * 0.08 * tension, -0.88, 0.88);\n\n# 5-stage allpass spring-coil chirp dispersion with soft tank feedback\nx = in + tankFb * (0.16 + 0.14 * tension);\n\ny1 = -g * x + ap1;\nap1 = x + g * y1;\n\ny2 = -g * y1 + ap2;\nap2 = y1 + g * y2;\n\ny3 = -g * y2 + ap3;\nap3 = y2 + g * y3;\n\ny4 = -g * y3 + ap4;\nap4 = y3 + g * y4;\n\ny5 = -g * y4 + ap5;\nap5 = y4 + g * y5;\n\n# Transducer saturation & high-frequency spring damping\ndriven = y5 * (drive * 0.72);\nsat = driven / (1.0 + abs(driven) * 0.55);\nfCut = clamp(0.08 + damping * 0.34, 0.04, 0.44);\nlp = lp + fCut * (sat - lp);\ntankFb = clamp(lp, -0.85, 0.85);\n\nout = (in * (1.0 - mix) + lp * mix) * 0.68;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.26 0.16 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Spring Plate Dispersion Belton Tank FX. Triple-spring tank dispersion network with cascaded allpass chirp stages, brass transducer drive, and mechanical tank damping.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
