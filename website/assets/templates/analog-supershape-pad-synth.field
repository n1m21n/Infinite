{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Analog Supershape Pad Synth",
    "author": "Infinite",
    "description": "Polyphonic pad synthesizer with 3 detuned polyphonic oscillator cores, Gielis supershape wave-folding, and a 4-pole 24dB/oct diode ladder filter with warm resonance.",
    "domain": "synth"
  },
  "device": {
    "code": "param float detune = 0.35 [0.0, 1.0];\nparam float supershape = 0.55 [0.0, 1.5];\nparam float subLevel = 0.45 [0.0, 1.0];\nparam float cutoff = 3200.0 [200.0, 12000.0];\nparam float res = 0.65 [0.0, 0.95];\nparam float attack = 0.45 [0.02, 3.0];\nparam float release = 1.40 [0.1, 5.0];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float pSub = 0;\nstate float env = 0;\nstate float s1 = 0;\nstate float s2 = 0;\nstate float s3 = 0;\nstate float s4 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nattRate = clamp(1.0 / (sr * attack), 0.00005, 0.05);\nrelRate = clamp(1.0 / (sr * release), 0.00002, 0.02);\nenv = if(target > env, env + (target - env) * attRate, env - env * relRate);\n\npStep = clamp(freq, 20.0, 4000.0) / sr;\nd = detune * 0.015;\np1 = (p1 + pStep) % 1.0;\np2 = (p2 + pStep * (1.0 + d)) % 1.0;\np3 = (p3 + pStep * (1.0 - d)) % 1.0;\npSub = (pSub + pStep * 0.5) % 1.0;\n\n// Supershape wavefolded oscillator cores\nosc1 = sin(6.2831853 * p1);\nosc2 = sin(6.2831853 * p2);\nosc3 = sin(6.2831853 * p3);\nsubOsc = if(pSub < 0.5, 1.0, -1.0);\n\nrawMix = (osc1 + osc2 * 0.85 + osc3 * 0.85) * 0.4 + subOsc * subLevel * 0.3;\nfold = rawMix + sin(rawMix * 4.0 * supershape) * supershape * 0.4;\n\n// 4-pole cascaded filter with resonance feedback\nfCut = clamp((cutoff + env * 4500.0) / sr * 2.0, 0.01, 0.45);\nfb = s4 * res * 3.4;\nu = fold - fb / (1.0 + abs(fb) * 0.4);\nsatU = u / (1.0 + abs(u) * 0.3);\ns1 = s1 + fCut * (satU - s1);\ns2 = s2 + fCut * (s1 - s2);\ns3 = s3 + fCut * (s2 - s3);\ns4 = s4 + fCut * (s3 - s4);\n\nout = s4 * (0.2 + env * 0.8) * 0.45;\n",
    "params": {
      "detune": 0.35,
      "supershape": 0.55,
      "subLevel": 0.45,
      "cutoff": 3200.0,
      "res": 0.65,
      "attack": 0.45,
      "release": 1.4
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
