infinite-patch 1
# Barberpole Flanger FX: continuous Shepard-tone infinite flanger with quadrature phases
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float rateHz = 0.35 [-2.0, 2.0]\nparam float depth = 0.65 [0.1, 1.0]\nparam float feedback = 0.52 [-0.9, 0.9]\nparam float warmth = 0.45 [0.0, 1.0]\nparam float mix = 0.5 [0.0, 1.0]\nstate float phase1 = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float s4 = 0\nstate float fb = 0\nstate float lp = 0\n\nphase1 = (phase1 + rateHz / sr) % 1.0\nphase1 = if(phase1 < 0.0, phase1 + 1.0, phase1)\n\np1 = phase1\np2 = (p1 + 0.25) % 1.0\np3 = (p1 + 0.50) % 1.0\np4 = (p1 + 0.75) % 1.0\n\nw1 = sin(3.14159265 * p1) * sin(3.14159265 * p1)\nw2 = sin(3.14159265 * p2) * sin(3.14159265 * p2)\nw3 = sin(3.14159265 * p3) * sin(3.14159265 * p3)\nw4 = sin(3.14159265 * p4) * sin(3.14159265 * p4)\n\nsatIn = tanh((in + fb * feedback) * (1.0 + warmth * 0.4))\n\nrate1 = clamp((1.0 - p1 * depth) * 0.15, 0.005, 0.3)\nrate2 = clamp((1.0 - p2 * depth) * 0.15, 0.005, 0.3)\nrate3 = clamp((1.0 - p3 * depth) * 0.15, 0.005, 0.3)\nrate4 = clamp((1.0 - p4 * depth) * 0.15, 0.005, 0.3)\n\ns1 = s1 + (satIn - s1) * rate1\ns2 = s2 + (satIn - s2) * rate2\ns3 = s3 + (satIn - s3) * rate3\ns4 = s4 + (satIn - s4) * rate4\n\nflanged = (s1 * w1 + s2 * w2 + s3 * w3 + s4 * w4) / (w1 + w2 + w3 + w4 + 0.0001)\nfb = flanged\n\nlp = lp + clamp(6000.0 / sr * 2.0 * (1.0 - warmth * 0.3), 0.02, 0.48) * (flanged - lp)\nout = in * (1.0 - mix) + lp * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Barberpole Flanger FX. Continuous Shepard-tone infinite flanger with quadrature phases.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
