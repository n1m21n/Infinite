infinite-patch 1
# Nagra Tape Flutter Loop FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 51
  i note2 55
  i note3 58
  i note4 55
  i note5 51
  i note6 50
  i note7 53
  i note8 48
  i note9 55
  i note10 58
  i note11 60
  i note12 58
  i note13 55
  i note14 51
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float wowHz = 0.45 [0.1, 2.0];\nparam float flutterHz = 5.8 [2.0, 12.0];\nparam float oxideHz = 2400.0 [600.0, 6000.0];\nparam float drive = 1.75 [0.8, 3.5];\nparam float mix = 0.82 [0.0, 1.0];\nstate float pWow = 0; state float pFlu = 0;\nstate float ap1 = 0; state float ap2 = 0;\nstate float lp1 = 0; state float lp2 = 0; state float fb = 0;\n\npWow = (pWow + wowHz / sr) % 1.0;\npFlu = (pFlu + flutterHz / sr) % 1.0;\nmodC = clamp(0.45 + 0.22 * sin(6.2831853 * pWow) + 0.10 * sin(6.2831853 * pFlu), 0.1, 0.88);\n\nx = in + fb * 0.36;\n# Hysteresis soft-clipping\nsat = (x * drive) / (1.0 + abs(x * drive) * 0.68);\n\n# Capstan phase-drift allpass pair\ny1 = -modC * sat + ap1; ap1 = sat + modC * y1;\ny2 = -modC * y1 + ap2; ap2 = y1 + modC * y2;\n\n# Oxide high-frequency rolloff\ng = clamp(2.0 * sin(3.14159265 * oxideHz / sr), 0.04, 0.85);\nlp1 = lp1 + g * (y2 - lp1);\nlp2 = lp2 + g * (lp1 - lp2);\nfb = clamp(lp2, -1.0, 1.0);\n\nout = (in * (1.0 - mix) + lp2 * mix) * 0.52;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Nagra Tape Flutter Loop FX. Reel-to-reel Nagra tape hysteresis saturator with dual-LFO capstan wow and flutter, oxide high-frequency rolloff, and resonant tape feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
