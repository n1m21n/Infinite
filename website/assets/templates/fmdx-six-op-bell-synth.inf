infinite-patch 1
# FMDX Six-Op Bell Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 60
  i note1 67
  i note2 72
  i note3 64
  i note4 62
  i note5 69
  i note6 74
  i note7 67
  i note8 60
  i note9 67
  i note10 76
  i note11 72
  i note12 65
  i note13 69
  i note14 72
  i note15 64
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
