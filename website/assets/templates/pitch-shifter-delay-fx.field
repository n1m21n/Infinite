{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Pitch Shifter Delay FX",
    "author": "Infinite",
    "description": "Continuous granular pitch-shifting delay with dual rotating crossfading heads, feedback shimmer and tape flutter.",
    "domain": "sample"
  },
  "device": {
    "code": "param float shift = 0.5 [-1.0, 1.0];\nparam float feedback = 0.45 [0.0, 0.95];\nparam float window = 0.05 [0.02, 0.15];\nparam float flutter = 0.25 [0.0, 1.0];\nparam float mix = 0.75 [0.0, 1.0];\nstate float p1 = 0;\nstate float lfo = 0;\nstate float d1 = 0;\nstate float d2 = 0;\nstate float fb = 0;\n\nlfo = (lfo + 0.35 / sr) % 1.0;\nfl = sin(6.2831853 * lfo) * flutter * 0.005;\n\nrate = (shift + fl) / (window * sr);\np1 = (p1 + rate) % 1.0;\np2 = (p1 + 0.5) % 1.0;\n\nw1 = 1.0 - abs(2.0 * p1 - 1.0);\nw2 = 1.0 - abs(2.0 * p2 - 1.0);\n\nx = in + fb * feedback;\nu = x / (1.0 + abs(x) * 0.1);\n\nd1 = d1 + 0.25 * (u * p1 - d1);\nd2 = d2 + 0.25 * (u * p2 - d2);\n\nwet = d1 * w1 + d2 * w2;\nfb = wet;\n\nout = in * (1.0 - mix) + wet * mix;\n",
    "params": {
      "shift": 0.5,
      "feedback": 0.45,
      "window": 0.05,
      "flutter": 0.25,
      "mix": 0.75
    },
    "nodeSettings": {}
  }
}
