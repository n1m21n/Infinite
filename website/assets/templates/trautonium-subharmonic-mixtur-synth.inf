node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float subMix = 0.62 [0.0, 1.0];\nparam float formantHz = 680.0 [220.0, 2200.0];\nparam float resonance = 0.65 [0.1, 0.92];\nparam float drive = 1.45 [0.8, 2.8];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float env = 0;\nstate float bp1 = 0;\nstate float lp1 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv = if(target > env, env + (target - env) * 0.09, env * 0.9986);\n\nf0 = clamp(freq, 48.0, 2200.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 0.5) / sr) % 1.0;\np3 = (p3 + (f0 * 0.333333) / sr) % 1.0;\n\n# Sawtooth fundamental + integer subharmonic mixture (f/2, f/3)\nraw = (1.0 - 2.0 * p1) * 0.48 + ((1.0 - 2.0 * p2) * 0.36 + (1.0 - 2.0 * p3) * 0.28) * subMix;\n\n# Resonant SVF formant filter\nq = clamp(1.05 - resonance, 0.08, 0.85);\ng1 = clamp(2.0 * sin(3.14159265 * clamp(formantHz, 120.0, sr * 0.35) / sr), 0.01, 0.85);\nbp1 = bp1 + g1 * (raw - lp1 - q * bp1);\nlp1 = lp1 + g1 * bp1;\n\ndriven = (raw * 0.28 + bp1 * 0.72) * drive;\nsat = driven / (1.0 + abs(driven) * 0.52);\nout = sat * env * 0.58;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.24 0.34
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Trautonium Subharmonic Mixtur Synth. Oskar Sala Mixtur-Trautonium integer subharmonic divider synth with dual resonant formant filters and triode saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
