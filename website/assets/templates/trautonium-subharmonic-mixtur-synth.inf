infinite-patch 1
# Trautonium Subharmonic Mixtur Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 57
  i note2 53
  i note3 62
  i note4 50
  i note5 55
  i note6 58
  i note7 57
  i note8 50
  i note9 52
  i note10 53
  i note11 57
  i note12 50
  i note13 62
  i note14 60
  i note15 55
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
