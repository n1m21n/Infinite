infinite-patch 1
# Magnetic Wire Hysteresis FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 43
  i note1 45
  i note2 50
  i note3 52
  i note4 43
  i note5 50
  i note6 47
  i note7 45
  i note8 43
  i note9 45
  i note10 50
  i note11 55
  i note12 43
  i note13 50
  i note14 47
  i note15 52
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float biasDrive = 1.85 [0.8, 3.6];\nparam float flutter = 0.38 [0.0, 1.0];\nparam float coilTone = 0.55 [0.15, 1.0];\nparam float mix = 0.82 [0.0, 1.0];\nstate float lfo1 = 0;\nstate float lfo2 = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float hpState = 0;\nstate float lpState = 0;\nstate float hyst = 0;\n\nlfo1 = (lfo1 + 1.35 / sr) % 1.0;\nlfo2 = (lfo2 + 5.70 / sr) % 1.0;\n\n# Capstan wow & flutter phase dispersion\nwobble = sin(6.2831853 * lfo1) * 0.65 + sin(6.2831853 * lfo2) * 0.35;\ng = clamp(0.32 + wobble * 0.28 * flutter, -0.82, 0.82);\ny1 = -g * in + ap1; ap1 = in + g * y1;\ny2 = -g * y1 + ap2; ap2 = y1 + g * y2;\n\n# Asymmetric magnetic steel-wire hysteresis curve\npre = y2 * biasDrive + 0.08 * biasDrive;\nhyst = hyst * 0.35 + pre * 0.65;\nsat = (hyst / (1.0 + abs(hyst) * 0.68)) - 0.055 * biasDrive;\n\n# Telephone-coil highpass + warm iron-core lowpass\nhpState = hpState + 0.012 * (sat - hpState);\nmidBand = sat - hpState;\nfCut = clamp(0.06 + coilTone * 0.36, 0.04, 0.45);\nlpState = lpState + fCut * (midBand - lpState);\n\nampFlutter = 1.0 - 0.08 * flutter * (0.5 + 0.5 * wobble);\nwet = lpState * ampFlutter;\nout = (in * (1.0 - mix) + wet * mix) * 0.78;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.20 0.28
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Magnetic Wire Hysteresis FX. 1940s Peirce steel-wire magnetic recorder processor with asymmetric hysteresis saturation, capstan flutter, and coil bandpass.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
