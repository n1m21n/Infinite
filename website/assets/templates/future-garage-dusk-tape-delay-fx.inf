infinite-patch 1
# Future Garage Dusk Tape Delay FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float time = 0.35 [0.05, 0.8]\nparam float flutter = 0.35 [0.0, 1.0]\nparam float feedback = 0.45 [0.0, 0.85]\nparam float damping = 0.50 [0.1, 1.0]\nparam float mix = 0.50 [0.0, 1.0]\nstate float pLfo1 = 0\nstate float pLfo2 = 0\nstate float tap1 = 0\nstate float tap2 = 0\nstate float tap3 = 0\nstate float lp = 0\n\ndp1 = 1.2 / sr\npLfo1 = pLfo1 + dp1\npLfo1 = if(pLfo1 >= 1.0, pLfo1 - 1.0, pLfo1)\nlfo1 = sin(pLfo1 * 6.2831853)\n\ndp2 = 0.35 / sr\npLfo2 = pLfo2 + dp2\npLfo2 = if(pLfo2 >= 1.0, pLfo2 - 1.0, pLfo2)\nlfo2 = sin(pLfo2 * 6.2831853)\n\nfCut = clamp(0.15 + (1.0 - damping) * 0.25, 0.02, 0.45)\nlp = lp + fCut * (in - lp)\n\nmodRate = clamp(0.08 + flutter * 0.03 * (lfo1 + lfo2 * 0.5), 0.02, 0.35)\ntap1 = tap1 + modRate * (lp + tap3 * feedback * 0.45 - tap1)\ntap2 = tap2 + modRate * 0.88 * (tap1 - tap2)\ntap3 = tap3 + modRate * 0.76 * (tap2 - tap3)\n\ndelayed = (tap2 + tap3) * 0.85\nsat = (delayed / (1.0 + abs(delayed * 0.4)))\n\nprocessed = in * (1.0 - mix) + sat * mix\nout = processed * 1.55\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Future Garage Dusk Tape Delay FX. Nocturnal UK future garage tape delay effect featuring dual stereo delay taps, subtle wow and flutter pitch modulation, warm feedback saturation, and gentle high-frequency tape damping.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
