infinite-patch 1
# Breakbeat Transient Saturation Drive FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.28
  f decay 0.30
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float drive = 2.4 [1.0, 6.0];\nparam float punch = 0.65 [0.0, 1.0];\nparam float warmth = 0.55 [0.0, 1.0];\nparam float mix = 0.75 [0.0, 1.0];\nstate float env = 0;\nstate float lp = 0;\n\nsigIn = in;\ninAbs = abs(sigIn);\nenv = if(inAbs > env, env + (inAbs - env) * 0.25, env - env * 0.005);\n\ngain = 1.0 + env * punch * 2.0;\nboosted = sigIn * gain * drive;\n\nsat = boosted / (1.0 + abs(boosted) * 0.35);\n\nfWarm = clamp(1800.0 / sr * 3.14, 0.01, 0.45);\nlp = lp + fWarm * (sat - lp);\nshaped = sat * (1.0 - warmth * 0.4) + lp * (warmth * 0.4);\n\nprocessed = sigIn * (1.0 - mix) + shaped * mix * 0.85;\nout = processed * 0.88;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Breakbeat Transient Saturation Drive FX. Dynamic breakbeat drum bus saturator featuring punchy transient envelope detection, analog diode clipping, and low-end warmth emphasis.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
