infinite-patch 1
# Trautonium Subharmonic Organ Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 52
  i note1 55
  i note2 57
  i note3 59
  i note4 62
  i note5 59
  i note6 57
  i note7 55
  i note8 52
  i note9 59
  i note10 62
  i note11 64
  i note12 62
  i note13 59
  i note14 57
