infinite-patch 1
# Resonant Vowel Formant FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 55
  i note5 50
  i note6 48
  i note7 52
  i note8 48
  i note9 55
  i note10 57
  i note11 60
  i note12 57
  i note13 55
  i note14 52
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float vowelRate = 0.35 [0.05, 3.5];\nparam float vowelSpan = 0.82 [0.1, 1.0];\nparam float resonance = 0.24 [0.08, 0.65];\nparam float drive = 1.45 [0.6, 2.8];\nparam float mix = 0.82 [0.0, 1.0];\nstate float lfo = 0;\nstate float b1 = 0; state float l1 = 0;\nstate float b2 = 0; state float l2 = 0;\nstate float b3 = 0; state float l3 = 0;\n\nlfo = (lfo + vowelRate / sr) % 1.0;\nv = 0.5 + 0.5 * sin(6.2831853 * lfo) * vowelSpan;\n\nf1Hz = 310.0 + v * 460.0;\nf2Hz = 840.0 + (1.0 - v) * 1380.0;\nf3Hz = 2350.0 + v * 580.0;\n\ng1 = clamp(2.0 * sin(3.14159265 * f1Hz / sr), 0.02, 0.85);\ng2 = clamp(2.0 * sin(3.14159265 * f2Hz / sr), 0.02, 0.85);\ng3 = clamp(2.0 * sin(3.14159265 * f3Hz / sr), 0.02, 0.85);\n\nsat = (in * drive) / (1.0 + abs(in * drive) * 0.65);\n\nh1 = sat - l1 - resonance * b1; b1 = b1 + g1 * h1; l1 = l1 + g1 * b1;\nh2 = sat - l2 - resonance * b2; b2 = b2 + g2 * h2; l2 = l2 + g2 * b2;\nh3 = sat - l3 - resonance * b3; b3 = b3 + g3 * h3; l3 = l3 + g3 * b3;\n\nformant = (b1 * 0.58 + b2 * 0.42 + b3 * 0.24);\nout = (in * (1.0 - mix) + formant * mix) * 0.65;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Resonant Vowel Formant FX. Three-band parallel state-variable formant filter bank that morphs between A-E-I-O-U vocal resonances with LFO sweep and warm tube saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
