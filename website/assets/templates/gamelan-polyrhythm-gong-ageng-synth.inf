infinite-patch 1
# Gamelan Polyrhythm Gong Ageng Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 1.0
  i steps 8
  i note0 38
  i note1 45
  i note2 43
  i note3 38
  i note4 41
  i note5 45
  i note6 43
  i note7 40
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float sag = 0.08 [0.0, 0.25];\nparam float shimmer = 0.65 [0.1, 1.0];\nparam float ombakRate = 1.4 [0.2, 4.5];\nparam float tail = 0.75 [0.2, 1.0];\nstate float pSub = 0;\nstate float p1 = 0;\nstate float p2 = 0;\nstate float lfo = 0;\nstate float env = 0;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecRate = clamp(1.0 / (sr * (0.45 + tail * 2.2)), 0.00008, 0.015);\nenv = if(target > env, env + (target - env) * 0.16, env - env * decRate);\n\nlfo = (lfo + ombakRate / sr) % 1.0;\nf0 = clamp(freq * (1.0 - sag * (1.0 - env)), 36.0, 1200.0);\npSub = (pSub + (f0 * 0.5) / sr) % 1.0;\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 1.62) / sr) % 1.0;\n\ngong = sin(6.2831853 * pSub) * 0.45 + sin(6.2831853 * p1) * 0.42 + sin(6.2831853 * p2 + sin(6.2831853 * p1) * shimmer * 0.5) * 0.28;\nlp = lp + clamp(0.03 + env * 0.28, 0.02, 0.36) * (gong - lp);\n\nout = ((lp * 1.45) / (1.0 + abs(lp * 1.45) * 0.48)) * env * (0.78 + 0.22 * sin(6.2831853 * lfo)) * 0.65;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
