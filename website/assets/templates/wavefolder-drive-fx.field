{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Wavefolder Drive FX",
    "author": "Infinite",
    "description": "West Coast multi-stage analog wavefolder with continuous folding thresholds, DC symmetry bias, tone filter and warm saturator.",
    "domain": "sample"
  },
  "device": {
    "code": "param float drive = 2.8 [1.0, 8.0];\nparam float folds = 2.4 [1.0, 5.0];\nparam float symmetry = 0.5 [0.0, 1.0];\nparam float tone = 8500.0 [800.0, 18000.0];\nparam float mix = 0.75 [0.0, 1.0];\nstate float lp = 0;\n\nbias = (symmetry - 0.5) * 1.2;\nu = in * drive + bias;\n\nfold1 = sin(u * 1.5707963);\nfold2 = sin(fold1 * 2.3561945 + u * 0.785398);\nfold3 = sin(fold2 * 3.1415926 + fold1 * 0.5);\n\nfracFold = clamp(folds - 1.0, 0.0, 3.0);\nm1 = clamp(fracFold, 0.0, 1.0);\ns1 = fold1 * (1.0 - m1) + fold2 * m1;\nm2 = clamp(fracFold - 1.0, 0.0, 1.0);\nfolded = s1 * (1.0 - m2) + fold3 * m2;\n\nsat = folded / (1.0 + abs(folded) * 0.18);\n\nfCut = clamp(6.2831853 * tone / sr, 0.02, 0.85);\nlp = lp + fCut * (sat - lp);\n\nout = in * (1.0 - mix) + lp * mix;\n",
    "params": {
      "drive": 2.8,
      "folds": 2.4,
      "symmetry": 0.5,
      "tone": 8500.0,
      "mix": 0.75
    },
    "nodeSettings": {}
  }
}
