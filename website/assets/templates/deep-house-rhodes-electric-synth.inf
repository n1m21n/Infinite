infinite-patch 1
# Deep House Rhodes Electric Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 48
  i note4 51
  i note5 48
  i note6 55
  i note7 58
  i note8 48
  i note9 48
  i note10 60
  i note11 48
  i note12 51
  i note13 53
  i note14 55
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
