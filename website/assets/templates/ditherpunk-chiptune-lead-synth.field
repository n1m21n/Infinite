{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Ditherpunk Chiptune Lead Synth",
    "author": "Infinite",
    "description": "Lo-fi 8-bit chiptune synthesizer with variable pulse-width duty cycle modulation, bit-crush quantization decimation, and snappily accented pitch decay.",
    "domain": "synth"
  },
  "device": {
    "code": "param float pulseWidth = 0.35 [0.05, 0.95];\nparam float crushBits = 4.0 [2.0, 16.0];\nparam float glide = 0.25 [0.0, 1.0];\nparam float decay = 0.65 [0.1, 2.0];\nparam float accent = 0.55 [0.0, 1.0];\nstate float phase = 0;\nstate float env = 0;\nstate float curFreq = 220;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv = if(target > env, env + (target - env) * 0.06, env - env * (0.0005 / decay));\n\ncurFreq = curFreq + (freq - curFreq) * (0.05 / (1.0 + glide * 4.0));\nstepFreq = clamp(curFreq, 40.0, 5000.0) / sr;\nphase = (phase + stepFreq) % 1.0;\n\npwMod = pulseWidth + sin(phase * 6.2831853) * 0.1 * accent;\npulse = if(phase > pwMod, 0.8, -0.8);\nsub = if(phase > 0.5, 0.4, -0.4);\n\nrawSig = pulse * 0.75 + sub * 0.25;\nlevels = pow(2.0, clamp(crushBits, 2.0, 16.0));\ncrushed = floor(rawSig * levels + 0.5) / levels;\n\nout = crushed * env * (0.85 + accent * 0.35);\n",
    "params": {
      "pulseWidth": 0.35,
      "crushBits": 4.0,
      "glide": 0.25,
      "decay": 0.65,
      "accent": 0.55
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
