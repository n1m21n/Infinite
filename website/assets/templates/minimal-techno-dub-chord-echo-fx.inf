infinite-patch 1
# Minimal Techno Dub Chord Echo FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.28
  f decay 0.30
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float feedback = 0.62 [0.0, 0.88];\nparam float damping = 0.55 [0.1, 0.95];\nparam float drift = 0.25 [0.0, 1.0];\nparam float mix = 0.52 [0.0, 1.0];\nstate float tap1 = 0;\nstate float tap2 = 0;\nstate float tap3 = 0;\nstate float tap4 = 0;\nstate float lp = 0;\nstate float lfo = 0;\n\nlfo = (lfo + 1.1 / sr) % 1.0;\nmodRate = sin(6.2831853 * lfo) * drift * 0.015;\n\nfCut = clamp(0.08 + (1.0 - damping) * 0.26, 0.02, 0.40);\nlp = lp + fCut * (in - lp);\n\nr = clamp(0.075 + modRate, 0.02, 0.30);\ntap1 = tap1 + r * (lp + tap4 * feedback * 0.45 - tap1);\ntap2 = tap2 + r * 0.84 * (tap1 - tap2);\ntap3 = tap3 + r * 0.72 * (tap2 - tap3);\ntap4 = tap4 + r * 0.61 * (tap3 - tap4);\n\necho = (tap2 * 0.42 + tap3 * 0.34 + tap4 * 0.24) * 1.15;\nsat = echo / (1.0 + abs(echo) * 0.28);\n\nprocessed = in * (1.0 - mix) + sat * mix;\nout = processed * 1.45;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Minimal Techno Dub Chord Echo FX. Basic Channel-inspired damped stereo dub delay network with dark feedback filtering and subtle tape pitch drift.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
