infinite-patch 1
# Resonant Comb Matrix FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 52
  i note2 55
  i note3 59
  i note4 60
  i note5 59
  i note6 55
  i note7 52
  i note8 48
  i note9 55
  i note10 59
  i note11 64
  i note12 59
  i note13 55
  i note14 52
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id src
  pos 340 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 680 1024
  s code param float res = 0.66 [0.15, 0.86];\nparam float driftHz = 0.42 [0.05, 2.5];\nparam float dampHz = 3100.0 [700.0, 7500.0];\nparam float feedback = 0.58 [0.0, 0.82];\nparam float mix = 0.62 [0.0, 1.0];\nstate float lfo = 0; state float fb = 0; state float lp1 = 0;\nstate float ap1 = 0; state float ap2 = 0; state float ap3 = 0; state float ap4 = 0;\n\nlfo = (lfo + driftHz / sr) % 1.0;\nmod = 0.08 * sin(6.2831853 * lfo);\nsrc = in + fb * feedback;\n\nk1 = clamp(res + mod, 0.1, 0.89);\nk2 = clamp(res * 0.87 - mod, 0.1, 0.89);\nk3 = clamp(res * 0.73 + mod * 0.6, 0.1, 0.89);\nk4 = clamp(res * 0.59 - mod * 0.6, 0.1, 0.89);\n\ny1 = -k1 * src + ap1; ap1 = src + k1 * y1;\ny2 = -k2 * y1 + ap2; ap2 = y1 + k2 * y2;\ny3 = -k3 * y2 + ap3; ap3 = y2 + k3 * y3;\ny4 = -k4 * y3 + ap4; ap4 = y3 + k4 * y4;\n\ng = clamp(2.0 * sin(3.14159265 * dampHz / sr), 0.04, 0.85);\nlp1 = lp1 + g * (y4 - lp1);\n\ndrv = lp1 * 1.35;\nsat = drv / (1.0 + abs(drv));\nfb = sat;\n\nout = (in * (1.0 - mix) + sat * mix) * 0.52;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1040 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Resonant Comb Matrix FX. Four-stage staggered allpass-comb dispersion matrix with prime-ratio damping, slow LFO detune drift, and soft-clipping feedback limiter.
  f width 340
  f height 120
end
note src 0 notes
aud fx 0 src
aud speakers 0 fx
cable out 0 pic
