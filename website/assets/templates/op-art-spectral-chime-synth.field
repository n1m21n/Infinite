{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Op Art Spectral Chime Synth",
    "author": "Infinite",
    "description": "Multi-partial inharmonic additive chime and bell synthesizer with kinetic beating moire modulations, metallic partial ratios, and shimmering exponential modal decays.",
    "domain": "synth"
  },
  "device": {
    "code": "param float brightness = 0.7 [0.1, 1.0];\nparam float inharmonicity = 0.45 [0.0, 1.0];\nparam float moireBeating = 4.5 [0.5, 12.0];\nparam float chimeDecay = 1.4 [0.2, 4.0];\nparam float resonance = 0.78 [0.1, 0.98];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float p4 = 0;\nstate float env1 = 0;\nstate float env2 = 0;\nstate float env3 = 0;\nstate float env4 = 0;\nstate float beatPhase = 0;\nstate float curFreq = 440;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv1 = if(target > env1, env1 + (target - env1) * 0.12, env1 - env1 * (0.0002 / chimeDecay));\nenv2 = if(target > env2, env2 + (target - env2) * 0.14, env2 - env2 * (0.00035 / chimeDecay));\nenv3 = if(target > env3, env3 + (target - env3) * 0.16, env3 - env3 * (0.0006 / chimeDecay));\nenv4 = if(target > env4, env4 + (target - env4) * 0.18, env4 - env4 * (0.0011 / chimeDecay));\n\ncurFreq = curFreq + (freq - curFreq) * 0.05;\nf0 = clamp(curFreq, 60.0, 4000.0);\n\nbeatPhase = (beatPhase + moireBeating / sr) % 1.0;\nbeatMod = sin(beatPhase * 6.2831853) * 0.35 + 0.65;\n\nr1 = 1.0;\nr2 = 2.0 + inharmonicity * 0.76;\nr3 = 3.0 + inharmonicity * 2.4;\nr4 = 4.0 + inharmonicity * 4.9;\n\np1 = (p1 + (f0 * r1) / sr) % 1.0;\np2 = (p2 + (f0 * r2) / sr) % 1.0;\np3 = (p3 + (f0 * r3) / sr) % 1.0;\np4 = (p4 + (f0 * r4) / sr) % 1.0;\n\ns1 = sin(p1 * 6.2831853) * env1;\ns2 = sin(p2 * 6.2831853) * env2 * (0.6 * brightness) * beatMod;\ns3 = sin(p3 * 6.2831853) * env3 * (0.35 * brightness);\ns4 = sin(p4 * 6.2831853) * env4 * (0.2 * brightness * brightness);\n\nmixSig = s1 + s2 + s3 + s4;\nshimmer = tanh(mixSig * (1.0 + resonance * 1.5));\nout = shimmer * 0.95;\n",
    "params": {
      "brightness": 0.7,
      "inharmonicity": 0.45,
      "moireBeating": 4.5,
      "chimeDecay": 1.4,
      "resonance": 0.78
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
