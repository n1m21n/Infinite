infinite-patch 1
# Liquid DnB Rhodes Glide Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 62
  i note1 62
  i note2 65
  i note3 65
  i note4 69
  i note5 69
  i note6 67
  i note7 67
  i note8 62
  i note9 62
  i note10 65
  i note11 65
  i note12 70
  i note13 70
  i note14 69
  i note15 67
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
