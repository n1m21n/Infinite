infinite-patch 1
# Koto Glass Harmonic Marimba Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 60
  i note1 67
  i note2 72
  i note3 64
  i note4 67
  i note5 71
  i note6 76
  i note7 67
  i note8 60
  i note9 65
  i note10 69
  i note11 72
  i note12 64
  i note13 67
  i note14 74
  i note15 71
  b en0 1
  b en1 1
  b en2 1
