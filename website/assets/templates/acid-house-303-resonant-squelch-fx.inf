infinite-patch 1
# Acid House 303 Resonant Squelch FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 41
  i note1 41
  i note2 53
  i note3 48
  i note4 41
  i note5 53
  i note6 46
  i note7 48
  i note8 41
  i note9 41
  i note10 53
  i note11 48
  i note12 41
  i note13 53
  i note14 46
  i note15 51
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2800.0
  f resonance 0.25
  f decay 0.35
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float cutoff = 0.24 [0.04, 0.55];\nparam float resonance = 0.68 [0.0, 0.88];\nparam float sweepRate = 0.65 [0.1, 4.0];\nparam float drive = 1.6 [1.0, 3.5];\nparam float mix = 0.78 [0.0, 1.0];\nstate float lfo = 0;\nstate float lp1 = 0;\nstate float lp2 = 0;\n\nlfo = (lfo + sweepRate / sr) % 1.0;\nmodCut = clamp(cutoff + sin(6.2831853 * lfo) * 0.14, 0.03, 0.52);\n\nfb = clamp(resonance * 0.82, 0.0, 0.78);\nsig = in - lp2 * fb;\nsatIn = (sig * drive) / (1.0 + abs(sig * drive) * 0.45);\n\nlp1 = lp1 + modCut * (satIn - lp1);\nlp2 = lp2 + modCut * (lp1 - lp2);\n\nprocessed = in * (1.0 - mix) + lp2 * mix;\nout = processed * 0.92;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.26 0.16 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House 303 Resonant Squelch FX. Resonant 2-pole diode-style lowpass filter with LFO cutoff sweep and acid overdrive saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
