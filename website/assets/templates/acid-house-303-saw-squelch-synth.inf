infinite-patch 1
# Acid House 303 Saw Squelch Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 36
  i note1 36
  i note2 48
  i note3 39
  i note4 36
  i note5 41
  i note6 43
  i note7 46
  i note8 36
  i note9 36
  i note10 48
  i note11 51
  i note12 39
  i note13 41
  i note14 43
  i note15 46
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 0.55 [0.1, 1.0]\nparam float resonance = 0.75 [0.1, 0.95]\nparam float envMod = 0.65 [0.0, 1.0]\nparam float decayTime = 0.32 [0.08, 0.9]\nparam float drive = 0.45 [0.0, 1.0]\nstate float phase = 0\nstate float env = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float s4 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decayTime), 0.0001, 0.06)\nenv = if(target > env, env + (target - env) * 0.94, env - env * decayRate)\n\ndp = freq / sr\nphase = phase + dp\nphase = if(phase >= 1.0, phase - 1.0, phase)\nsaw = phase * 2.0 - 1.0\n\nfNorm = clamp(cutoff * 0.18 + env * envMod * 0.32, 0.015, 0.46)\nkRes = clamp(resonance * 3.8, 0.2, 3.85)\n\nfb = s4 * kRes\ninSig = saw * (1.0 + drive * 1.8) - fb\ns1 = s1 + fNorm * (inSig - s1)\ns2 = s2 + fNorm * (s1 - s2)\ns3 = s3 + fNorm * (s2 - s3)\ns4 = s4 + fNorm * (s3 - s4)\n\nsat = (s4 / (1.0 + abs(s4 * 0.6))) * env\nout = sat * 0.44\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.18 0.22 0.32
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House 303 Saw Squelch Synth. Authentic Chicago acid house bassline synthesizer featuring a band-limited sawtooth oscillator, cascading 4-pole diode ladder filter with screaming 18dB resonance, punchy accent decay, and tanh drive.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
