infinite-patch 1
# Deep House Warm Analog Chorus FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.28
  f decay 0.30
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rate = 0.35 [0.05, 1.0];\nparam float depth = 0.55 [0.05, 0.95];\nparam float feedback = 0.38 [0.0, 0.85];\nparam float warmth = 0.65 [0.1, 1.0];\nparam float mix = 0.50 [0.0, 1.0];\nstate float lfo1 = 0;\nstate float lfo2 = 0;\nstate float d1 = 0;\nstate float d2 = 0;\nstate float lp = 0;\nstate float fb = 0;\n\nlfo1 = (lfo1 + rate * 0.0018) % 1.0;\nlfo2 = (lfo2 + rate * 0.0023 + 0.25) % 1.0;\nsin1 = sin(6.2831853 * lfo1) * depth * 0.032;\nsin2 = cos(6.2831853 * lfo2) * depth * 0.028;\n\nkRate1 = clamp(0.08 + sin1, 0.02, 0.35);\nkRate2 = clamp(0.09 + sin2, 0.02, 0.35);\n\nd1 = d1 + kRate1 * ((in + fb * feedback) - d1);\nd2 = d2 + kRate2 * (d1 - d2);\n\nfWarm = clamp(0.15 + (1.0 - warmth) * 0.25, 0.05, 0.45);\nlp = lp + fWarm * (d2 - lp);\n\nsat = lp / (1.0 + abs(lp * 0.25));\nfb = sat;\n\nchorus = (d1 * 0.6 + d2 * 0.4) * 1.15;\nprocessed = in * (1.0 - mix) + chorus * mix;\nout = processed * 0.92;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Deep House Warm Analog Chorus FX. Lush multi-stage analog bucket-brigade chorus and spatial widening effect engineered for deep house electric pianos, synths, and basslines with warm vintage saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
