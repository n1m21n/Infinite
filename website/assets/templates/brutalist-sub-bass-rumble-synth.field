{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Brutalist Sub-Bass Rumble Synth",
    "author": "Infinite",
    "description": "Heavy monolithic sub-bass generator with dual sub-octave dividers, warm even harmonic wave folding, and seismic low-frequency pressure envelope.",
    "domain": "synth"
  },
  "device": {
    "code": "param float subMix = 0.65 [0.0, 1.0];\nparam float foldDrive = 2.4 [1.0, 6.0];\nparam float glide = 0.35 [0.0, 1.0];\nparam float decay = 1.2 [0.2, 3.0];\nparam float bodyTone = 0.45 [0.0, 1.0];\nstate float phase = 0;\nstate float subPhase1 = 0;\nstate float subPhase2 = 0;\nstate float env = 0;\nstate float curFreq = 110;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv = if(target > env, env + (target - env) * 0.05, env - env * (0.0003 / decay));\n\ncurFreq = curFreq + (freq - curFreq) * (0.03 / (1.0 + glide * 3.0));\nstepFreq = clamp(curFreq, 20.0, 500.0) / sr;\nphase = (phase + stepFreq) % 1.0;\nsubPhase1 = (subPhase1 + stepFreq * 0.5) % 1.0;\nsubPhase2 = (subPhase2 + stepFreq * 0.25) % 1.0;\n\nsinCore = sin(phase * 6.2831853);\nsub1 = sin(subPhase1 * 6.2831853);\nsub2 = if(subPhase2 > 0.5, 0.7, -0.7);\n\nraw = sinCore * (1.0 - subMix * 0.5) + sub1 * (subMix * 0.7) + sub2 * (subMix * 0.4);\nfolded = sin(raw * foldDrive);\n\ncut = clamp(0.08 + bodyTone * 0.22, 0.02, 0.4);\nlp = lp + cut * (folded - lp);\n\nout = lp * env * 1.2;\n",
    "params": {
      "subMix": 0.65,
      "foldDrive": 2.4,
      "glide": 0.35,
      "decay": 1.2,
      "bodyTone": 0.45
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
