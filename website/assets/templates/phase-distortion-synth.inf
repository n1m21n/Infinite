infinite-patch 1
# Phase Distortion Synth: Casio CZ resonant windowing Field Synth
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float resonance = 3.2 [0.5, 8.0]\nparam float envDepth = 4.5 [0.0, 10.0]\nparam float decay = 1.8 [0.1, 6.0]\nparam float subLevel = 0.35 [0.0, 1.0]\nparam float drive = 1.4 [1.0, 3.5]\nstate float phase = 0\nstate float subPhase = 0\nstate float ampEnv = 0\nstate float filtEnv = 0\nstate float lp = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nampDecayRate = clamp(1.0 / (sr * decay), 0.00002, 0.02)\nfiltDecayRate = clamp(1.0 / (sr * (decay * 0.65)), 0.00003, 0.03)\nampEnv = if(target > ampEnv, ampEnv + (target - ampEnv) * 0.18, ampEnv - ampEnv * ampDecayRate)\nfiltEnv = if(target > filtEnv, filtEnv + (target - filtEnv) * 0.22, filtEnv - filtEnv * filtDecayRate)\n\nf0 = clamp(freq, 20.0, 5000.0)\nstep = f0 / sr\nphase = (phase + step) % 1.0\nsubPhase = (subPhase + step * 0.5) % 1.0\n\nresMult = 1.0 + resonance + filtEnv * envDepth\nresPhase = (phase * resMult) % 1.0\nresWindow = (1.0 - phase)\nczRes = sin(6.2831853 * resPhase) * resWindow\n\nsubOsc = sin(6.2831853 * subPhase) * subLevel\n\nraw = (czRes + subOsc) * drive\nsat = raw / (1.0 + abs(raw) * 0.3)\n\nlp = lp + 0.35 * (sat - lp)\nout = lp * ampEnv * 0.5\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 1.0 0.42 0.21
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Phase Distortion Synth. Casio CZ resonant windowing with sub-oscillator and analog saturation.
  f width 360
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.18 0.5
mod pic sizeY ana 0 0 1 0.5 0.18 0.5
