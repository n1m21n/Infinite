infinite-patch 1
# Barberpole Shepard Phaser FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 55
  i note2 51
  i note3 48
  i note4 55
  i note5 60
  i note6 58
  i note7 55
  i note8 46
  i note9 53
  i note10 50
  i note11 46
  i note12 53
  i note13 58
  i note14 55
  i note15 51
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.28
  f decay 0.45
  f volume 0.80
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rateHz = 0.28 [0.04, 2.5];\nparam float depth = 0.72 [0.1, 0.95];\nparam float resonance = 0.48 [0.0, 0.82];\nparam float warmth = 0.35 [0.0, 1.0];\nparam float mix = 0.82 [0.0, 1.0];\nstate float a1 = 0; state float a2 = 0; state float a3 = 0;\nstate float b1 = 0; state float b2 = 0; state float b3 = 0;\nstate float fbA = 0; state float fbB = 0; state float ph = 0; state float lp = 0;\n\nph = (ph + rateHz / sr) % 1.0;\nph2 = (ph + 0.5) % 1.0;\ncA = clamp(0.15 + depth * 0.72 * ph, 0.05, 0.91);\ncB = clamp(0.15 + depth * 0.72 * ph2, 0.05, 0.91);\n\nxA = in + fbA * resonance;\nyA1 = -cA * xA + a1; a1 = xA + cA * yA1;\nyA2 = -cA * yA1 + a2; a2 = yA1 + cA * yA2;\nyA3 = -cA * yA2 + a3; a3 = yA2 + cA * yA3;\nfbA = clamp(yA3, -1.0, 1.0);\n\nxB = in + fbB * resonance;\nyB1 = -cB * xB + b1; b1 = xB + cB * yB1;\nyB2 = -cB * yB1 + b2; b2 = yB1 + cB * yB2;\nyB3 = -cB * yB2 + b3; b3 = yB2 + cB * yB3;\nfbB = clamp(yB3, -1.0, 1.0);\n\nphased = (yA3 * sin(3.14159265 * ph) + yB3 * sin(3.14159265 * ph2)) * 0.82;\nlp = lp + clamp(0.45 - warmth * 0.25, 0.10, 0.60) * (phased - lp);\nwet = lp / (1.0 + abs(lp) * 0.45);\nout = (in * (1.0 - mix) + wet * mix) * 0.78;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.26 0.38 0.50
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Barberpole Shepard Phaser FX. Dual-bank six-stage allpass phaser driven by quadrature sawtooth-triangle Shepard LFOs for continuously rising phase notches.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
