infinite-patch 1
# Op Art Spectral Chime Synth: inharmonic additive chime generator with moire beating
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 84
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float brightness = 0.7 [0.1, 1.0]\nparam float inharmonicity = 0.45 [0.0, 1.0]\nparam float moireBeating = 4.5 [0.5, 12.0]\nparam float chimeDecay = 1.4 [0.2, 4.0]\nparam float resonance = 0.78 [0.1, 0.98]\nstate float p1 = 0\nstate float p2 = 0\nstate float p3 = 0\nstate float p4 = 0\nstate float env1 = 0\nstate float env2 = 0\nstate float env3 = 0\nstate float env4 = 0\nstate float beatPhase = 0\nstate float curFreq = 440\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenv1 = if(target > env1, env1 + (target - env1) * 0.12, env1 - env1 * (0.0002 / chimeDecay))\nenv2 = if(target > env2, env2 + (target - env2) * 0.14, env2 - env2 * (0.00035 / chimeDecay))\nenv3 = if(target > env3, env3 + (target - env3) * 0.16, env3 - env3 * (0.0006 / chimeDecay))\nenv4 = if(target > env4, env4 + (target - env4) * 0.18, env4 - env4 * (0.0011 / chimeDecay))\n\ncurFreq = curFreq + (freq - curFreq) * 0.05\nf0 = clamp(curFreq, 60.0, 4000.0)\n\nbeatPhase = (beatPhase + moireBeating / sr) % 1.0\nbeatMod = sin(beatPhase * 6.2831853) * 0.35 + 0.65\n\nr1 = 1.0\nr2 = 2.0 + inharmonicity * 0.76\nr3 = 3.0 + inharmonicity * 2.4\nr4 = 4.0 + inharmonicity * 4.9\n\np1 = (p1 + (f0 * r1) / sr) % 1.0\np2 = (p2 + (f0 * r2) / sr) % 1.0\np3 = (p3 + (f0 * r3) / sr) % 1.0\np4 = (p4 + (f0 * r4) / sr) % 1.0\n\ns1 = sin(p1 * 6.2831853) * env1\ns2 = sin(p2 * 6.2831853) * env2 * (0.6 * brightness) * beatMod\ns3 = sin(p3 * 6.2831853) * env3 * (0.35 * brightness)\ns4 = sin(p4 * 6.2831853) * env4 * (0.2 * brightness * brightness)\n\nmixSig = s1 + s2 + s3 + s4\nshimmer = tanh(mixSig * (1.0 + resonance * 1.5))\nout = shimmer * 0.95\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Op Art Spectral Chime Synth. Inharmonic additive chime and bell synthesizer with kinetic beating moire modulations and shimmering modal decays.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
