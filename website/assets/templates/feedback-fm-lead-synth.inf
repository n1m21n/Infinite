infinite-patch 1
# Feedback FM Lead Synth: 2-operator frequency modulation synth with modulator self-feedback
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 40
  i rangeHigh 76
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float ratio = 2.0 [0.5, 8.0]\nparam float modIndex = 2.5 [0.0, 8.0]\nparam float feedback = 0.65 [0.0, 1.5]\nparam float cutoff = 4500.0 [200.0, 12000.0]\nparam float res = 0.55 [0.0, 0.95]\nparam float decay = 0.45 [0.05, 2.0]\nstate float carrierPhase = 0\nstate float modPhase = 0\nstate float fbMod = 0\nstate float env = 0\nstate float s1 = 0\nstate float s2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01)\nenv = if(target > env, env + (target - env) * 0.08, env - env * decayRate)\n\npStep = clamp(freq, 20.0, 5000.0) / sr\ncarrierPhase = (carrierPhase + pStep) % 1.0\nmodPhase = (modPhase + pStep * ratio) % 1.0\n\nmSignal = sin(6.2831853 * modPhase + fbMod * feedback * 2.5)\nfbMod = mSignal\n\ncSignal = sin(6.2831853 * carrierPhase + mSignal * modIndex * env)\n\nfCut = clamp((cutoff + env * 4000.0) / sr * 2.0, 0.01, 0.48)\nfbFilt = (s2 * res * 2.8) / (1.0 + abs(s2) * 0.8)\nu = cSignal - fbFilt\nsat = u / (1.0 + abs(u) * 0.25)\ns1 = s1 + fCut * (sat - s1)\ns2 = s2 + fCut * (s1 - s2)\n\nout = s2 * (0.2 + env * 0.8) * 0.42\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Feedback FM Lead Synth. 2-operator FM synth with modulator self-feedback.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
