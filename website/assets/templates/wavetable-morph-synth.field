{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Wavetable Morph Synth",
    "author": "Infinite",
    "description": "Multi-profile wavetable oscillator with continuous morphing across warm sine, folded triangle, saw and pulsed harmonics, sub-oscillator and analog warmth.",
    "domain": "synth"
  },
  "device": {
    "code": "param float pos = 0.35 [0.0, 1.0];\nparam float morphMod = 0.5 [0.0, 1.0];\nparam float decay = 2.0 [0.1, 6.0];\nparam float subLevel = 0.4 [0.0, 1.0];\nparam float warmth = 1.35 [1.0, 3.5];\nstate float phase = 0;\nstate float subPhase = 0;\nstate float ampEnv = 0;\nstate float morphEnv = 0;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nampDecayRate = clamp(1.0 / (sr * decay), 0.00002, 0.02);\nmorphDecayRate = clamp(1.0 / (sr * (decay * 0.65)), 0.00003, 0.025);\nampEnv = if(target > ampEnv, ampEnv + (target - ampEnv) * 0.18, ampEnv - ampEnv * ampDecayRate);\nmorphEnv = if(target > morphEnv, morphEnv + (target - morphEnv) * 0.22, morphEnv - morphEnv * morphDecayRate);\n\nf0 = clamp(freq, 20.0, 5000.0);\nstep = f0 / sr;\nphase = (phase + step) % 1.0;\nsubPhase = (subPhase + step * 0.5) % 1.0;\n\ncurPos = clamp(pos + morphEnv * morphMod, 0.0, 1.0);\n\nwSine = sin(6.2831853 * phase);\nwSaw = sin(6.2831853 * phase) + 0.45 * sin(12.5663706 * phase) + 0.22 * sin(18.8495559 * phase);\nwPulse = (sin(6.2831853 * phase) + 0.6 * sin(18.8495559 * phase) + 0.4 * sin(31.4159265 * phase) + 0.25 * sin(43.9822971 * phase)) * 0.7;\n\nt1 = clamp(curPos * 2.0, 0.0, 1.0);\nstage1 = wSine * (1.0 - t1) + wSaw * t1;\nt2 = clamp((curPos - 0.5) * 2.0, 0.0, 1.0);\nstage2 = wSaw * (1.0 - t2) + wPulse * t2;\nosc = if(curPos < 0.5, stage1, stage2);\n\nsubOsc = sin(6.2831853 * subPhase) * subLevel;\n\nraw = (osc + subOsc) * warmth;\nsat = raw / (1.0 + abs(raw) * 0.25);\n\nlp = lp + 0.38 * (sat - lp);\nout = lp * ampEnv * 0.5;\n",
    "params": {
      "pos": 0.35,
      "morphMod": 0.5,
      "decay": 2.0,
      "subLevel": 0.4,
      "warmth": 1.35
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
