infinite-patch 1
# Six-Stage Allpass Phaser FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 55
  i note5 50
  i note6 48
  i note7 52
  i note8 48
  i note9 55
  i note10 57
  i note11 60
  i note12 57
  i note13 55
  i note14 52
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float lfoRate = 0.42 [0.05, 4.0];\nparam float centerHz = 920.0 [220.0, 3200.0];\nparam float sweepOct = 2.4 [0.2, 4.0];\nparam float feedback = 0.62 [0.0, 0.88];\nparam float mix = 0.75 [0.0, 1.0];\nstate float lfo = 0; state float fb = 0;\nstate float ap1 = 0; state float ap2 = 0; state float ap3 = 0;\nstate float ap4 = 0; state float ap5 = 0; state float ap6 = 0;\n\nlfo = (lfo + lfoRate / sr) % 1.0;\nmod = sin(6.2831853 * lfo);\nhz = clamp(centerHz * pow(2.0, mod * sweepOct * 0.5), 90.0, 9500.0);\nw = clamp(3.14159265 * hz / sr, 0.01, 1.25);\nc = (1.0 - w) / (1.0 + w);\n\nx = in + fb * feedback;\nsat = x / (1.0 + abs(x) * 0.45);\n\ny1 = -c * sat + ap1; ap1 = sat + c * y1;\ny2 = -c * y1 + ap2; ap2 = y1 + c * y2;\ny3 = -c * y2 + ap3; ap3 = y2 + c * y3;\ny4 = -c * y3 + ap4; ap4 = y3 + c * y4;\ny5 = -c * y4 + ap5; ap5 = y4 + c * y5;\ny6 = -c * y5 + ap6; ap6 = y5 + c * y6;\n\nfb = clamp(y6, -1.0, 1.0);\nphased = (sat + y6) * 0.55;\nout = (in * (1.0 - mix) + phased * mix) * 0.58;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Six-Stage Allpass Phaser FX. Six-stage cascaded first-order allpass phaser with LFO-swept notch combs, asymmetric diode feedback saturation, and lush phase dispersion.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
