infinite-patch 1
# Broken Beat Rhodes BBD Ensemble FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 53
  i note2 57
  i note3 60
  i note4 50
  i note5 55
  i note6 58
  i note7 62
  i note8 48
  i note9 52
  i note10 55
  i note11 59
  i note12 50
  i note13 53
  i note14 57
  i note15 64
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.52
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rateA = 0.65 [0.1, 3.5];\nparam float rateB = 2.15 [0.3, 6.5];\nparam float depth = 0.68 [0.1, 1.0];\nparam float tone = 0.62 [0.15, 1.0];\nparam float mix = 0.58 [0.0, 1.0];\nstate float lfoA = 0;\nstate float lfoB = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float lp = 0;\n\nlfoA = (lfoA + rateA / sr) % 1.0;\nlfoB = (lfoB + rateB / sr) % 1.0;\nmodA = sin(6.2831853 * lfoA) * 0.65 + sin(6.2831853 * lfoB) * 0.35;\nmodB = cos(6.2831853 * lfoA) * 0.65 - cos(6.2831853 * lfoB) * 0.35;\n\ng1 = clamp(0.42 + modA * depth * 0.38, -0.88, 0.88);\ng2 = clamp(-0.36 + modB * depth * 0.38, -0.88, 0.88);\n\ny1 = -g1 * in + ap1; ap1 = in + g1 * y1;\ny2 = -g1 * y1 + ap2; ap2 = y1 + g1 * y2;\ny3 = -g2 * y2 + ap3; ap3 = y2 + g2 * y3;\ny4 = -g2 * y3 + ap4; ap4 = y3 + g2 * y4;\n\nfCut = clamp(0.08 + tone * 0.36, 0.04, 0.45);\nlp = lp + fCut * (y4 - lp);\nsat = (lp * 1.35) / (1.0 + abs(lp * 1.35) * 0.45);\n\nout = (in * (1.0 - mix) + sat * mix) * 0.74;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.36 0.58
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Broken Beat Rhodes BBD Ensemble FX. Dual-LFO bucket-brigade chorus ensemble with warm low-pass anti-alias rolloff, cross-coupled modulation, and soft analog saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
