{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Feedback FM Lead Synth",
    "author": "Infinite",
    "description": "Two-operator frequency modulation synthesizer with nonlinear modulator self-feedback, resonant filter and dynamic decay envelope.",
    "domain": "synth"
  },
  "device": {
    "code": "param float ratio = 2.0 [0.5, 8.0];\nparam float modIndex = 2.5 [0.0, 8.0];\nparam float feedback = 0.65 [0.0, 1.5];\nparam float cutoff = 4500.0 [200.0, 12000.0];\nparam float res = 0.55 [0.0, 0.95];\nparam float decay = 0.45 [0.05, 2.0];\nstate float carrierPhase = 0;\nstate float modPhase = 0;\nstate float fbMod = 0;\nstate float env = 0;\nstate float s1 = 0;\nstate float s2 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01);\nenv = if(target > env, env + (target - env) * 0.08, env - env * decayRate);\n\npStep = clamp(freq, 20.0, 5000.0) / sr;\ncarrierPhase = (carrierPhase + pStep) % 1.0;\nmodPhase = (modPhase + pStep * ratio) % 1.0;\n\nmSignal = sin(6.2831853 * modPhase + fbMod * feedback * 2.5);\nfbMod = mSignal;\n\ncSignal = sin(6.2831853 * carrierPhase + mSignal * modIndex * env);\n\nfCut = clamp((cutoff + env * 4000.0) / sr * 2.0, 0.01, 0.48);\nfbFilt = (s2 * res * 2.8) / (1.0 + abs(s2) * 0.8);\nu = cSignal - fbFilt;\nsat = u / (1.0 + abs(u) * 0.25);\ns1 = s1 + fCut * (sat - s1);\ns2 = s2 + fCut * (s1 - s2);\n\nout = s2 * (0.2 + env * 0.8) * 0.42;\n",
    "params": {
      "ratio": 2.0,
      "modIndex": 2.5,
      "feedback": 0.65,
      "cutoff": 4500.0,
      "res": 0.55,
      "decay": 0.45
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
