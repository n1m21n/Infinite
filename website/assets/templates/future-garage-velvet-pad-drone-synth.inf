infinite-patch 1
# Future Garage Velvet Pad Drone Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 55
  i note1 55
  i note2 58
  i note3 62
  i note4 55
  i note5 58
  i note6 65
  i note7 62
  i note8 55
  i note9 55
  i note10 58
  i note11 60
  i note12 55
  i note13 67
  i note14 62
  i note15 55
  b en0 1
  b en1 1
