infinite-patch 1
# Acid House 303 Resonant Filter FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 38
  i note1 38
  i note2 50
  i note3 45
  i note4 38
  i note5 39
  i note6 48
  i note7 38
  i note8 38
  i note9 38
  i note10 50
  i note11 45
  i note12 38
  i note13 50
  i note14 43
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2800.0
  f resonance 0.25
  f decay 0.35
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float cutoff = 950.0 [180.0, 4200.0];\nparam float resonance = 0.55 [0.0, 0.85];\nparam float lfoRate = 0.65 [0.1, 4.0];\nparam float drive = 1.6 [0.5, 4.0];\nparam float mix = 0.80 [0.0, 1.0];\nstate float lfo = 0;\nstate float lp1 = 0;\nstate float lp2 = 0;\n\nlfo = (lfo + lfoRate / sr) % 1.0;\nmod = 1.0 + 0.55 * sin(6.2831853 * lfo);\nfCut = clamp((cutoff * mod) / sr * 3.14, 0.02, 0.45);\n\nfb = clamp(lp2 * resonance * 1.35, -0.95, 0.95);\ndriven = in * drive - fb;\nsat = driven / (1.0 + abs(driven));\n\nlp1 = lp1 + fCut * (sat - lp1);\nlp2 = lp2 + fCut * (lp1 - lp2);\n\nout = clamp(in * (1.0 - mix) + lp2 * mix * 1.15, -0.92, 0.92);\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.30 0.20
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House 303 Resonant Filter FX. Sweeping resonant diode-style lowpass filter with soft waveshaped drive and LFO cutoff modulation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
