infinite-patch 1
# Glitch Spectral Aliasing Bitcrush FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float crush = 0.50 [0.0, 0.9]\nparam float drive = 0.45 [0.0, 1.0]\nparam float tone = 0.50 [0.1, 1.0]\nparam float wavefold = 0.35 [0.0, 1.0]\nparam float mix = 0.60 [0.0, 1.0]\nstate float s1 = 0\nstate float s2 = 0\n\nsteps = clamp(floor(28.0 - crush * 22.0), 3.0, 28.0)\nqIn = floor(in * steps) / steps\n\npre = qIn * (1.0 + drive * 2.4)\nfold = sin(pre * (1.0 + wavefold * 1.8))\nsat = (fold - (fold * fold * fold * 0.12)) / (1.0 + abs(fold * 0.35))\n\nfCut = clamp(0.06 + tone * 0.36, 0.02, 0.45)\ns1 = s1 + fCut * (sat - s1)\ns2 = s2 + fCut * (s1 - s2)\n\nprocessed = in * (1.0 - mix) + s2 * mix\nout = processed * 0.48\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Glitch Spectral Aliasing Bitcrush FX. Searing industrial glitch downsampler featuring variable sample-rate reduction, nonlinear wavefolding drive, quantized amplitude bit-depth crushing, and warm tone filtering.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
