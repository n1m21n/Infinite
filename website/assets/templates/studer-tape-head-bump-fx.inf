infinite-patch 1
# Studer Tape Head Bump FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 53
  i note2 57
  i note3 60
  i note4 62
  i note5 60
  i note6 57
  i note7 53
  i note8 50
  i note9 57
  i note10 60
  i note11 64
  i note12 60
  i note13 57
  i note14 53
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float drive = 1.65 [0.8, 3.5];\nparam float bumpHz = 88.0 [45.0, 160.0];\nparam float bumpGain = 0.42 [0.0, 0.85];\nparam float wowHz = 0.55 [0.1, 2.5];\nparam float mix = 0.78 [0.0, 1.0];\nstate float lfo = 0; state float ap1 = 0;\nstate float bpLow = 0; state float bpBand = 0; state float hfLp = 0;\n\nlfo = (lfo + wowHz / sr) % 1.0;\nc = clamp(0.42 + sin(6.2831853 * lfo) * 0.16, 0.1, 0.82);\n\n# Subtle capstan wow/flutter dispersion\nwowed = -c * in + ap1;\nap1 = in + c * wowed;\n\n# Resonant head-bump shelf around bumpHz\nfBump = clamp(2.0 * sin(3.14159265 * bumpHz / sr), 0.002, 0.25);\nbpLow = bpLow + fBump * (wowed - bpBand - bpLow);\nbpBand = bpBand + fBump * bpLow * 1.4;\nbumped = wowed + bpBand * bumpGain;\n\n# Asymmetric tape hysteresis saturation + 7.5 ips HF roll-off\ndrv = (bumped + 0.08 * bumped * bumped) * drive;\nsat = (drv / (1.0 + abs(drv))) * 0.82;\ngHf = clamp(2.0 * sin(3.14159265 * 5400.0 / sr), 0.08, 0.88);\nhfLp = hfLp + gHf * (sat - hfLp);\n\nout = (in * (1.0 - mix) + hfLp * mix) * 0.78;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Studer Tape Head Bump FX. Analog reel-to-reel tape path with low-frequency head-bump resonance, asymmetric hysteresis saturation, and subtle wow/flutter allpass drift.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
