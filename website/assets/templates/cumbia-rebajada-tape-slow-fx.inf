infinite-patch 1
# Cumbia Rebajada Tape Slow FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 45
  i note1 48
  i note2 52
  i note3 45
  i note4 48
  i note5 52
  i note6 55
  i note7 52
  i note8 43
  i note9 47
  i note10 50
  i note11 43
  i note12 45
  i note13 48
  i note14 52
  i note15 45
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2200.0
  f resonance 0.28
  f decay 0.48
  f volume 0.82
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float toneHz = 1150.0 [280.0, 4200.0];\nparam float flutter = 0.42 [0.0, 0.9];\nparam float drive = 1.85 [0.7, 3.5];\nparam float feedback = 0.36 [0.0, 0.78];\nparam float mix = 0.85 [0.0, 1.0];\nstate float lp1 = 0; state float lp2 = 0; state float ap = 0; state float lfo = 0; state float fb = 0;\n\nlfo = (lfo + 0.65 / sr) % 1.0;\nmod = 0.55 + 0.35 * sin(6.2831853 * lfo) * flutter;\nx = in + fb * feedback;\ny = -mod * x + ap;\nap = x + mod * y;\n\nfHz = clamp(toneHz * (0.85 + 0.25 * sin(12.56637 * lfo)), 180.0, 5000.0);\ng = clamp(2.0 * sin(3.14159265 * fHz / sr), 0.02, 0.82);\nlp1 = lp1 + g * (y - lp1);\nlp2 = lp2 + g * (lp1 - lp2);\nfb = clamp(lp2, -1.0, 1.0);\n\nsat = (lp2 * drive) / (1.0 + abs(lp2 * drive) * 0.68);\nout = (in * (1.0 - mix) + sat * mix) * 0.82;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.58 0.24 0.18
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Cumbia Rebajada Tape Slow FX. Monterrey cumbia rebajada varispeed tape processor with capstan flutter drift, wooly oxide low-pass saturation, and warm spring feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
