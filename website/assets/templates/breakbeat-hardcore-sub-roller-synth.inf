infinite-patch 1
# Breakbeat Hardcore Sub Roller Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 36
  i note1 36
  i note2 48
  i note3 36
  i note4 39
  i note5 36
  i note6 43
  i note7 46
  i note8 36
  i note9 36
  i note10 48
  i note11 36
  i note12 39
  i note13 41
  i note14 43
  i note15 46
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
