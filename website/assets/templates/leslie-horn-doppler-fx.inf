infinite-patch 1
# Leslie Horn Doppler FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 52
  i note2 55
  i note3 59
  i note4 60
  i note5 59
  i note6 55
  i note7 52
  i note8 48
  i note9 55
  i note10 59
  i note11 64
  i note12 59
  i note13 55
  i note14 52
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id src
  pos 340 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 680 1024
  s code param float rotorHz = 3.8 [0.4, 8.5];\nparam float depth = 0.68 [0.1, 0.92];\nparam float crossHz = 820.0 [350.0, 1800.0];\nparam float drive = 1.45 [0.8, 2.8];\nparam float mix = 0.72 [0.0, 1.0];\nstate float lfoH = 0; state float lfoD = 0;\nstate float lpCross = 0; state float ap1 = 0; state float ap2 = 0; state float ap3 = 0;\n\nlfoH = (lfoH + rotorHz / sr) % 1.0;\nlfoD = (lfoD + (rotorHz * 0.76) / sr) % 1.0;\n\ngC = clamp(2.0 * sin(3.14159265 * crossHz / sr), 0.03, 0.72);\nlpCross = lpCross + gC * (in - lpCross);\ndrum = lpCross;\nhorn = in - lpCross;\n\n# Quadrature Doppler allpass dispersion + horn amplitude sweep\ncH = 0.35 + 0.45 * depth * sin(6.2831853 * lfoH);\ny1 = -cH * horn + ap1; ap1 = horn + cH * y1;\ny2 = -cH * y1 + ap2; ap2 = y1 + cH * y2;\nhornMod = y2 * (0.72 + 0.28 * cos(6.2831853 * lfoH));\n\ncD = 0.25 + 0.35 * depth * sin(6.2831853 * lfoD);\ndrumMod = (-cD * drum + ap3) * (0.80 + 0.20 * cos(6.2831853 * lfoD));\nap3 = drum + cD * drumMod;\n\ndrv = (hornMod + drumMod) * drive;\nsat = drv / (1.0 + abs(drv));\nout = (in * (1.0 - mix) + sat * mix) * 0.56;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1040 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Leslie Horn Doppler FX. Dual-rotor rotary speaker simulation splitting signal into treble horn and bass drum rotors with quadrature Doppler phase modulation and tube warmth.
  f width 340
  f height 120
end
note src 0 notes
aud fx 0 src
aud speakers 0 fx
cable out 0 pic
