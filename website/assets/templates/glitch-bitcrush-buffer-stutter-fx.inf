infinite-patch 1
# Glitch Bitcrush Buffer Stutter FX: post-digital audio mangler
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 36
  i rangeHigh 60
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2600.0
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float bits = 5.0 [2.0, 16.0]\nparam float downsample = 6.0 [1.0, 32.0]\nparam float stutterRate = 8.0 [1.0, 24.0]\nparam float jitter = 0.45 [0.0, 1.0]\nparam float mix = 0.9 [0.0, 1.0]\nstate float sampleCount = 0\nstate float heldSample = 0\nstate float stutterPhase = 0\nstate float stutterBuffer = 0\n\nsampleCount = sampleCount + 1.0\nstepDs = floor(downsample + sin(stutterPhase * 12.56) * jitter * 3.0)\nheldSample = if(sampleCount >= stepDs, in, heldSample)\nsampleCount = if(sampleCount >= stepDs, 0.0, sampleCount)\n\nlevels = pow(2.0, clamp(bits, 2.0, 16.0))\ncrushed = floor(heldSample * levels + 0.5) / levels\n\nstutterPhase = (stutterPhase + stutterRate / sr) % 1.0\nstutterBuffer = if(stutterPhase < 0.08, crushed, stutterBuffer * 0.9996 + crushed * 0.0004)\nisRepeat = if(stutterPhase > 0.45, 1.0, 0.0)\nwet = isRepeat * stutterBuffer + (1.0 - isRepeat) * crushed\n\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.306 0.949 0.722
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Glitch Bitcrush Buffer Stutter FX. Post-digital audio mangler with bit depth decimation, downsampling and stutter repeats.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
