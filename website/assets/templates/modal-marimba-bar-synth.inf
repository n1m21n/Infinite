infinite-patch 1
# Modal Marimba Bar Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 55
  i note1 57
  i note2 59
  i note3 62
  i note4 64
  i note5 62
  i note6 59
  i note7 57
  i note8 55
  i note9 62
  i note10 64
  i note11 67
  i note12 64
  i note13 62
  i note14 59
  i note15 57
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
