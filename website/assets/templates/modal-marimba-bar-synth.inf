node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float hardness = 0.62 [0.1, 1.0];\nparam float stiffness = 0.18 [0.0, 0.5];\nparam float brightHz = 3200.0 [800.0, 7000.0];\nparam float decay = 0.9994 [0.997, 0.9997];\nstate float m1 = 0; state float m2 = 0; state float m3 = 0;\nstate float env1 = 0; state float env2 = 0; state float strike = 1.0;\nstate float lp1 = 0;\n\nenv1 = if(gate > 0.5, env1 + (1.0 - env1) * 0.30, env1 * decay);\nenv2 = if(gate > 0.5, env2 + (1.0 - env2) * 0.35, env2 * (decay - 0.0018));\nstrike = if(gate > 0.5, strike * 0.988, 1.0);\n\nf0 = clamp(freq, 65.0, 2600.0);\nm1 = (m1 + f0 / sr) % 1.0;\nm2 = (m2 + (f0 * (2.756 + stiffness * 0.25)) / sr) % 1.0;\nm3 = (m3 + (f0 * (5.404 + stiffness * 0.45)) / sr) % 1.0;\n\nbar = sin(6.2831853 * m1) * env1 * 0.78 + sin(6.2831853 * m2) * env2 * 0.38 * hardness + sin(6.2831853 * m3) * (env2 * 0.20 + strike * 0.30) * hardness;\n\ng = clamp(2.0 * sin(3.14159265 * brightHz / sr), 0.05, 0.85);\nlp1 = lp1 + g * (bar - lp1);\n\ndrv = lp1 * 1.3;\nout = (drv / (1.0 + abs(drv))) * 0.36;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Modal Marimba Bar Synth. Euler-Bernoulli stiff-bar modal resonator bank with inharmonic bar modes, cosine mallet strike transient, and wooden resonator body.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
