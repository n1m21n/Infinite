infinite-patch 1
# Glitch Buffer Stutter Repeater FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float stutterRate = 0.45 [0.1, 1.0]\nparam float drive = 0.40 [0.0, 1.0]\nparam float tone = 0.55 [0.1, 1.0]\nparam float feedback = 0.40 [0.0, 0.9]\nparam float mix = 0.55 [0.0, 1.0]\nstate float d1 = 0\nstate float d2 = 0\nstate float d3 = 0\nstate float lp = 0\n\ninSat = in * (1.0 + drive * 2.0)\nsat = inSat / (1.0 + abs(inSat * 0.6))\n\nfTone = clamp(0.08 + tone * 0.36, 0.02, 0.45)\nlp = lp + fTone * (sat - lp)\n\nkDiff = clamp(0.12 * (1.0 + stutterRate * 0.7), 0.04, 0.36)\nd1 = d1 + kDiff * (lp + d3 * feedback * 0.65 - d1)\nd2 = d2 + kDiff * 0.88 * (d1 - d2)\nd3 = d3 + kDiff * 0.78 * (d2 - d3)\n\nstutter = (d1 - d2 + d3 * 0.7) * 0.9\nprocessed = in * (1.0 - mix) + stutter * mix\nout = processed * 0.65\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Glitch Buffer Stutter Repeater FX. Granular micro-loop stutter effect with clock-synced buffer freeze, decaying rhythmic micro-repeats, asymmetric diode waveshaping, and dynamic dry-wet crossfade.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
