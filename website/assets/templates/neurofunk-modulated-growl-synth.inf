infinite-patch 1
# Neurofunk Modulated Growl Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 38
  i note1 38
  i note2 50
  i note3 38
  i note4 41
  i note5 38
  i note6 45
  i note7 48
  i note8 38
  i note9 38
  i note10 50
  i note11 38
  i note12 41
  i note13 43
  i note14 45
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
