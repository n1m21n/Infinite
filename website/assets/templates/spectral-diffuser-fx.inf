infinite-patch 1
# Spectral Diffuser FX: allpass diffusion reverb Field FX
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 Effects Field
  id fx
  pos 720 1024
  s code param float diffusion = 0.72 [0.1, 0.95]\nparam float damping = 0.35 [0.0, 0.95]\nparam float modRate = 0.85 [0.1, 5.0]\nparam float modDepth = 0.4 [0.0, 1.0]\nparam float mix = 0.8 [0.0, 1.0]\nstate float ap1 = 0\nstate float ap1_buf = 0\nstate float ap2 = 0\nstate float ap2_buf = 0\nstate float ap3 = 0\nstate float ap3_buf = 0\nstate float ap4 = 0\nstate float ap4_buf = 0\nstate float lfoP = 0\nstate float lp = 0\n\nlfoP = (lfoP + modRate / sr) % 1.0\njitter = sin(6.2831853 * lfoP) * modDepth * 0.15\ng = clamp(diffusion + jitter, 0.1, 0.88)\n\nx = in\n\nv1 = x - g * ap1_buf\nap1 = ap1_buf + g * v1\nap1_buf = v1\n\nv2 = ap1 - g * ap2_buf\nap2 = ap2_buf + g * v2\nap2_buf = v2\n\nlp = lp + clamp((1.0 - damping) * 0.45, 0.01, 0.8) * (ap2 - lp)\n\nv3 = lp - g * ap3_buf\nap3 = ap3_buf + g * v3\nap3_buf = v3\n\nv4 = ap3 - g * ap4_buf\nap4 = ap4_buf + g * v4\nap4_buf = v4\n\nwet = ap4\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
