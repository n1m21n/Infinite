infinite-patch 1
# Trautonium Subharmonic Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 55
  i note2 51
  i note3 58
  i note4 60
  i note5 58
  i note6 55
  i note7 51
  i note8 48
  i note9 53
  i note10 55
  i note11 60
  i note12 63
  i note13 60
  i note14 58
  i note15 55
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
