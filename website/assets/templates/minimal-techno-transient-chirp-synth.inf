infinite-patch 1
# Minimal Techno Transient Chirp Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 48
  i note4 51
  i note5 48
  i note6 55
  i note7 58
  i note8 48
  i note9 48
  i note10 60
  i note11 48
  i note12 51
  i note13 53
  i note14 55
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float chirpDepth = 0.65 [0.1, 1.2]\nparam float clickTone = 2400.0 [600.0, 6000.0]\nparam float bodyDecay = 0.24 [0.06, 0.7]\nparam float metallicMod = 0.40 [0.0, 1.0]\nparam float subPunch = 0.50 [0.0, 1.0]\nstate float pCar = 0\nstate float pMod = 0\nstate float env = 0\nstate float pSnap = 0\nstate float bp1 = 0\nstate float bp2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenvRate = clamp(1.0 / (sr * bodyDecay), 0.0001, 0.03)\nsnapRate = clamp(1.0 / (sr * 0.025), 0.0008, 0.08)\n\nenv = if(target > env, env + (target - env) * 0.50, env - env * envRate)\npSnap = if(target > pSnap, pSnap + (target - pSnap) * 0.75, pSnap - pSnap * snapRate)\n\nfBase = clamp(freq, 40.0, 800.0)\nfSnap = fBase * (1.0 + pSnap * chirpDepth * 4.0)\n\ndpMod = (fBase * 2.76) / sr\npMod = pMod + dpMod\npMod = if(pMod >= 1.0, pMod - 1.0, pMod)\nmodSig = sin(pMod * 6.2831853) * metallicMod * 0.4\n\ndpCar = fSnap / sr\npCar = pCar + dpCar + modSig\npCar = if(pCar >= 1.0, pCar - 1.0, pCar)\ncarSig = sin(pCar * 6.2831853)\n\nsubSig = sin(pCar * 3.14159265) * subPunch * 0.5\nraw = (carSig + subSig) * env\n\nfBP = clamp((clickTone / sr) * 1.5, 0.02, 0.45)\nbp1 = bp1 + fBP * (raw - bp1)\nbp2 = bp2 + fBP * (bp1 - bp2)\nshaped = (bp1 - bp2) * 2.2 + raw * 0.4\n\nout = clamp(shaped * 0.28, -0.65, 0.65)\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.18 0.20 0.25
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Minimal Techno Transient Chirp Synth. Percussive minimal techno modulation synthesizer with snappy envelope pitch chirps, resonant bandpass click, and tight metallic body.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
