{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Stereo Ping-Pong Delay FX",
    "author": "Infinite",
    "description": "Stereo cross-feedback ping-pong delay with tape-style lowpass damping, soft saturation and stereo width modulation.",
    "domain": "sample"
  },
  "device": {
    "code": "param float rate = 0.35 [0.05, 2.0];\nparam float feedback = 0.58 [0.0, 0.95];\nparam float damping = 0.45 [0.0, 1.0];\nparam float drive = 1.35 [1.0, 3.5];\nparam float mix = 0.5 [0.0, 1.0];\nstate float d1 = 0;\nstate float d2 = 0;\nstate float d3 = 0;\nstate float d4 = 0;\nstate float d5 = 0;\nstate float d6 = 0;\nstate float fbL = 0;\nstate float fbR = 0;\nstate float lpL = 0;\nstate float lpR = 0;\n\nxL = in + fbR * feedback;\nxR = in + fbL * feedback;\n\nsatL = (xL * drive) / (1.0 + abs(xL * drive) * 0.25);\nsatR = (xR * drive) / (1.0 + abs(xR * drive) * 0.25);\n\nc1 = clamp(rate * 0.4, 0.01, 0.35);\nd1 = d1 + c1 * (satL - d1);\nd2 = d2 + c1 * (d1 - d2);\nd3 = d3 + c1 * (d2 - d3);\n\nc2 = clamp(rate * 0.45, 0.01, 0.35);\nd4 = d4 + c2 * (satR - d4);\nd5 = d5 + c2 * (d4 - d5);\nd6 = d6 + c2 * (d5 - d6);\n\nfCut = clamp((5000.0 - damping * 3500.0) / sr * 2.0, 0.01, 0.45);\nlpL = lpL + fCut * (d3 - lpL);\nlpR = lpR + fCut * (d6 - lpR);\n\nfbL = lpL;\nfbR = lpR;\n\nwet = (lpL + lpR) * 0.5;\nout = in * (1.0 - mix) + wet * mix;\n",
    "params": {
      "rate": 0.35,
      "feedback": 0.58,
      "damping": 0.45,
      "drive": 1.35,
      "mix": 0.5
    },
    "nodeSettings": {}
  }
}
