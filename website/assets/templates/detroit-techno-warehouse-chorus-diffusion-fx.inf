infinite-patch 1
# Detroit Techno Warehouse Chorus Diffusion FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3400.0
  f resonance 0.30
  f decay 0.32
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rate = 0.42 [0.05, 1.0]\nparam float depth = 0.52 [0.0, 1.0]\nparam float tone = 0.48 [0.1, 1.0]\nparam float warmth = 0.42 [0.0, 1.0]\nparam float mix = 0.52 [0.0, 1.0]\nstate float c1 = 0\nstate float c2 = 0\nstate float c3 = 0\nstate float lp = 0\nstate float lfo1 = 0\nstate float lfo2 = 0\n\nlfo1 = (lfo1 + rate * 0.0022) % 1.0\nlfo2 = (lfo2 + rate * 0.0031 + 0.25) % 1.0\nmod1 = sin(lfo1 * 6.2831853) * depth * 0.035\nmod2 = cos(lfo2 * 6.2831853) * depth * 0.028\n\nfTone = clamp(0.04 + tone * 0.36, 0.015, 0.44)\ninSat = in / (1.0 + abs(in * (0.16 + warmth * 0.20)))\nlp = lp + fTone * (inSat - lp)\n\nkRate1 = clamp(0.12 + mod1, 0.03, 0.35)\nkRate2 = clamp(0.10 + mod2, 0.02, 0.32)\nc1 = c1 + kRate1 * (lp - c1)\nc2 = c2 + kRate2 * (c1 - c2)\nc3 = c3 + kRate1 * 0.8 * (c2 - c3)\n\nchorusSig = (c1 * 0.45 + c2 * 0.42 - c3 * 0.32) * 1.35\nsat = chorusSig / (1.0 + abs(chorusSig * 0.22))\nprocessed = in * (1.0 - mix) + sat * mix\nout = processed * 1.12\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Detroit Techno Warehouse Chorus Diffusion FX. Multi-voice analog bucket-brigade chorus and spatial diffusion effect providing wide stereo chorus modulation, lush harmonic depth, and subtle early-reflection warmth.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
