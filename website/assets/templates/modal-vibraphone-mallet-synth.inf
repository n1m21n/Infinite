node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float malletHard = 0.58 [0.1, 1.0];\nparam float motorHz = 4.2 [0.5, 9.0];\nparam float motorDepth = 0.38 [0.0, 0.85];\nparam float barSpread = 0.18 [0.0, 0.6];\nparam float decay = 0.9994 [0.997, 0.9997];\nstate float p1 = 0; state float p2 = 0; state float p3 = 0; state float pMot = 0;\nstate float env = 0; state float strike = 1.0; state float lp = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.26, env * decay);\nstrike = if(gate > 0.5, strike * 0.991, 1.0);\n\nf0 = clamp(freq, 65.0, 2800.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * (3.99 + barSpread * 0.08)) / sr) % 1.0;\np3 = (p3 + (f0 * (9.96 - barSpread * 0.12)) / sr) % 1.0;\npMot = (pMot + motorHz / sr) % 1.0;\n\ntrem = 1.0 - motorDepth * 0.5 * (1.0 + sin(6.2831853 * pMot));\nbar = (sin(6.2831853 * p1) + sin(6.2831853 * p2) * (0.25 + malletHard * 0.35) * strike + sin(6.2831853 * p3) * (0.12 + malletHard * 0.25) * strike * strike) * env * trem;\n\ng = clamp(2.0 * sin(3.14159265 * (1200.0 + malletHard * 3600.0) / sr), 0.04, 0.88);\nlp = lp + g * (bar - lp);\nout = (lp / (1.0 + abs(lp) * 0.45)) * 0.68;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Modal Vibraphone Mallet Synth. Struck modal vibraphone resonator with inharmonic bar overtones (1:3.99:9.96), mallet hardness transient, and motor-driven tremolo.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
