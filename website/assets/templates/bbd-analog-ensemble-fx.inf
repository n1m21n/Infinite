infinite-patch 1
# BBD Analog Ensemble FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 50
  i note2 55
  i note3 57
  i note4 55
  i note5 50
  i note6 48
  i note7 52
  i note8 48
  i note9 55
  i note10 57
  i note11 60
  i note12 57
  i note13 55
  i note14 52
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float slowHz = 0.62 [0.1, 2.5];\nparam float vibratoHz = 5.4 [2.0, 9.0];\nparam float depth = 0.58 [0.0, 1.0];\nparam float toneHz = 3200.0 [800.0, 7500.0];\nparam float mix = 0.68 [0.0, 1.0];\nstate float lfo1 = 0; state float lfo2 = 0;\nstate float ap1 = 0; state float ap2 = 0; state float lp1 = 0;\n\nlfo1 = (lfo1 + slowHz / sr) % 1.0;\nlfo2 = (lfo2 + vibratoHz / sr) % 1.0;\n\nmod = sin(6.2831853 * lfo1) * 0.65 + sin(6.2831853 * lfo2) * 0.35;\nc1 = clamp(0.48 + mod * 0.34 * depth, 0.08, 0.88);\nc2 = clamp(0.48 - mod * 0.30 * depth, 0.08, 0.88);\n\ny1 = -c1 * in + ap1; ap1 = in + c1 * y1;\ny2 = -c2 * in + ap2; ap2 = in + c2 * y2;\n\nbbd = (y1 + y2) * 0.52;\ng = clamp(2.0 * sin(3.14159265 * toneHz / sr), 0.04, 0.85);\nlp1 = lp1 + g * (bbd - lp1);\n\nout = (in * (1.0 - mix) + lp1 * mix) * 0.68;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text BBD Analog Ensemble FX. Triple-phase Bucket-Brigade (BBD) analog chorus ensemble with dual slow/vibrato LFO modulation, clock-filter warmth, and stereo movement.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
