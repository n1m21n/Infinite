{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Liminal Drone Pad Synth",
    "author": "Infinite",
    "description": "Hypnagogic dark ambient drone synthesizer with detuned multi-oscillator harmonic cluster, sub-octave fundamental saturation, slow-drift chorus modulation, and four-pole ladder lowpass filter.",
    "domain": "synth"
  },
  "device": {
    "code": "param float cutoff = 950.0 [80.0, 8000.0];\nparam float detune = 0.35 [0.0, 1.0];\nparam float subLevel = 0.65 [0.0, 1.0];\nparam float chorusRate = 0.45 [0.1, 5.0];\nparam float drive = 2.2 [1.0, 5.0];\nstate float phase1 = 0;\nstate float phase2 = 0;\nstate float phase3 = 0;\nstate float phaseSub = 0;\nstate float env = 0;\nstate float lfo = 0;\nstate float s1 = 0;\nstate float s2 = 0;\nstate float s3 = 0;\nstate float s4 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv = if(target > env, env + (target - env) * 0.008, env - env * 0.0008);\n\nlfo = (lfo + chorusRate / sr) % 1.0;\nlfoMod = sin(6.2831853 * lfo) * detune * 0.015;\n\nf0 = clamp(freq, 20.0, 2000.0) / sr;\nf1 = f0 * (1.0 + lfoMod);\nf2 = f0 * (1.0 - lfoMod * 0.85);\nfSub = f0 * 0.5;\n\nphase1 = (phase1 + f1) % 1.0;\nphase2 = (phase2 + f2) % 1.0;\nphase3 = (phase3 + f0 * 1.5) % 1.0;\nphaseSub = (phaseSub + fSub) % 1.0;\n\nsaw1 = phase1 * 2.0 - 1.0;\nsaw2 = phase2 * 2.0 - 1.0;\nsin3 = sin(6.2831853 * phase3);\nsub = if(phaseSub > 0.5, 0.7, -0.7);\n\nrawMix = (saw1 * 0.4 + saw2 * 0.4 + sin3 * 0.2) + sub * subLevel;\nu = rawMix * drive;\nsatIn = u / (1.0 + abs(u) * 0.28);\n\nfFilt = clamp(cutoff / sr * 2.2, 0.005, 0.45);\ns1 = s1 + fFilt * (satIn - s1);\ns2 = s2 + fFilt * (s1 - s2);\ns3 = s3 + fFilt * (s2 - s3);\ns4 = s4 + fFilt * (s3 - s4);\n\nout = s4 * env;\n",
    "params": {
      "cutoff": 950.0,
      "detune": 0.35,
      "subLevel": 0.65,
      "chorusRate": 0.45,
      "drive": 2.2
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
