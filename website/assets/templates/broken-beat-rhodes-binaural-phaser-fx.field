{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Broken Beat Rhodes Binaural Phaser FX",
    "author": "Infinite",
    "description": "Six-stage cascaded allpass phaser with asymmetric LFO sweep, resonant notch feedback, and warm electric-piano preamp saturation.",
    "domain": "effect"
  },
  "device": {
    "code": "param float rate = 0.55 [0.05, 4.0];\nparam float depth = 0.72 [0.1, 1.0];\nparam float feedback = 0.48 [0.0, 0.85];\nparam float warmth = 1.45 [0.8, 2.8];\nparam float mix = 0.65 [0.0, 1.0];\nstate float lfo = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float ap5 = 0;\nstate float ap6 = 0;\nstate float fb = 0;\n\nlfo = (lfo + rate / sr) % 1.0;\nsweep = 0.5 + 0.5 * sin(6.2831853 * lfo);\ng = clamp(-0.25 + (sweep - 0.5) * depth * 1.15, -0.88, 0.88);\n\nx = in + fb * feedback;\ny1 = -g * x + ap1; ap1 = x + g * y1;\ny2 = -g * y1 + ap2; ap2 = y1 + g * y2;\ny3 = -g * y2 + ap3; ap3 = y2 + g * y3;\ny4 = -g * y3 + ap4; ap4 = y3 + g * y4;\ny5 = -g * y4 + ap5; ap5 = y4 + g * y5;\ny6 = -g * y5 + ap6; ap6 = y5 + g * y6;\n\ndriven = y6 * (warmth * 0.78);\nsat = driven / (1.0 + abs(driven) * 0.52);\nfb = clamp(sat, -0.85, 0.85);\n\nout = (in * (1.0 - mix) + sat * mix) * 0.74;\n",
    "params": {
      "rate": 0.55,
      "depth": 0.72,
      "feedback": 0.48,
      "warmth": 1.45,
      "mix": 0.65
    }
  }
}
