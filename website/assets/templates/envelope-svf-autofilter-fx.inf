node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float baseHz = 380.0 [120.0, 1400.0];\nparam float sweepHz = 2800.0 [400.0, 6000.0];\nparam float resonance = 0.62 [0.1, 0.9];\nparam float sens = 2.4 [0.5, 5.0];\nparam float mix = 0.85 [0.0, 1.0];\nstate float env = 0; state float lp = 0; state float bp = 0;\n\nlvl = abs(in);\nenv = if(lvl > env, env + (lvl - env) * 0.015, env + (lvl - env) * 0.00045);\n\nfc = clamp(baseHz + clamp(env * sens, 0.0, 1.0) * sweepHz, 120.0, 7200.0);\ng = clamp(2.0 * sin(3.14159265 * fc / sr), 0.02, 0.78);\nq = clamp(1.2 - resonance * 0.95, 0.15, 1.2);\n\nhp = in - lp - q * bp;\nbp = bp + g * hp;\nlp = lp + g * bp;\n\nwet = (lp * 0.65 + bp * 0.55) / (1.0 + abs(bp) * 0.35);\nout = (in * (1.0 - mix) + wet * mix) * 0.74;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1080 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Envelope SVF Autofilter FX. Dual-ballistics envelope follower sweeping a resonant state-variable bandpass and lowpass filter with harmonic warmth.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
