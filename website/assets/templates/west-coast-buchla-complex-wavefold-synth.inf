infinite-patch 1
# West Coast Buchla Complex Wavefold Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 48
  i note2 52
  i note3 55
  i note4 48
  i note5 50
  i note6 58
  i note7 55
  i note8 48
  i note9 48
  i note10 52
  i note11 54
  i note12 48
  i note13 60
  i note14 55
  i note15 48
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float fold = 2.6 [1.0, 5.5];\nparam float fmIndex = 1.15 [0.0, 3.5];\nparam float modRatio = 1.5 [0.5, 4.0];\nparam float lpgDecay = 0.55 [0.12, 1.8];\nparam float symmetry = 0.18 [0.0, 0.6];\nstate float pCar = 0;\nstate float pMod = 0;\nstate float pSub = 0;\nstate float env = 0;\nstate float lpgLp1 = 0;\nstate float lpgLp2 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * lpgDecay), 0.0001, 0.03);\nenv = if(target > env, env + (target - env) * 0.11, env - env * decayRate);\n\nf0 = clamp(freq, 35.0, 2400.0);\npCar = (pCar + f0 / sr) % 1.0;\npMod = (pMod + (f0 * modRatio) / sr) % 1.0;\npSub = (pSub + (f0 * 0.5) / sr) % 1.0;\n\n# Complex oscillator PM + trigonometric wavefolder\nmodWave = sin(6.2831853 * pMod) * fmIndex * env;\ncarWave = sin(6.2831853 * pCar + modWave) + symmetry * env;\nfoldGain = 1.0 + fold * env;\nfolded = sin(carWave * foldGain) + 0.35 * sin(carWave * foldGain * 2.0);\nbody = sin(6.2831853 * pSub) * 0.35 + folded * 0.65;\n\n# Vactrol-inspired coupled low-pass gate\nfCut = clamp((180.0 + env * env * 4200.0) / sr * 3.14, 0.01, 0.44);\nlpgLp1 = lpgLp1 + fCut * (body - lpgLp1);\nlpgLp2 = lpgLp2 + fCut * (lpgLp1 - lpgLp2);\n\nsat = (lpgLp2 * 1.45) / (1.0 + abs(lpgLp2 * 1.45) * 0.42);\nout = sat * env * 0.52;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.24 0.34
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text West Coast Buchla Complex Wavefold Synth. Dual-oscillator PM/FM complex wavefolder with multi-stage trigonometric folding and vactrol low-pass gate decay.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
