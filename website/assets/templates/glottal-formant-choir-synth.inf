infinite-patch 1
# Glottal Formant Choir Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 52
  i note2 54
  i note3 57
  i note4 59
  i note5 57
  i note6 54
  i note7 52
  i note8 50
  i note9 57
  i note10 59
  i note11 62
  i note12 59
  i note13 57
  i note14 54
