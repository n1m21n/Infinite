node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float vowel = 0.42 [0.0, 1.0];\nparam float formantQ = 0.28 [0.08, 0.65];\nparam float vibDepth = 0.006 [0.0, 0.025];\nparam float brilliance = 0.65 [0.1, 1.0];\nparam float drive = 1.4 [0.6, 2.8];\nstate float p = 0; state float lfo = 0; state float env = 0;\nstate float bp = 0; state float lp = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.025, env * 0.9994);\nlfo = (lfo + 5.2 / sr) % 1.0;\np = (p + clamp(freq * (1.0 + sin(6.2831853 * lfo) * vibDepth), 40.0, 4200.0) / sr) % 1.0;\n\n# FOF-style raised-cosine glottal burst + harmonic formant carrier\nwin = 0.5 - 0.5 * cos(6.2831853 * p);\nfof = sin(6.2831853 * (3.0 + vowel * 5.0) * p) * win;\nsrc = (sin(6.2831853 * p) * 0.5 + fof * brilliance) * env;\n\ng = clamp(2.0 * sin(3.14159265 * (550.0 + vowel * 1350.0) / sr), 0.02, 0.85);\nhp = src - lp - formantQ * bp;\nbp = bp + g * hp;\nlp = lp + g * bp;\n\nmixSig = (bp * 0.68 + lp * 0.42) * drive;\nout = (mixSig / (1.0 + abs(mixSig) * 0.72)) * 0.70;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Glottal Formant Choir Synth. Pitch-tracked glottal pulse and three-band parallel state-variable vowel formant synthesizer with subtle vibrato and warm saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
