infinite-patch 1
# Serge Slope Wavefolder Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 43
  i note1 46
  i note2 50
  i note3 53
  i note4 55
  i note5 53
  i note6 50
  i note7 46
  i note8 43
  i note9 50
  i note10 58
  i note11 55
  i note12 53
  i note13 50
  i note14 48
  i note15 46
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
