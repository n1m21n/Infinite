node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float fold = 2.8 [1.0, 6.0];\nparam float subMix = 0.42 [0.0, 1.0];\nparam float slopeEnv = 0.75 [0.0, 1.0];\nparam float decay = 0.9991 [0.996, 0.9997];\nstate float p = 0; state float psub = 0; state float env = 0; state float lp = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.09, env * decay);\nfc = clamp(freq, 36.0, 3200.0);\np = (p + fc / sr) % 1.0;\npsub = (psub + (fc * 0.5) / sr) % 1.0;\n\ntri = 1.0 - 4.0 * abs(p - 0.5);\nsub = sin(6.2831853 * psub) * subMix;\ndrive = fold * (0.4 + slopeEnv * env * 0.9);\nw1 = sin((tri + sub * 0.45) * drive);\nw2 = sin(w1 * 2.1 + 0.35 * sin(w1 * 3.0));\n\ncut = 260.0 + 4800.0 * env * env;\ng = clamp(2.0 * sin(3.14159265 * cut / sr), 0.04, 0.82);\nlp = lp + g * (w2 * env - lp);\n\nout = (lp / (1.0 + abs(lp))) * 0.68;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.89 0.66 0.11
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Serge Slope Wavefolder Synth. West-Coast patch-programmable dual-slope envelope driving a 4-stage trigonometric wavefolder with sub-octave divider and soft analog saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
