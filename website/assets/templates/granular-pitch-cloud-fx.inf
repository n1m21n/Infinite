infinite-patch 1
# Granular Pitch Cloud FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 53
  i note2 57
  i note3 60
  i note4 62
  i note5 60
  i note6 57
  i note7 53
  i note8 50
  i note9 57
  i note10 60
  i note11 64
  i note12 60
  i note13 57
  i note14 53
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 320 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 640 1024
  s code param float grainRate = 4.5 [1.0, 14.0];\nparam float drift = 0.58 [0.0, 1.0];\nparam float feedback = 0.54 [0.0, 0.80];\nparam float dampHz = 3400.0 [900.0, 7500.0];\nparam float mix = 0.66 [0.0, 1.0];\nstate float gPh1 = 0; state float gPh2 = 0.5;\nstate float ap1 = 0; state float ap2 = 0; state float ap3 = 0;\nstate float lp1 = 0; state float fb = 0;\n\ngPh1 = (gPh1 + grainRate / sr) % 1.0;\ngPh2 = (gPh2 + grainRate / sr) % 1.0;\n\nw1 = 0.5 - 0.5 * cos(6.2831853 * gPh1);\nw2 = 0.5 - 0.5 * cos(6.2831853 * gPh2);\n\nsrc = in + fb * feedback;\nc1 = clamp(0.45 + sin(6.2831853 * gPh1) * 0.36 * drift, 0.08, 0.88);\nc2 = clamp(0.45 - cos(6.2831853 * gPh2) * 0.36 * drift, 0.08, 0.88);\n\ny1 = -c1 * src + ap1; ap1 = src + c1 * y1;\ny2 = -c2 * src + ap2; ap2 = src + c2 * y2;\ny3 = -0.62 * (y1 * w1 + y2 * w2) + ap3; ap3 = (y1 * w1 + y2 * w2) + 0.62 * y3;\n\ng = clamp(2.0 * sin(3.14159265 * dampHz / sr), 0.04, 0.85);\nlp1 = lp1 + g * (y3 - lp1);\nfbDrv = lp1 * 1.15;\nfb = fbDrv / (1.0 + abs(fbDrv));\n\nout = (in * (1.0 - mix) + lp1 * mix) * 0.72;\n
end
node 4 Utility Audio Out
  id speakers
  pos 960 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Granular Pitch Cloud FX. Dual-window Hann-enveloped granular micro-delay cloud with modulated allpass pitch drift, resonant feedback diffusion, and warm damping.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
