{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Gamelan Polyrhythm Pelog Metallophone Synth",
    "author": "Infinite",
    "description": "Paired bronze gamelan metallophone with Euler-Bernoulli bar partials, ombak detuned beating, mallet strike transient, and bamboo resonator warmth.",
    "domain": "synth"
  },
  "device": {
    "code": "param float ombak = 2.8 [0.2, 8.0];\nparam float mallet = 0.72 [0.1, 1.0];\nparam float decay = 0.55 [0.15, 0.95];\nparam float bronze = 1.45 [0.8, 2.8];\nstate float p1 = 0;\nstate float p1b = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float env = 0;\nstate float malletEnv = 0;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecRate = clamp(1.0 / (sr * (0.28 + decay * 1.55)), 0.0001, 0.02);\nenv = if(target > env, env + (target - env) * 0.28, env - env * decRate);\nmalletEnv = if(target > 0.5, malletEnv + (1.0 - malletEnv) * 0.35, malletEnv * 0.996);\n\nf0 = clamp(freq, 65.0, 2400.0);\np1 = (p1 + f0 / sr) % 1.0;\np1b = (p1b + (f0 + ombak) / sr) % 1.0;\np2 = (p2 + (f0 * 2.756) / sr) % 1.0;\np3 = (p3 + (f0 * 5.404) / sr) % 1.0;\n\nbarFund = (sin(6.2831853 * p1) + sin(6.2831853 * p1b)) * 0.38;\nbarUpper = sin(6.2831853 * p2) * (0.28 * mallet) + sin(6.2831853 * p3) * (0.14 * mallet * malletEnv);\nsig = barFund + barUpper;\n\nfCut = clamp(0.05 + env * 0.35 * mallet, 0.03, 0.45);\nlp = lp + fCut * (sig - lp);\n\nsat = (lp * bronze) / (1.0 + abs(lp * bronze) * 0.45);\nout = sat * env * 0.58;\n",
    "params": {
      "ombak": 2.8,
      "mallet": 0.72,
      "decay": 0.55,
      "bronze": 1.45
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
