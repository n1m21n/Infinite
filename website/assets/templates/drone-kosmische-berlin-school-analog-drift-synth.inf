infinite-patch 1
# Drone Kosmische Berlin School Analog Drift Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 48
  i note2 55
  i note3 52
  i note4 48
  i note5 55
  i note6 53
  i note7 55
  i note8 43
  i note9 43
  i note10 50
  i note11 48
  i note12 41
  i note13 45
  i note14 50
  i note15 52
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 0.58 [0.1, 1.0]\nparam float resonance = 0.32 [0.1, 0.88]\nparam float drift = 0.45 [0.0, 1.0]\nparam float subOctave = 0.55 [0.0, 1.0]\nparam float warmth = 0.40 [0.0, 1.0]\nstate float p1 = 0\nstate float p2 = 0\nstate float p3 = 0\nstate float env = 0\nstate float s1 = 0\nstate float s2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * 1.8), 0.00005, 0.05)\nenv = if(target > env, env + (target - env) * 0.96, env - env * decayRate)\n\ndp = freq / sr\np1 = (p1 + dp) % 1.0\nsaw1 = p1 * 2.0 - 1.0\n\np2 = (p2 + dp * (1.002 + drift * 0.004)) % 1.0\nsaw2 = p2 * 2.0 - 1.0\n\np3 = (p3 + dp * 0.5) % 1.0\nsubTri = abs(p3 * 2.0 - 1.0) * 2.0 - 1.0\n\nsig = (saw1 * 0.42 + saw2 * 0.38 + subTri * subOctave * 0.50) * 1.15\n\nfNorm = clamp(cutoff * 0.16 + env * 0.22, 0.015, 0.42)\nkRes = clamp(resonance * 1.45, 0.1, 1.75)\n\ns1 = s1 + fNorm * (sig - s2 * kRes - s1)\ns2 = s2 + fNorm * (s1 - s2)\n\nsat = (s2 / (1.0 + abs(s2 * (0.25 + warmth * 0.25)))) * env\nout = sat * 0.55\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.18 0.22 0.32
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Drone Kosmische Berlin School Analog Drift Synth. Deep cosmic synthesizer modeled after vintage German Berlin School modular systems, featuring three detuned drifting analog saw/triangle oscillators, resonant ladder low-pass filtering, and slow breathing harmonic envelope.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
