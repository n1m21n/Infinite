infinite-patch 1
# Electro Robotic Pulse Bass Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 36
  i note1 36
  i note2 48
  i note3 36
  i note4 39
  i note5 36
  i note6 43
  i note7 46
  i note8 36
  i note9 36
  i note10 48
  i note11 36
  i note12 39
  i note13 41
  i note14 43
  i note15 46
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float pulseWidth = 0.35 [0.05, 0.95]\nparam float cutoff = 1400.0 [100.0, 6000.0]\nparam float resonance = 0.4 [0.0, 0.85]\nparam float subLevel = 0.55 [0.0, 1.0]\nparam float decay = 0.38 [0.05, 1.5]\nstate float phase1 = 0\nstate float subPhase = 0\nstate float env = 0\nstate float lp1 = 0\nstate float lp2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.02)\nenv = if(target > env, env + (target - env) * 0.25, env - env * decayRate)\n\nfBase = clamp(freq, 25.0, 3000.0)\nstep1 = fBase / sr\nstepSub = (fBase * 0.5) / sr\n\nphase1 = (phase1 + step1) % 1.0\nsubPhase = (subPhase + stepSub) % 1.0\n\nsq1 = if(phase1 < pulseWidth, 1.0, -1.0)\nsqSub = if(subPhase < 0.5, 1.0, -1.0) * subLevel\n\nraw = (sq1 * 0.65 + sqSub) * env\n\nfCut = clamp((cutoff + env * 1800.0) / sr * 2.5, 0.008, 0.45)\nq = clamp(resonance * 1.6, 0.0, 1.4)\nlp1 = lp1 + fCut * (raw - lp1 - q * lp2)\nlp2 = lp2 + fCut * (lp1 - lp2)\n\nu = lp2 * 1.4\nsat = clamp(u - 0.22 * u * u * u, -0.9, 0.9)\n\nout = sat * 0.32\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.12 0.35 0.58
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Electro Robotic Pulse Bass Synth. Syncopated Detroit electro bass synthesizer with variable pulse-width bite, sub-octave snap, and fast resonant cutoff punch.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
