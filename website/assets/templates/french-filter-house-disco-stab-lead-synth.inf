infinite-patch 1
# French Filter House Disco Stab Lead Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 54
  i note1 54
  i note2 54
  i note3 66
  i note4 54
  i note5 54
  i note6 54
  i note7 64
  i note8 54
  i note9 54
  i note10 54
  i note11 66
  i note12 57
  i note13 59
  i note14 61
  i note15 64
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
