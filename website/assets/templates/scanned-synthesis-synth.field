{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Scanned Synthesis Synth",
    "author": "Infinite",
    "description": "Scanned synthesis physical modeling instrument with slow finite-element kinetic mass-spring loop scanned at audio frequencies with morphing excitation.",
    "domain": "synth"
  },
  "device": {
    "code": "param float scanRate = 1.0 [0.2, 4.0];\nparam float stiffness = 0.65 [0.1, 0.98];\nparam float damping = 0.35 [0.05, 0.9];\nparam float hammerForce = 0.8 [0.1, 2.0];\nparam float brightness = 5000.0 [400.0, 14000.0];\nstate float m1 = 0;\nstate float m2 = 0;\nstate float m3 = 0;\nstate float m4 = 0;\nstate float scanPhase = 0;\nstate float env = 0;\nstate float lp = 0;\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0);\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.25, env * 0.9996);\n\nstrike = if(gate > 0.5 && env < 0.1, hammerForce, 0.0);\n\nk = stiffness * 0.45;\nd = 1.0 - damping * 0.05;\n\nacc1 = (m2 - m1) * k + strike;\nacc2 = (m1 - 2.0 * m2 + m3) * k;\nacc3 = (m2 - 2.0 * m3 + m4) * k;\nacc4 = (m3 - m4) * k;\n\nm1 = (m1 + acc1) * d;\nm2 = (m2 + acc2) * d;\nm3 = (m3 + acc3) * d;\nm4 = (m4 + acc4) * d;\n\nfStep = clamp(freq * scanRate, 20.0, 5000.0) / sr;\nscanPhase = (scanPhase + fStep) % 1.0;\n\npos = scanPhase * 4.0;\nidx = floor(pos);\nfrac = pos % 1.0;\n\ns0 = if(idx < 1.0, mix(m1, m2, frac), if(idx < 2.0, mix(m2, m3, frac), if(idx < 3.0, mix(m3, m4, frac), mix(m4, m1, frac))));\n\nsig = tanh(s0 * 2.2) * env;\n\nfCut = clamp(brightness / sr * 2.0, 0.02, 0.48);\nlp = lp + fCut * (sig - lp);\n\nout = lp * 0.85;\n",
    "params": {
      "scanRate": 1.0,
      "stiffness": 0.65,
      "damping": 0.35,
      "hammerForce": 0.8,
      "brightness": 5000.0
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
