{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Inharmonic Chime Synth",
    "author": "Infinite",
    "description": "Metallic chime and acoustic bell physical synthesis using 6 Bessel-zero plate modes, strike transient, and high-frequency acoustic air absorption.",
    "domain": "synth"
  },
  "device": {
    "code": "param float strike = 0.85 [0.0, 2.0];\nparam float damping = 0.65 [0.1, 3.0];\nparam float metallic = 0.80 [0.0, 1.5];\nparam float shimmer = 0.45 [0.0, 1.0];\nparam float decay = 1.20 [0.1, 4.0];\nparam float tone = 0.60 [0.0, 1.0];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float p4 = 0;\nstate float p5 = 0;\nstate float p6 = 0;\nstate float e1 = 0;\nstate float e2 = 0;\nstate float e3 = 0;\nstate float e4 = 0;\nstate float e5 = 0;\nstate float e6 = 0;\nstate float strikeEnv = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nstrikeEnv = if(target > strikeEnv, 1.0, strikeEnv * 0.992);\n\ndBase = clamp(1.0 / (sr * decay), 0.00002, 0.005);\ne1 = if(target > e1, 1.0, e1 - e1 * (dBase * 0.8 * damping));\ne2 = if(target > e2, 0.85, e2 - e2 * (dBase * 1.4 * damping));\ne3 = if(target > e3, 0.70, e3 - e3 * (dBase * 2.2 * damping));\ne4 = if(target > e4, 0.55, e4 - e4 * (dBase * 3.4 * damping));\ne5 = if(target > e5, 0.42, e5 - e5 * (dBase * 5.0 * damping));\ne6 = if(target > e6, 0.30, e6 - e6 * (dBase * 7.2 * damping));\n\nbaseStep = clamp(freq, 20.0, 4000.0) / sr;\np1 = (p1 + baseStep * 1.000) % 1.0;\np2 = (p2 + baseStep * (2.76 + metallic * 0.12)) % 1.0;\np3 = (p3 + baseStep * (5.40 + metallic * 0.25)) % 1.0;\np4 = (p4 + baseStep * (8.93 + metallic * 0.38)) % 1.0;\np5 = (p5 + baseStep * (13.34 + metallic * 0.52)) % 1.0;\np6 = (p6 + baseStep * (18.64 + metallic * 0.70)) % 1.0;\n\ns1 = sin(6.2831853 * p1) * e1;\ns2 = sin(6.2831853 * p2 + s1 * shimmer * 0.15) * e2;\ns3 = sin(6.2831853 * p3) * e3;\ns4 = sin(6.2831853 * p4) * e4;\ns5 = sin(6.2831853 * p5) * e5;\ns6 = sin(6.2831853 * p6) * e6;\n\nchime = s1 + s2 * 0.75 + s3 * 0.55 + s4 * 0.40 + s5 * 0.28 + s6 * 0.18;\nclick = (strikeEnv * strikeEnv) * strike * 0.35 * sin(p6 * 6.2831853);\nsat = chime / (1.0 + abs(chime) * 0.25);\n\nout = (sat * tone + click) * 0.38;\n",
    "params": {
      "strike": 0.85,
      "damping": 0.65,
      "metallic": 0.8,
      "shimmer": 0.45,
      "decay": 1.2,
      "tone": 0.6
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
