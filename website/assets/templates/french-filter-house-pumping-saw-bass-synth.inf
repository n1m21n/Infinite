infinite-patch 1
# French Filter House Pumping Saw Bass Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 42
  i note1 42
  i note2 42
  i note3 54
  i note4 42
  i note5 42
  i note6 42
  i note7 52
  i note8 42
  i note9 42
  i note10 42
  i note11 54
  i note12 45
  i note13 47
  i note14 49
  i note15 52
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 0.55 [0.1, 1.0]\nparam float resonance = 0.45 [0.0, 0.85]\nparam float subGain = 0.40 [0.0, 1.0]\nparam float drive = 0.35 [0.0, 1.0]\nparam float decayTime = 0.30 [0.05, 0.8]\nstate float p1 = 0\nstate float pSub = 0\nstate float env = 0\nstate float lp1 = 0\nstate float lp2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decayTime), 0.0001, 0.03)\nenv = if(target > env, env + (target - env) * 0.55, env - env * decayRate)\n\nfBase = clamp(freq, 35.0, 440.0)\n\ndp1 = fBase / sr\np1 = p1 + dp1\np1 = if(p1 >= 1.0, p1 - 1.0, p1)\nsaw1 = p1 * 2.0 - 1.0\n\ndpSub = (fBase * 0.5) / sr\npSub = pSub + dpSub\npSub = if(pSub >= 1.0, pSub - 1.0, pSub)\nsubSquare = if(pSub < 0.5, 0.45, -0.45)\n\nraw = saw1 * 0.65 + subSquare * subGain\n\ndrv = raw * (1.0 + drive * 1.8)\nsat = (drv / (1.0 + abs(drv))) * env\n\nfCut = clamp(cutoff * (0.15 + env * 0.35), 0.01, 0.42)\nlp1 = lp1 + fCut * (sat + lp1 * resonance * 0.5 - lp1)\nlp2 = lp2 + fCut * (lp1 - lp2)\n\nout = lp2 * 0.58\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.18 0.35
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text French Filter House Pumping Saw Bass Synth. Pumping multi-oscillator saw bass with 2-pole resonant diode ladder filter, sidechain ducking curve, and warm harmonic drive.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
