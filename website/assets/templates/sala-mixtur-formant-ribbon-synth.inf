infinite-patch 1
# Sala Mixtur Formant Ribbon Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 57
  i note1 59
  i note2 60
  i note3 64
  i note4 65
  i note5 64
  i note6 60
  i note7 59
  i note8 57
  i note9 64
  i note10 65
  i note11 69
  i note12 65
  i note13 64
  i note14 60
  i note15 59
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
