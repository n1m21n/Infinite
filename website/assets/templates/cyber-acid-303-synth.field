{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Cyber Acid 303 Synth",
    "author": "Infinite",
    "description": "Saturated diode ladder acid bassline synthesizer with accented envelope decay, nonlinear transistor feedback saturation, and resonant chirp modulation.",
    "domain": "synth"
  },
  "device": {
    "code": "param float cutoff = 1800.0 [80.0, 14000.0];\nparam float resonance = 0.88 [0.0, 0.98];\nparam float envMod = 0.75 [0.0, 1.0];\nparam float accent = 0.6 [0.0, 1.0];\nparam float drive = 2.4 [1.0, 6.0];\nstate float phase = 0;\nstate float env = 0;\nstate float s1 = 0;\nstate float s2 = 0;\nstate float s3 = 0;\nstate float s4 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nenv = if(target > env, env + (target - env) * 0.04, env - env * (0.0003 + accent * 0.0004));\n\nbaseFreq = clamp(freq, 20.0, 3000.0) / sr;\nphase = (phase + baseFreq) % 1.0;\n\nsaw = (phase * 2.0 - 1.0);\npulse = if(phase > 0.5, 0.8, -0.8);\nrawOsc = saw * 0.75 + pulse * 0.25;\n\nfMod = cutoff * (1.0 + envMod * env * 3.5);\nf = clamp(fMod / sr * 2.2, 0.005, 0.44);\nkRes = resonance * 3.8;\n\nfb = s4 * kRes;\nuIn = rawOsc * drive - fb;\nsatIn = uIn / (1.0 + abs(uIn) * 0.35);\n\ns1 = s1 + f * (satIn - s1);\ns2 = s2 + f * (s1 - s2);\ns3 = s3 + f * (s2 - s3);\ns4 = s4 + f * (s3 - s4);\n\nout = s4 * env * (0.8 + accent * 0.4);\n",
    "params": {
      "cutoff": 1800.0,
      "resonance": 0.88,
      "envMod": 0.75,
      "accent": 0.6,
      "drive": 2.4
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
