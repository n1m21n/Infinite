infinite-patch 1
# IDM Crystalline Granular Bell Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 60
  i note1 60
  i note2 63
  i note3 67
  i note4 60
  i note5 63
  i note6 72
  i note7 67
  i note8 60
  i note9 60
  i note10 63
  i note11 65
  i note12 60
  i note13 72
  i note14 67
  i note15 60
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
