infinite-patch 1
# Diode Ladder Overdrive FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  b en0 1
  f vel0 0.86
  i note1 48
  b en1 1
  f vel1 0.86
  i note2 55
  b en2 1
  f vel2 0.86
  i note3 48
  b en3 1
  f vel3 0.86
  i note4 51
  b en4 1
  f vel4 0.86
  i note5 55
  b en5 1
  f vel5 0.86
  i note6 58
  b en6 1
  f vel6 0.86
  i note7 55
  b en7 1
  f vel7 0.86
  i note8 48
  b en8 1
  f vel8 0.86
  i note9 48
  b en9 1
  f vel9 0.86
  i note10 55
  b en10 1
  f vel10 0.86
  i note11 48
  b en11 1
  f vel11 0.86
  i note12 53
  b en12 1
  f vel12 0.86
  i note13 55
  b en13 1
  f vel13 0.86
  i note14 51
  b en14 1
  f vel14 0.86
  i note15 50
  b en15 1
  f vel15 0.86
end
node 2 Synths Analog
  id osc
  pos 360 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float cutoffHz = 1450.0 [220.0, 5500.0];\nparam float resonance = 0.48 [0.0, 0.88];\nparam float drive = 2.2 [0.8, 5.0];\nparam float bias = 0.14 [0.0, 0.4];\nparam float mix = 0.82 [0.0, 1.0];\nstate float s1 = 0; state float s2 = 0; state float s3 = 0; state float s4 = 0;\n\ng = clamp(2.0 * sin(3.14159265 * cutoffHz / sr), 0.02, 0.72);\nk = resonance * 3.1;\n\nx = in * drive + bias - k * s4;\nsatX = x / (1.0 + abs(x) * 0.65);\n\ns1 = s1 + g * (satX - s1);\ns2 = s2 + g * (s1 / (1.0 + abs(s1) * 0.25) - s2);\ns3 = s3 + g * (s2 / (1.0 + abs(s2) * 0.25) - s3);\ns4 = s4 + g * (s3 - s4);\n\nwet = s4 / (1.0 + abs(s4) * 0.4);\nout = (in * (1.0 - mix) + wet * mix) * 0.72;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1080 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Diode Ladder Overdrive FX. Four-stage nonlinear diode ladder lowpass filter with asymmetric input saturation, resonant feedback, and dry-wet blend.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
