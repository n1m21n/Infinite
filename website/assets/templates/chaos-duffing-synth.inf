infinite-patch 1
# Chaos Duffing Synth: nonlinear Duffing oscillator with double-well chaos
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 36
  i rangeHigh 64
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float drive = 1.2 [0.1, 3.0]\nparam float stiffness = 1.0 [0.2, 2.5]\nparam float damping = 0.25 [0.05, 0.8]\nparam float cutoff = 3600.0 [200.0, 12000.0]\nparam float envDecay = 0.65 [0.05, 3.0]\nstate float pos = 0.1\nstate float vel = 0.0\nstate float drivePhase = 0\nstate float env = 0\nstate float lp = 0\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * envDecay), 0.00005, 0.02)\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.15, env - env * decayRate)\n\npStep = clamp(freq, 20.0, 4000.0) / sr\ndrivePhase = (drivePhase + pStep) % 1.0\n\nextForce = sin(6.2831853 * drivePhase) * drive\ndt = clamp(pStep * 6.2831853, 0.001, 0.35)\n\nacc = pos - stiffness * pos * pos * pos - damping * vel + extForce\nvel = clamp(vel + acc * dt, -4.0, 4.0)\npos = clamp(pos + vel * dt, -3.0, 3.0)\n\nraw = pos * 0.6 * env\n\nfCut = clamp(cutoff / sr * 2.0, 0.01, 0.46)\nlp = lp + fCut * (raw - lp)\n\nout = lp * 0.82\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Chaos Duffing Synth. Nonlinear Duffing oscillator with double-potential-well chaos.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
