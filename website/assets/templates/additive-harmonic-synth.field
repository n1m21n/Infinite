{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Additive Harmonic Synth",
    "author": "Infinite",
    "description": "Eight-partial additive harmonic overtone generator with continuous spectral tilt, odd/even balance, shimmer emphasis and analog saturation.",
    "domain": "synth"
  },
  "device": {
    "code": "param float tilt = 1.25 [0.4, 3.0];\nparam float oddEven = 0.5 [0.0, 1.0];\nparam float shimmer = 0.35 [0.0, 1.0];\nparam float decay = 2.2 [0.1, 6.0];\nparam float warmth = 1.35 [1.0, 3.5];\nstate float phase = 0;\nstate float ampEnv = 0;\nstate float tiltEnv = 0;\nstate float lp = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\nampDecayRate = clamp(1.0 / (sr * decay), 0.00002, 0.02);\ntiltDecayRate = clamp(1.0 / (sr * (decay * 0.6)), 0.00003, 0.025);\nampEnv = if(target > ampEnv, ampEnv + (target - ampEnv) * 0.18, ampEnv - ampEnv * ampDecayRate);\ntiltEnv = if(target > tiltEnv, tiltEnv + (target - tiltEnv) * 0.22, tiltEnv - tiltEnv * tiltDecayRate);\n\nf0 = clamp(freq, 20.0, 5000.0);\nstep = f0 / sr;\nphase = (phase + step) % 1.0;\n\ncurTilt = tilt + tiltEnv * 0.45;\nevenScale = (1.0 - oddEven) * 2.0;\noddScale = oddEven * 2.0;\n\nh1 = sin(6.2831853 * phase) * oddScale;\nh2 = sin(12.5663706 * phase) * (pow(2.0, -curTilt) * evenScale);\nh3 = sin(18.8495559 * phase) * (pow(3.0, -curTilt) * oddScale);\nh4 = sin(25.1327412 * phase) * (pow(4.0, -curTilt) * evenScale);\nh5 = sin(31.4159265 * phase) * (pow(5.0, -curTilt) * oddScale);\nh6 = sin(37.6991118 * phase) * (pow(6.0, -curTilt) * evenScale);\nh7 = sin(43.9822971 * phase) * (pow(7.0, -curTilt) * (oddScale + shimmer * 1.5));\nh8 = sin(50.2654824 * phase) * (pow(8.0, -curTilt) * (evenScale + shimmer * 1.5));\n\nraw = (h1 + h2 + h3 + h4 + h5 + h6 + h7 + h8) * (warmth * 0.55);\nsat = raw / (1.0 + abs(raw) * 0.22);\n\nlp = lp + 0.42 * (sat - lp);\nout = lp * ampEnv * 0.52;\n",
    "params": {
      "tilt": 1.25,
      "oddEven": 0.5,
      "shimmer": 0.35,
      "decay": 2.2,
      "warmth": 1.35
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}