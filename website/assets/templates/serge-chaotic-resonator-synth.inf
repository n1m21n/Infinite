node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float crossFm = 1.9 [0.0, 4.5];\nparam float pingHz = 520.0 [180.0, 1600.0];\nparam float damp = 0.42 [0.15, 0.85];\nparam float decay = 0.9992 [0.996, 0.9997];\nparam float drive = 1.4 [0.6, 2.8];\nstate float p1 = 0; state float p2 = 0;\nstate float env = 0; state float bp = 0; state float lp = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.32, env * decay);\nf0 = clamp(freq, 45.0, 4000.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 2.414) / sr) % 1.0;\n\nw2 = sin(6.2831853 * p2);\nw1 = sin(6.2831853 * p1 + w2 * crossFm * env);\nfolded = sin(w1 * 2.6) * env;\n\ng = clamp(2.0 * sin(3.14159265 * pingHz / sr), 0.02, 0.74);\nbp = bp + g * (folded - lp - damp * bp);\nlp = lp + g * bp;\nsig = (folded * 0.45 + bp * 0.72) * drive;\nout = (sig / (1.0 + abs(sig) * 0.56)) * 0.54;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.72 0.22 0.20
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Serge Chaotic Resonator Synth. Cross-coupled inharmonic FM and wavefolding driving a tuned state-variable bandpass ping resonator.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
