infinite-patch 1
# Electro Cybernetic Sync Lead Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 48
  i note4 51
  i note5 48
  i note6 55
  i note7 58
  i note8 48
  i note9 48
  i note10 60
  i note11 48
  i note12 51
  i note13 53
  i note14 55
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float syncRatio = 2.4 [1.0, 5.0]\nparam float cutoff = 2200.0 [200.0, 7500.0]\nparam float decay = 0.42 [0.05, 1.8]\nparam float resonance = 0.45 [0.0, 0.85]\nparam float drive = 1.35 [0.5, 3.0]\nstate float masterPhase = 0\nstate float slavePhase = 0\nstate float env = 0\nstate float lp1 = 0\nstate float lp2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00004, 0.02)\nenv = if(target > env, env + (target - env) * 0.2, env - env * decayRate)\n\nfBase = clamp(freq, 40.0, 4000.0)\nstepMaster = fBase / sr\nstepSlave = (fBase * (syncRatio + env * 1.5)) / sr\n\nnewMaster = masterPhase + stepMaster\nmasterPhase = newMaster % 1.0\n\nslavePhase = if(newMaster >= 1.0, 0.0, (slavePhase + stepSlave) % 1.0)\n\nsawSlave = slavePhase * 2.0 - 1.0\nsquareMaster = if(masterPhase < 0.5, 0.4, -0.4)\n\nraw = (sawSlave * 0.75 + squareMaster * 0.25) * env\n\nu = raw * drive\nsat = clamp(u - 0.2 * u * u * u, -0.95, 0.95)\n\nfCut = clamp(cutoff / sr * 2.8, 0.01, 0.45)\nq = clamp(resonance * 1.4, 0.0, 1.3)\nlp1 = lp1 + fCut * (sat - lp1 - q * lp2)\nlp2 = lp2 + fCut * (lp1 - lp2)\n\nout = lp2 * 0.35\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.12 0.35 0.58
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Electro Cybernetic Sync Lead Synth. Sharp hard-sync machine lead synthesizer with metallic harmonic bite, glide articulation, and punchy stereo width.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
