infinite-patch 1
# Ambient Piano Tape Flutter Delay FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float delayTime = 0.50 [0.1, 1.0]\nparam float flutter = 0.40 [0.0, 1.0]\nparam float tone = 0.52 [0.1, 1.0]\nparam float feedback = 0.45 [0.0, 0.85]\nparam float mix = 0.55 [0.0, 1.0]\nstate float lfo = 0\nstate float d1 = 0\nstate float d2 = 0\nstate float d3 = 0\nstate float lp = 0\n\nlfo = (lfo + 3.8 / sr) % 1.0\nflutterMod = sin(lfo * 6.28318) * flutter * 0.08\n\nkRate = clamp(0.10 * (1.0 + delayTime * 0.8) + flutterMod, 0.03, 0.35)\nfTone = clamp(0.06 + tone * 0.35, 0.02, 0.45)\n\ninSat = in / (1.0 + abs(in * 0.25))\nfbIn = inSat + d3 * feedback * 0.75\n\nlp = lp + fTone * (fbIn - lp)\n\nd1 = d1 + kRate * (lp - d1)\nd2 = d2 + kRate * 0.88 * (d1 - d2)\nd3 = d3 + kRate * 0.78 * (d2 - d3)\n\ndelaySig = (d2 * 0.65 + d3 * 0.55)\nprocessed = in * (1.0 - mix) + delaySig * mix\nout = processed * 0.68\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Ambient Piano Tape Flutter Delay FX. Warm vintage magnetic tape delay with slow capstan wow-and-flutter pitch modulation, resonant tone damping, and decaying tape saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
