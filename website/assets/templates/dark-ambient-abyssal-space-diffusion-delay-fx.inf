  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float decay = 0.58 [0.1, 0.92]\nparam float tone = 0.42 [0.1, 1.0]\nparam float size = 0.65 [0.1, 1.0]\nparam float diffusion = 0.50 [0.0, 1.0]\nparam float mix = 0.55 [0.0, 1.0]\nstate float a1 = 0\nstate float a2 = 0\nstate float a3 = 0\nstate float a4 = 0\nstate float lp = 0\n\nfTone = clamp(0.04 + tone * 0.32, 0.015, 0.42)\nlp = lp + fTone * (in - lp)\n\nkDiff = clamp(0.10 * (1.0 + size * 0.85), 0.03, 0.36)\nkDecay = clamp(decay * 0.84, 0.1, 0.88)\n\na1 = a1 + kDiff * (lp + a4 * kDecay - a1)\na2 = a2 + kDiff * 0.82 * (a1 - a2)\na3 = a3 + kDiff * 0.70 * (a2 - a3)\na4 = a4 + kDiff * 0.60 * (a3 - a4)\n\ndiffSig = (a2 * 0.55 + a3 * 0.45 + a4 * 0.75) * (1.0 + diffusion * 0.5)\nsat = diffSig / (1.0 + abs(diffSig * 0.28))\nprocessed = in * (1.0 - mix) + sat * mix\nout = processed * 0.72\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Dark Ambient Abyssal Space Diffusion Delay FX. Abyssal dark ambient space diffusion reverberator featuring multi-stage allpass delay network, dark spectral air damping, and decaying cavernous reflections.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
