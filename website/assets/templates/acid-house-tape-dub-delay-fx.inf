infinite-patch 1
# Acid House Tape Dub Delay FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 41
  i note1 41
  i note2 53
  i note3 48
  i note4 41
  i note5 53
  i note6 46
  i note7 48
  i note8 41
  i note9 41
  i note10 53
  i note11 48
  i note12 41
  i note13 53
  i note14 46
  i note15 51
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2800.0
  f resonance 0.25
  f decay 0.35
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float feedback = 0.54 [0.0, 0.82];\nparam float damping = 0.44 [0.1, 0.92];\nparam float drive = 1.45 [1.0, 3.5];\nparam float mix = 0.52 [0.0, 1.0];\nstate float tap1 = 0;\nstate float tap2 = 0;\nstate float tap3 = 0;\nstate float lp = 0;\n\nfCut = clamp(0.12 + (1.0 - damping) * 0.28, 0.03, 0.42);\nlp = lp + fCut * (in - lp);\n\ntap1 = tap1 + 0.072 * (lp + tap3 * feedback * 0.52 - tap1);\ntap2 = tap2 + 0.056 * (tap1 - tap2);\ntap3 = tap3 + 0.046 * (tap2 - tap3);\n\necho = (tap1 * 0.45 + tap2 * 0.35 + tap3 * 0.25) * drive;\nsat = echo / (1.0 + abs(echo) * 0.38);\n\nprocessed = in * (1.0 - mix) + sat * mix;\nout = processed * 0.94;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.26 0.16 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House Tape Dub Delay FX. Multi-tap acid dub delay with resonant feedback, high-frequency damping, and warm drive.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
