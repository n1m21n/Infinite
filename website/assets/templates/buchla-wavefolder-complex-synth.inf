infinite-patch 1
# Buchla Wavefolder Complex Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 51
  i note2 55
  i note3 58
  i note4 60
  i note5 58
  i note6 55
  i note7 51
  i note8 48
  i note9 55
  i note10 62
  i note11 63
  i note12 60
  i note13 58
  i note14 55
  i note15 51
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float ratio = 1.5 [0.5, 4.0];\nparam float fmIndex = 1.35 [0.0, 4.0];\nparam float fold = 2.6 [1.0, 5.5];\nparam float timbreEnv = 0.65 [0.0, 1.0];\nparam float decay = 0.9992 [0.996, 0.9997];\nstate float pc = 0; state float pm = 0; state float env = 0; state float lp1 = 0;\n\nenv = if(gate > 0.5, env + (1.0 - env) * 0.08, env * decay);\nfc = clamp(freq, 40.0, 3200.0);\nfm = clamp(fc * ratio, 40.0, 8000.0);\npc = (pc + fc / sr) % 1.0;\npm = (pm + fm / sr) % 1.0;\n\nmodSig = sin(6.2831853 * pm) * fmIndex * (0.35 + 0.65 * env);\ncar = sin(6.2831853 * pc + modSig);\n\ndrive = fold * (0.45 + timbreEnv * env * 0.85);\nw1 = sin(car * drive + 0.45 * sin(car * drive * 2.0));\nw2 = sin(w1 * 1.85 + 0.3 * sin(w1 * 3.0));\n\ncutHz = 320.0 + 5200.0 * env * env;\ng = clamp(2.0 * sin(3.14159265 * cutHz / sr), 0.04, 0.85);\nlp1 = lp1 + g * (w2 * env - lp1);\n\ndrv = lp1 * 1.25;\nout = (drv / (1.0 + abs(drv))) * 0.65;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Buchla Wavefolder Complex Synth. West-coast complex oscillator pairing linear FM modulation with a multi-stage trigonometric wavefolder and vactrol-style lowpass gate.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
