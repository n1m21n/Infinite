infinite-patch 1
# Balearic Dub Phaser Echo FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 55
  i note2 52
  i note3 48
  i note4 55
  i note5 60
  i note6 57
  i note7 55
  i note8 46
  i note9 53
  i note10 50
  i note11 46
  i note12 53
  i note13 58
  i note14 55
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2600.0
  f resonance 0.22
  f decay 0.52
  f volume 0.82
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float sweepHz = 0.28 [0.05, 2.4];\nparam float depth = 0.72 [0.1, 0.92];\nparam float resHz = 780.0 [200.0, 3200.0];\nparam float feedback = 0.48 [0.0, 0.82];\nparam float mix = 0.82 [0.0, 1.0];\nstate float a1 = 0; state float a2 = 0; state float a3 = 0; state float a4 = 0;\nstate float bp = 0; state float lp = 0; state float fb = 0; state float lfo = 0;\n\nlfo = (lfo + sweepHz / sr) % 1.0;\nc = clamp(0.45 + 0.42 * depth * sin(6.2831853 * lfo), 0.08, 0.90);\nx = in + fb * feedback;\ny1 = -c * x + a1; a1 = x + c * y1;\ny2 = -c * y1 + a2; a2 = y1 + c * y2;\ny3 = -c * y2 + a3; a3 = y2 + c * y3;\ny4 = -c * y3 + a4; a4 = y3 + c * y4;\n\ng = clamp(2.0 * sin(3.14159265 * resHz / sr), 0.02, 0.82);\nbp = bp + g * (y4 - lp - 0.55 * bp);\nlp = lp + g * bp;\nfb = clamp(bp * 0.65 + y4 * 0.35, -1.1, 1.1);\n\nwet = (y4 * 0.65 + bp * 0.45) / (1.0 + abs(y4) * 0.55);\nout = (in * (1.0 - mix) + wet * mix) * 0.84;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.22 0.34 0.42
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Balearic Dub Phaser Echo FX. Balearic sunset dub 4-stage allpass phaser and resonant bandpass echo chamber with slow LFO sweep and warm console saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
