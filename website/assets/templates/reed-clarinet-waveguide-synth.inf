infinite-patch 1
# Reed Clarinet Waveguide Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 60
  b en0 1
  f vel0 0.86
  i note1 63
  b en1 1
  f vel1 0.86
  i note2 67
  b en2 1
  f vel2 0.86
  i note3 70
  b en3 1
  f vel3 0.86
  i note4 67
  b en4 1
  f vel4 0.86
  i note5 65
  b en5 1
  f vel5 0.86
  i note6 63
  b en6 1
  f vel6 0.86
  i note7 60
  b en7 1
  f vel7 0.86
  i note8 58
  b en8 1
  f vel8 0.86
  i note9 60
  b en9 1
  f vel9 0.86
  i note10 63
  b en10 1
  f vel10 0.86
  i note11 67
  b en11 1
  f vel11 0.86
