infinite-patch 1
# Dimension Spatial Chorus FX: multi-stage bucket brigade chorus with out-of-phase LFO modulation
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 76
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float rate = 0.45 [0.05, 3.0]\nparam float depth = 0.65 [0.0, 1.5]\nparam float spatial = 0.80 [0.0, 1.5]\nparam float feedback = 0.35 [0.0, 0.85]\nparam float tone = 0.60 [0.0, 1.0]\nparam float mix = 0.75 [0.0, 1.0]\nstate float lfoPhase = 0\nstate float bbdL1 = 0\nstate float bbdL2 = 0\nstate float bbdL3 = 0\nstate float bbdL4 = 0\nstate float bbdR1 = 0\nstate float bbdR2 = 0\nstate float bbdR3 = 0\nstate float bbdR4 = 0\nstate float fbL = 0\nstate float fbR = 0\nstate float lpTone = 0\n\nlfoStep = clamp(rate, 0.05, 10.0) / sr\nlfoPhase = (lfoPhase + lfoStep) % 1.0\n\nlfoL = sin(6.2831853 * lfoPhase) * depth * 0.12\nlfoR = cos(6.2831853 * (lfoPhase + spatial * 0.25)) * depth * 0.12\n\nxL = in + fbL * feedback * 0.5 - fbR * spatial * 0.2\nxR = in + fbR * feedback * 0.5 - fbL * spatial * 0.2\n\ncoeffL = clamp(0.18 + lfoL, 0.02, 0.45)\nbbdL1 = bbdL1 + coeffL * (xL - bbdL1)\nbbdL2 = bbdL2 + coeffL * (bbdL1 - bbdL2)\nbbdL3 = bbdL3 + coeffL * (bbdL2 - bbdL3)\nbbdL4 = bbdL4 + coeffL * (bbdL3 - bbdL4)\n\ncoeffR = clamp(0.18 + lfoR, 0.02, 0.45)\nbbdR1 = bbdR1 + coeffR * (xR - bbdR1)\nbbdR2 = bbdR2 + coeffR * (bbdR1 - bbdR2)\nbbdR3 = bbdR3 + coeffR * (bbdR2 - bbdR3)\nbbdR4 = bbdR4 + coeffR * (bbdR3 - bbdR4)\n\nfbL = bbdL4\nfbR = bbdR4\n\nchorusMix = (bbdL4 + bbdR4) * 0.5\n\nfCut = clamp((1800.0 + tone * 6000.0) / sr * 2.0, 0.01, 0.45)\nlpTone = lpTone + fCut * (chorusMix - lpTone)\n\nout = in * (1.0 - mix) + lpTone * mix * 0.85\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 1 0.42 0.21
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Dimension Spatial Chorus FX. Multi-stage bucket brigade chorus with out-of-phase LFO.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
