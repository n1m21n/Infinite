infinite-patch 1
# Bowed Bar Marimba Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 55
  i note1 59
  i note2 62
  i note3 67
  i note4 62
  i note5 59
  i note6 55
  i note7 57
  i note8 60
  i note9 64
  i note10 67
  i note11 71
  i note12 67
  i note13 64
  i note14 60
  i note15 57
  b en0 1
  b en1 1
