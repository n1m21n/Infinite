node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 1800.0 [200.0, 6000.0];\nparam float res = 0.55 [0.0, 0.92];\nparam float detune = 0.012 [0.001, 0.05];\nparam float lfoRate = 0.25 [0.05, 2.0];\nparam float drive = 1.6 [1.0, 4.0];\nparam float decay = 0.45 [0.1, 1.2];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float lfo = 0;\nstate float env = 0;\nstate float s1 = 0;\nstate float s2 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * decay), 0.0001, 0.05);\nenv = if(target > env, env + (target - env) * 0.05, env - env * decayRate);\n\nlfo = (lfo + lfoRate / sr) % 1.0;\nlfoMod = sin(6.2831853 * lfo) * 450.0;\n\nstep1 = clamp(freq * (1.0 - detune), 20.0, 4000.0) / sr;\nstep2 = clamp(freq * (1.0 + detune), 20.0, 4000.0) / sr;\np1 = (p1 + step1) % 1.0;\np2 = (p2 + step2) % 1.0;\n\nsaw1 = 2.0 * p1 - 1.0;\nsaw2 = 2.0 * p2 - 1.0;\nraw = (saw1 + saw2) * 0.5;\n\nfCut = clamp((cutoff + lfoMod + env * 1200.0) / sr * 3.14, 0.01, 0.45);\nu = raw * drive - s2 * res * 1.5;\nsat = u / (1.0 + abs(u) * 0.3);\n\ns1 = s1 + fCut * (sat - s1);\ns2 = s2 + fCut * (s1 - s2);\n\nout = s2 * (0.35 + env * 0.65) * 0.28;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.18 0.22 0.32
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Jungle Atmospheric Pad Drone Synth. Haunting 90s intelligent jungle atmospheric synthesizer with detuned dual pulse-saw oscillators, slow sweeping resonant bandpass filter, and tape-saturated drone warmth.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
