infinite-patch 1
# Spectral Dub Chamber Resonant Comb FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 51
  i note2 55
  i note3 58
  i note4 48
  i note5 53
  i note6 55
  i note7 60
  i note8 46
  i note9 51
  i note10 55
  i note11 58
  i note12 48
  i note13 55
  i note14 58
  i note15 62
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 2400.0
  f resonance 0.24
  f decay 0.48
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float rate = 0.42 [0.05, 4.0];\nparam float depth = 0.68 [0.1, 1.0];\nparam float feedback = 0.52 [0.0, 0.85];\nparam float warmth = 1.50 [0.8, 2.8];\nparam float mix = 0.64 [0.0, 1.0];\nstate float lfo = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float lp = 0;\nstate float fb = 0;\n\nlfo = (lfo + rate / sr) % 1.0;\nsweep = 0.5 + 0.5 * sin(6.2831853 * lfo);\ng = clamp(-0.22 + (sweep - 0.5) * depth * 1.15, -0.86, 0.86);\n\nx = in + fb * feedback;\ny1 = -g * x + ap1; ap1 = x + g * y1;\ny2 = -g * y1 + ap2; ap2 = y1 + g * y2;\ny3 = -g * y2 + ap3; ap3 = y2 + g * y3;\ny4 = -g * y3 + ap4; ap4 = y3 + g * y4;\n\nfc = clamp(0.08 + sweep * 0.26, 0.04, 0.44);\nlp = lp + fc * (y4 - lp);\n\ndriven = lp * (warmth * 0.82);\nsat = driven / (1.0 + abs(driven) * 0.48);\nfb = clamp(sat, -0.82, 0.82);\n\nout = (in * (1.0 - mix) + sat * mix) * 0.82;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.52 0.36 0.22
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Spectral Dub Chamber Resonant Comb FX. Cascaded allpass dispersion and resonant dub filter with LFO cutoff sweep and warm tube saturation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
