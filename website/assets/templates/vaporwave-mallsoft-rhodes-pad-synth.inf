infinite-patch 1
# Vaporwave Mallsoft Rhodes Pad Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 53
  i note1 53
  i note2 57
  i note3 60
  i note4 53
  i note5 57
  i note6 64
  i note7 60
  i note8 53
  i note9 53
  i note10 57
  i note11 58
  i note12 53
  i note13 65
  i note14 60
