infinite-patch 1
# Schroeder FDN Reverb FX: 4-delay feedback delay network reverberator with Hadamard diffusion
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float decayTime = 0.78 [0.1, 0.98]\nparam float damping = 0.42 [0.05, 0.9]\nparam float diffusion = 0.65 [0.0, 1.0]\nparam float modRate = 0.8 [0.1, 5.0]\nparam float modDepth = 0.3 [0.0, 1.0]\nparam float mix = 0.45 [0.0, 1.0]\nstate float lfoPhase = 0\nstate float d1 = 0\nstate float d2 = 0\nstate float d3 = 0\nstate float d4 = 0\nstate float lp1 = 0\nstate float lp2 = 0\nstate float lp3 = 0\nstate float lp4 = 0\n\nlfoPhase = (lfoPhase + modRate / sr) % 1.0\nlfo = sin(6.2831853 * lfoPhase)\n\ncurIn = in\n\nh1 = (d1 + d2 + d3 + d4) * 0.5\nh2 = (d1 - d2 + d3 - d4) * 0.5\nh3 = (d1 + d2 - d3 - d4) * 0.5\nh4 = (d1 - d2 - d3 + d4) * 0.5\n\nfb1 = mix(d1, h1, diffusion) * decayTime\nfb2 = mix(d2, h2, diffusion) * decayTime\nfb3 = mix(d3, h3, diffusion) * decayTime\nfb4 = mix(d4, h4, diffusion) * decayTime\n\ndampCoeff = clamp(1.0 - damping * 0.6, 0.05, 0.95)\nlp1 = lp1 + (fb1 - lp1) * dampCoeff\nlp2 = lp2 + (fb2 - lp2) * dampCoeff\nlp3 = lp3 + (fb3 - lp3) * dampCoeff\nlp4 = lp4 + (fb4 - lp4) * dampCoeff\n\nrateFactor = 0.04 * (1.0 + lfo * modDepth * 0.2)\nd1 = d1 + (curIn + lp1 - d1) * (rateFactor * 1.0)\nd2 = d2 + (curIn + lp2 - d2) * (rateFactor * 1.31)\nd3 = d3 + (curIn + lp3 - d3) * (rateFactor * 1.63)\nd4 = d4 + (curIn + lp4 - d4) * (rateFactor * 1.97)\n\nwet = (d1 - d2 + d3 - d4) * 0.5\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Schroeder FDN Reverb FX. 4-delay feedback delay network reverberator with Hadamard diffusion.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
