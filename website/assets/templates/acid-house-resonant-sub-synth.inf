infinite-patch 1
# Acid House Resonant Sub Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 31
  i note1 31
  i note2 43
  i note3 38
  i note4 31
  i note5 43
  i note6 36
  i note7 38
  i note8 31
  i note9 31
  i note10 43
  i note11 38
  i note12 31
  i note13 43
  i note14 36
  i note15 41
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float subDrive = 1.8 [1.0, 4.0]\nparam float resonance = 0.65 [0.1, 0.95]\nparam float cutoff = 850.0 [80.0, 5000.0]\nparam float punch = 0.6 [0.0, 1.0]\nparam float decay = 0.45 [0.1, 2.0]\nstate float phase = 0\nstate float curFreq = 55\nstate float env = 0\nstate float pEnv = 0\nstate float lp1 = 0\nstate float lp2 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01)\nenv = if(target > env, env + (target - env) * 0.12, env - env * decayRate)\n\npEnv = if(target > pEnv, 1.0, pEnv * 0.998)\ncurFreq = curFreq + (freq * 0.5 - curFreq) * 0.1\nf0 = clamp(curFreq + pEnv * punch * 50.0, 20.0, 800.0)\n\npStep = f0 / sr\nphase = (phase + pStep) % 1.0\n\nsubSin = sin(phase * 6.2831853)\nsaw = (phase * 2.0 - 1.0) * 0.4\nraw = (subSin + saw) * env\n\nu = raw * subDrive\nsat = clamp(u * 1.3, -1.0, 1.0)\n\nfCut = clamp(cutoff / sr * 2.4, 0.005, 0.4)\ndiff = sat - lp2 * (resonance * 1.8) - lp1\nlp1 = lp1 + fCut * diff\nlp2 = lp2 + fCut * lp1\n\nout = lp2 * 0.22\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.32 0.45
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House Resonant Sub Synth. Deep resonant acid sub bass synthesizer with transistor glide, soft saturation drive, and sub-octave punch.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
