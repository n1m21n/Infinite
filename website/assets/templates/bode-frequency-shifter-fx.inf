infinite-patch 1
# Bode Frequency Shifter FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 57
  i note1 60
  i note2 64
  i note3 67
  i note4 69
  i note5 67
  i note6 64
  i note7 60
  i note8 55
  i note9 59
  i note10 62
  i note11 67
  i note12 64
  i note13 62
  i note14 60
  i note15 57
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 360 1024
  i wave1 1
  f cutoff 2400.0
  f resonance 0.25
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float shiftHz = 18.5 [-120.0, 120.0];\nparam float feedback = 0.28 [0.0, 0.65];\nparam float toneHz = 3600.0 [800.0, 8000.0];\nparam float mix = 0.65 [0.0, 1.0];\nstate float pCar = 0;\nstate float i1 = 0; state float i2 = 0;\nstate float q1 = 0; state float q2 = 0;\nstate float lp = 0; state float fb = 0;\n\npCar = (pCar + abs(shiftHz) / sr) % 1.0;\nang = 6.2831853 * pCar * if(shiftHz >= 0.0, 1.0, -1.0);\n\nx = in + fb * feedback;\n\n# Quadrature allpass Hilbert approximation pair\ncI1 = 0.6923; cI2 = 0.9360;\ncQ1 = 0.4021; cQ2 = 0.8561;\n\nyi1 = -cI1 * x + i1; i1 = x + cI1 * yi1;\nsigI = -cI2 * yi1 + i2; i2 = yi1 + cI2 * sigI;\n\nyq1 = -cQ1 * x + q1; q1 = x + cQ1 * yq1;\nsigQ = -cQ2 * yq1 + q2; q2 = yq1 + cQ2 * sigQ;\n\n# Single-sideband modulation: I*cos - Q*sin\nssb = sigI * cos(ang) - sigQ * sin(ang);\n\ng = clamp(2.0 * sin(3.14159265 * toneHz / sr), 0.05, 0.88);\nlp = lp + g * (ssb - lp);\nfb = clamp(lp, -1.0, 1.0);\n\nout = (in * (1.0 - mix) + lp * mix) * 0.62;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1080 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.24 0.30 0.36
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Bode Frequency Shifter FX. Single-sideband Hilbert quadrature frequency shifter with dual allpass phase-splitting network, carrier detune, and metallic feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
