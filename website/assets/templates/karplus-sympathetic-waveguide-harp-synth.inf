infinite-patch 1
# Karplus Sympathetic Waveguide Harp Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 50
  i note1 57
  i note2 54
  i note3 62
  i note4 50
  i note5 55
  i note6 59
  i note7 57
  i note8 50
  i note9 52
  i note10 54
  i note11 57
  i note12 50
  i note13 62
  i note14 59
  i note15 54
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float damping = 0.42 [0.1, 0.9];\nparam float pluckBright = 0.68 [0.15, 1.0];\nparam float sympathy = 0.35 [0.0, 0.8];\nparam float warmth = 1.35 [0.8, 2.5];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float pSymp = 0;\nstate float env = 0;\nstate float lp1 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * (0.25 + damping * 1.4)), 0.0001, 0.03);\nenv = if(target > env, env + (target - env) * 0.16, env - env * decayRate);\n\nf0 = clamp(freq, 45.0, 2200.0);\np1 = (p1 + f0 / sr) % 1.0;\np2 = (p2 + (f0 * 2.002) / sr) % 1.0;\npSymp = (pSymp + (f0 * 1.498) / sr) % 1.0;\n\nsig = sin(6.2831853 * p1) * 0.55 + sin(6.2831853 * p2) * (0.32 * pluckBright) + sin(6.2831853 * pSymp) * (sympathy * 0.35);\nfCut = clamp(0.03 + env * 0.36 * pluckBright, 0.02, 0.42);\nlp1 = lp1 + fCut * (sig - lp1);\n\nsat = (lp1 * warmth) / (1.0 + abs(lp1 * warmth) * 0.42);\nout = sat * env * 0.54;\n
end
node 3 Utility Audio Out
  id speakers
  pos 900 1024
end
node 4 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.24 0.34
  f size 0.24
end
node 5 Utility Output
  id out
  pos 460 0
end
node 6 Compositing Comment
  pos 0 722
  s text Karplus Sympathetic Waveguide Harp Synth. Physical-modeling plucked waveguide harp with dual harmonic comb resonators, sympathetic octave body, and wooden-bridge saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
cable out 0 pic
