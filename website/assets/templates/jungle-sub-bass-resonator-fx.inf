infinite-patch 1
# Jungle Sub Bass Resonator FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.35
  f decay 0.25
  f volume 0.8
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float centerFreq = 68.0 [40.0, 160.0]\nparam float boost = 2.2 [1.0, 4.5]\nparam float drive = 1.8 [0.8, 4.0]\nparam float tone = 2800.0 [500.0, 6000.0]\nparam float mix = 0.75 [0.0, 1.0]\nstate float subLp1 = 0\nstate float subLp2 = 0\nstate float toneLp = 0\n\nfSub = clamp(centerFreq / sr * 3.14159, 0.003, 0.1)\nsubLp1 = subLp1 + fSub * (in - subLp1)\nsubLp2 = subLp2 + fSub * (subLp1 - subLp2)\nsubBoost = subLp2 * boost\n\nhighPart = in - subLp2\nu = (highPart + subBoost * 0.5) * drive\nsat = clamp(u - 0.24 * u * u * u, -0.95, 0.95)\n\nfTone = clamp(tone / sr * 2.8, 0.02, 0.45)\ntoneLp = toneLp + fTone * (sat - toneLp)\n\nwet = subBoost * 0.55 + toneLp * 0.6\nout = (in * (1.0 - mix) + wet * mix) * 1.3\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.40 0.18 0.12
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Jungle Sub Bass Resonator FX. Heavy sound system sub-bass filter and harmonic resonator with tuned low-end boost, asymmetric saturation drive, and transient preservation.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
