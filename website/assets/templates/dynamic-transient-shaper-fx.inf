infinite-patch 1
# Dynamic Transient Shaper FX: dual-envelope transient designer and harmonic exciter
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 48
  i rangeHigh 72
end
node 2 Synths Wavetable
  id synth
  pos 360 1024
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float attackPunch = 1.4 [0.0, 3.0]\nparam float sustainTail = 1.2 [0.0, 3.0]\nparam float speed = 1.0 [0.2, 3.0]\nparam float drive = 0.3 [0.0, 1.0]\nparam float mix = 1.0 [0.0, 1.0]\nstate float fastEnv = 0\nstate float slowEnv = 0\nstate float lp = 0\n\nabsIn = abs(in)\n\nfastRate = clamp(1.0 / (0.005 * sr / speed), 0.001, 0.5)\nslowRate = clamp(1.0 / (0.06 * sr / speed), 0.0001, 0.1)\n\nfastEnv = fastEnv + if(absIn > fastEnv, 0.4, fastRate) * (absIn - fastEnv)\nslowEnv = slowEnv + if(absIn > slowEnv, 0.08, slowRate) * (absIn - slowEnv)\n\ntransientDiff = max(0.0, fastEnv - slowEnv)\nsustainWeight = max(0.0, slowEnv)\n\ngainMod = 1.0 + (transientDiff * (attackPunch - 1.0) * 3.5) + ((sustainTail - 1.0) * sustainWeight * 1.5)\nshaped = in * clamp(gainMod, 0.0, 4.0)\n\nwet = tanh(shaped * (1.0 + drive * 0.8))\n\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1100 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1
  f size 0.26
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Dynamic Transient Shaper FX. Dual-envelope transient designer and harmonic exciter with attack punch.
  f width 340
  f height 120
end
note synth 0 notes
aud fx 0 synth
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
