infinite-patch 1
# Formant Filter FX: vocal vowel formant resonator Field Effect
node 1 Synths Oscillator
  id osc
  pos 0 1024
  f freq 110.0
  i waveform 2
end
node 2 Effects Field Effect
  id fx
  pos 480 1024
  s code param float vowel = 0.5 [0.0, 1.0]\nparam float resonance = 0.82 [0.1, 0.98]\nparam float morphRate = 0.6 [0.05, 5.0]\nparam float drive = 1.8 [1.0, 4.0]\nparam float mix = 0.65 [0.0, 1.0]\nstate float lfoP = 0\nstate float bp1_x1 = 0\nstate float bp1_y1 = 0\nstate float bp1_y2 = 0\nstate float bp2_x1 = 0\nstate float bp2_y1 = 0\nstate float bp2_y2 = 0\n\nlfoP = (lfoP + morphRate / sr) % 1.0\nlfo = sin(6.2831853 * lfoP) * 0.25\ncurVowel = clamp(vowel + lfo, 0.0, 1.0)\n\nf1 = 300.0 + curVowel * 550.0\nf2 = 800.0 + (1.0 - abs(curVowel - 0.5) * 2.0) * 1600.0\n\nw1 = 6.2831853 * f1 / sr\nw2 = 6.2831853 * f2 / sr\nr = resonance\n\nu = in * drive\nsatIn = u / (1.0 + abs(u) * 0.2)\n\ny1 = satIn * (1.0 - r) + 2.0 * r * cos(w1) * bp1_y1 - r * r * bp1_y2\nbp1_y2 = bp1_y1\nbp1_y1 = y1\n\ny2 = satIn * (1.0 - r) + 2.0 * r * cos(w2) * bp2_y1 - r * r * bp2_y2\nbp2_y2 = bp2_y1\nbp2_y1 = y2\n\nwet = (y1 + y2 * 0.7) * 1.4\nwetSat = wet / (1.0 + abs(wet) * 0.25)\nout = in * (1.0 - mix) + wetSat * mix\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Formant Filter FX. Dual resonant formant vowel cavity with drive and morphing.
  f width 360
  f height 120
end
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.16 0.46
mod pic sizeY ana 0 0 1 0.5 0.16 0.46
