{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Chowning Formant Vowel Filter FX",
    "author": "Infinite",
    "description": "Dual parallel state-variable formant bandpass bank morphing smoothly across vowel resonances with soft console saturation.",
    "domain": "effect"
  },
  "device": {
    "code": "param float vowel = 0.45 [0.0, 1.0];\nparam float morphHz = 0.22 [0.02, 2.2];\nparam float q = 0.28 [0.10, 0.65];\nparam float drive = 1.30 [0.6, 2.5];\nparam float mix = 0.85 [0.0, 1.0];\nstate float lfo = 0;\nstate float bp1 = 0; state float lp1 = 0;\nstate float bp2 = 0; state float lp2 = 0;\n\nlfo = (lfo + morphHz / sr) % 1.0;\nv = clamp(vowel + 0.35 * sin(6.2831853 * lfo), 0.0, 1.0);\ng1 = clamp(2.0 * sin(3.14159265 * (300.0 + v * 480.0) / sr), 0.02, 0.78);\ng2 = clamp(2.0 * sin(3.14159265 * (850.0 + (1.0 - v) * 1450.0) / sr), 0.02, 0.78);\n\nbp1 = bp1 + g1 * (in - lp1 - q * bp1); lp1 = lp1 + g1 * bp1;\nbp2 = bp2 + g2 * (in - lp2 - q * bp2); lp2 = lp2 + g2 * bp2;\n\nformant = (bp1 * 0.70 + bp2 * 0.55) * drive;\nwet = formant / (1.0 + abs(formant) * 0.50);\nout = (in * (1.0 - mix) + wet * mix) * 0.78;\n",
    "params": {
      "vowel": 0.45,
      "morphHz": 0.22,
      "q": 0.28,
      "drive": 1.3,
      "mix": 0.85
    }
  }
}