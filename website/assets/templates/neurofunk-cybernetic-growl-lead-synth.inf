infinite-patch 1
# Neurofunk Cybernetic Growl Lead Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 48
  i note3 51
  i note4 48
  i note5 48
  i note6 60
  i note7 48
  i note8 48
  i note9 48
  i note10 51
  i note11 48
  i note12 48
  i note13 60
  i note14 51
  i note15 48
  b en0 1
  b en1 1
  b en2 1
