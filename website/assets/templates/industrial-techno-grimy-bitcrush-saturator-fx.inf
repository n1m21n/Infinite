infinite-patch 1
# Industrial Techno Grimy Bitcrush Saturator FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float drive = 0.55 [0.0, 1.0]\nparam float crush = 0.45 [0.0, 0.9]\nparam float tone = 0.50 [0.1, 1.0]\nparam float warmth = 0.40 [0.0, 1.0]\nparam float mix = 0.60 [0.0, 1.0]\nstate float s1 = 0\nstate float s2 = 0\n\nsteps = clamp(floor(32.0 - crush * 24.0), 4.0, 32.0)\nqIn = floor(in * steps) / steps\n\npre = qIn * (1.0 + drive * 2.8)\nsat = (pre - (pre * pre * pre * 0.15)) / (1.0 + abs(pre * 0.4))\n\nfCut = clamp(0.08 + tone * 0.35, 0.02, 0.45)\ns1 = s1 + fCut * (sat - s1)\ns2 = s2 + fCut * (s1 - s2)\n\nwarm = s2 * (1.0 + warmth * 0.3)\nprocessed = in * (1.0 - mix) + warm * mix\nout = processed * 0.45\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.15 0.20 0.30
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Industrial Techno Grimy Bitcrush Saturator FX. Punishing industrial waveshaper processor featuring asymmetric diode wavefolding, quantized bit-depth degradation, resonant post-overdrive lowpass filter, and parallel dry-wet blend.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
