{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Spectral Dub Chamber Pingpong Echo FX",
    "author": "Infinite",
    "description": "Multi-tap dub tape echo with asymmetric feedback damping, wow/flutter pitch drift, and warm oxide saturation.",
    "domain": "effect"
  },
  "device": {
    "code": "param float feedback = 0.60 [0.0, 0.88];\nparam float damping = 0.45 [0.05, 0.85];\nparam float wow = 0.32 [0.0, 1.0];\nparam float drive = 1.40 [0.8, 2.8];\nparam float mix = 0.60 [0.0, 1.0];\nstate float lfo = 0;\nstate float tap1 = 0;\nstate float tap2 = 0;\nstate float tap3 = 0;\nstate float lp = 0;\n\nlfo = (lfo + 0.48 / sr) % 1.0;\ndrift = 1.0 + sin(6.2831853 * lfo) * wow * 0.14;\n\nfCut = clamp(0.10 + (1.0 - damping) * 0.30, 0.03, 0.44);\nlp = lp + fCut * (in - lp);\n\nr1 = clamp(0.072 * drift, 0.02, 0.18);\nr2 = clamp(0.053 * drift, 0.02, 0.18);\nr3 = clamp(0.037 * drift, 0.02, 0.18);\n\ntap1 = tap1 + r1 * (lp + tap3 * feedback * 0.56 - tap1);\ntap2 = tap2 + r2 * (tap1 - tap2);\ntap3 = tap3 + r3 * (tap2 - tap3);\n\necho = (tap1 * 0.44 + tap2 * 0.34 + tap3 * 0.28) * drive;\nsat = echo / (1.0 + abs(echo) * 0.42);\nout = (in * (1.0 - mix) + sat * mix) * 0.88;\n",
    "params": {
      "feedback": 0.6,
      "damping": 0.45,
      "wow": 0.32,
      "drive": 1.4,
      "mix": 0.6
    }
  }
}