infinite-patch 1
# Detroit Techno Soul Chord Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 48
  i note4 51
  i note5 48
  i note6 55
  i note7 58
  i note8 48
  i note9 48
  i note10 60
  i note11 48
  i note12 51
  i note13 53
  i note14 55
  i note15 58
  b en0 1
  b en1 1
