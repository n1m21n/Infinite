infinite-patch 1
# Dark Ambient Spectral Filter FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3400.0
  f resonance 0.32
  f decay 0.28
  f volume 0.8
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float lfoRate = 0.25 [0.05, 1.5]\nparam float centerFreq = 1400.0 [250.0, 4500.0]\nparam float resonance = 0.45 [0.05, 0.85]\nparam float mix = 0.70 [0.0, 1.0]\nstate float lfo = 0\nstate float lp1 = 0\nstate float lp2 = 0\nstate float bp1 = 0\nstate float subTone = 0\n\nlfo = (lfo + lfoRate / sr) % 1.0\nwob = sin(lfo * 6.2831853) * 0.5 + 0.5\n\nfCut = clamp((centerFreq * (0.6 + wob * 0.8)) / sr * 2.2, 0.01, 0.45)\nlp1 = lp1 + fCut * (in - lp1 - resonance * bp1)\nbp1 = bp1 + fCut * (lp1 - bp1)\nlp2 = lp2 + fCut * (bp1 - lp2)\n\nfSub = clamp(90.0 / sr * 2.2, 0.005, 0.1)\nsubTone = subTone + fSub * (in - subTone)\n\nwet = (lp2 * 0.85 + bp1 * 0.65 + subTone * 0.4) * 1.35\nu = wet * 1.2\nsat = clamp(u - 0.18 * u * u * u, -0.92, 0.92)\n\nout = (in * (1.0 - mix) + sat * mix) * 1.06\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.28 0.45
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Dark Ambient Spectral Filter FX. Atmospheric multi-pole morphing lowpass and notch filter with slow drifting LFO modulation, sub-harmonic exciter, and soft tape clipping.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
