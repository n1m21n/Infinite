infinite-patch 1
# Amapiano Lush Spatial Reverb Diffusion FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 48
  i note1 48
  i note2 60
  i note3 55
  i note4 48
  i note5 60
  i note6 53
  i note7 55
  i note8 48
  i note9 48
  i note10 60
  i note11 55
  i note12 48
  i note13 60
  i note14 53
  i note15 58
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 400 1024
  f cutoff 3200.0
  f resonance 0.30
  f decay 0.26
  f volume 0.75
end
node 3 AudioEffects Field Effect
  id fx
  pos 800 1024
  s code param float roomSize = 0.58 [0.1, 0.9]\nparam float decayTime = 0.45 [0.1, 0.8]\nparam float damping = 3600.0 [800.0, 8000.0]\nparam float diffusion = 0.42 [0.0, 0.85]\nparam float mix = 0.52 [0.0, 1.0]\nstate float c1 = 0\nstate float c2 = 0\nstate float c3 = 0\nstate float lp = 0\n\nfDamp = clamp(damping / sr * 2.0, 0.03, 0.45)\nlp = lp + fDamp * (in - lp)\n\nfb = clamp(roomSize * 0.82, 0.1, 0.82)\ndRate = clamp(decayTime * 0.32, 0.03, 0.32)\n\nc1 = c1 + dRate * 1.02 * (lp + c3 * fb * 0.50 - c1)\nc2 = c2 + dRate * 0.75 * (c1 * fb * 0.72 - c2)\nc3 = c3 + dRate * 0.52 * (c2 * fb * 0.68 - c3)\n\ndiff = (c1 - c2) * diffusion * 1.6\nwet = (c1 * 0.38 + c2 * 0.32 + c3 * 0.28 + diff)\nsat = clamp(wet / (1.0 + abs(wet * 0.5)), -0.85, 0.85)\n\nprocessed = in * (1.0 - mix) + sat * mix\nout = processed * 1.45\n
end
node 4 Utility Audio Out
  id speakers
  pos 1200 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.14 0.20 0.30
  f size 0.24
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Amapiano Lush Spatial Reverb Diffusion FX. Expansive warm spatial reverb and early reflection diffusion network designed for amapiano jazz chord progressions and shaker grooves, with high-frequency damping and rich acoustic depth.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
aud ana 0 fx
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
