infinite-patch 1
# Acid House Transistor Lead Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.25
  i steps 16
  i note0 36
  i note1 36
  i note2 48
  i note3 43
  i note4 36
  i note5 48
  i note6 41
  i note7 43
  i note8 36
  i note9 36
  i note10 48
  i note11 43
  i note12 36
  i note13 48
  i note14 41
  i note15 46
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 1400.0 [80.0, 9000.0]\nparam float resonance = 0.78 [0.1, 0.98]\nparam float envMod = 0.75 [0.0, 1.0]\nparam float accent = 0.5 [0.0, 1.0]\nparam float decay = 0.35 [0.05, 2.0]\nstate float phase = 0\nstate float env = 0\nstate float curFreq = 110\nstate float lp1 = 0\nstate float lp2 = 0\nstate float lp3 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenv = if(target > env, env + (target - env) * 0.1, env - env * (0.0006 / decay))\n\ncurFreq = curFreq + (freq - curFreq) * 0.08\nstepFreq = clamp(curFreq, 20.0, 4000.0) / sr\nphase = (phase + stepFreq) % 1.0\n\nsaw = phase * 2.0 - 1.0\nsquare = if(phase > 0.5, 0.9, -0.9)\nraw = saw * 0.7 + square * 0.3\n\nfMod = clamp(cutoff + env * (4500.0 * (1.0 + accent * 0.5)), 60.0, 14000.0)\nfNorm = clamp(fMod * 3.14159265 / sr, 0.01, 0.85)\nfb = resonance * 3.2\n\ndrive = raw - lp3 * fb\nlp1 = lp1 + fNorm * (drive - lp1)\nlp2 = lp2 + fNorm * (lp1 - lp2)\nlp3 = lp3 + fNorm * (lp2 - lp3)\n\nsat = clamp(lp3 * 1.5, -1.0, 1.0)\nout = sat * env * 0.38\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.16 0.32 0.45
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid House Transistor Lead Synth. Resonant 3-pole transistor diode ladder lead synthesizer with accent modulation and vintage acid squelch.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.14 0.38
mod pic sizeY ana 0 0 1 0.5 0.14 0.38
