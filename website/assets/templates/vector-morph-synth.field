{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Vector Morph Synth",
    "author": "Infinite",
    "description": "4-quadrant planar vector crossfade synthesizer with orbital trajectory modulation, bilinear wave morphing and sub-bass drive.",
    "domain": "synth"
  },
  "device": {
    "code": "param float vectorX = 0.5 [0.0, 1.0];\nparam float vectorY = 0.5 [0.0, 1.0];\nparam float orbitSpeed = 1.2 [0.0, 8.0];\nparam float orbitDepth = 0.35 [0.0, 1.0];\nparam float subLevel = 0.4 [0.0, 1.0];\nparam float cutoff = 4200.0 [200.0, 12000.0];\nparam float envDecay = 0.6 [0.05, 3.0];\nstate float phase = 0;\nstate float subPhase = 0;\nstate float lfoPhase = 0;\nstate float env = 0;\nstate float lp = 0;\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * envDecay), 0.00005, 0.02);\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.12, env - env * decayRate);\n\npStep = clamp(freq, 20.0, 5000.0) / sr;\nphase = (phase + pStep) % 1.0;\nsubPhase = (subPhase + pStep * 0.5) % 1.0;\n\nlfoStep = orbitSpeed / sr;\nlfoPhase = (lfoPhase + lfoStep) % 1.0;\n\ncurrX = clamp(vectorX + cos(6.2831853 * lfoPhase) * orbitDepth * 0.5, 0.0, 1.0);\ncurrY = clamp(vectorY + sin(6.2831853 * lfoPhase) * orbitDepth * 0.5, 0.0, 1.0);\n\nwaveA = sin(6.2831853 * phase);\nwaveB = (phase * 2.0 - 1.0) * 0.8;\nwaveC = if(phase < 0.5, 0.75, -0.75);\nwaveD = sin(6.2831853 * phase * 2.76) * sin(6.2831853 * phase);\n\ntop = waveA * (1.0 - currX) + waveB * currX;\nbottom = waveC * (1.0 - currX) + waveD * currX;\nvectMix = top * (1.0 - currY) + bottom * currY;\n\nsub = sin(6.2831853 * subPhase) * subLevel;\nraw = (vectMix + sub) * env;\n\nfCut = clamp(cutoff / sr * 2.0, 0.01, 0.46);\nlp = lp + fCut * (raw - lp);\n\nout = lp * 0.82;\n",
    "params": {
      "vectorX": 0.5,
      "vectorY": 0.5,
      "orbitSpeed": 1.2,
      "orbitDepth": 0.35,
      "subLevel": 0.4,
      "cutoff": 4200.0,
      "envDecay": 0.6
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}