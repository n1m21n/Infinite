infinite-patch 1
# Buchla Complex Oscillator Synth: dual complex core with wavefolding and FM cross-modulation
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 36
  i rangeHigh 60
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float fmRatio = 1.5 [0.25, 8.0]\nparam float fmIndex = 1.8 [0.0, 5.0]\nparam float timbre = 0.55 [0.0, 1.0]\nparam float symmetry = 0.5 [0.1, 0.9]\nparam float warmth = 0.7 [0.0, 1.0]\nstate float pCore = 0\nstate float pMod = 0\nstate float env = 0\nstate float lp = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenv = if(target > env, env + (target - env) * 0.03, env - env * 0.0004)\n\nbaseFreq = clamp(freq, 20.0, 4000.0) / sr\nmodFreq = baseFreq * fmRatio\n\npMod = (pMod + modFreq) % 1.0\nmodVal = sin(6.2831853 * pMod) * fmIndex\n\npCore = (pCore + baseFreq * (1.0 + modVal)) % 1.0\n\ntri = if(pCore < symmetry, pCore / symmetry, (1.0 - pCore) / (1.0 - symmetry)) * 2.0 - 1.0\n\nfoldInput = tri * (1.0 + timbre * 3.5)\nfolded = sin(foldInput * 3.14159265)\n\nu = folded * 1.6\nsat = u / (1.0 + abs(u) * 0.32)\n\nfCut = clamp(baseFreq * 8.0 * (1.0 + timbre), 0.01, 0.45)\nlp = lp + fCut * (sat - lp)\n\nout = lp * env * (0.35 + warmth * 0.25)\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.25
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Buchla Complex Oscillator Synth. Dual oscillator with wavefolding and FM modulation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
