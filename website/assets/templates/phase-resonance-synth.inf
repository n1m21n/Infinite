infinite-patch 1
# Phase Resonance Synth: Casio CZ-style phase resonance synthesizer with synchronous resonant windowing
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 36
  i rangeHigh 68
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float resFreq = 1800.0 [200.0, 5200.0]\nparam float resDepth = 0.75 [0.0, 1.0]\nparam float windowType = 0.5 [0.0, 1.0]\nparam float subMix = 0.35 [0.0, 1.0]\nparam float filterCutoff = 6200.0 [300.0, 15000.0]\nstate float fundPhase = 0\nstate float subPhase = 0\nstate float env = 0\nstate float lp = 0\n\ntargetEnv = if(gate > 0.5, 1.0, 0.0)\nenv = if(targetEnv > env, env + (targetEnv - env) * 0.22, env * 0.9994)\n\nfStep = clamp(freq, 20.0, 4000.0) / sr\nfundPhase = (fundPhase + fStep) % 1.0\nsubPhase = (subPhase + fStep * 0.5) % 1.0\n\nfMult = clamp(resFreq / max(freq, 20.0), 1.0, 24.0)\nresPhase = (fundPhase * fMult) % 1.0\ncarrier = cos(6.2831853 * resPhase)\n\nwinSaw = 1.0 - fundPhase\nwinCos = cos(3.14159265 * fundPhase) * 0.5 + 0.5\nwin = mix(winSaw, winCos, windowType)\n\nresonantSig = carrier * win * resDepth + sin(6.2831853 * fundPhase) * (1.0 - resDepth)\nsubSig = sin(6.2831853 * subPhase) * subMix\n\nraw = (resonantSig * 1.4 + subSig) * env\n\nfCut = clamp(filterCutoff / sr * 2.0, 0.01, 0.48)\nlp = lp + fCut * (raw - lp)\n\nout = lp * 0.82\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.28
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Phase Resonance Synth. Casio CZ-style phase resonance synthesizer with synchronous resonant windowing.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
