infinite-patch 1
# Hilbert Frequency Shifter FX
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 48
  i note1 52
  i note2 55
  i note3 60
  i note4 55
  i note5 52
  i note6 48
  i note7 50
  i note8 53
  i note9 57
  i note10 60
  i note11 64
  i note12 60
  i note13 57
  i note14 53
  i note15 50
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
  b en8 1
  b en9 1
  b en10 1
  b en11 1
  b en12 1
  b en13 1
  b en14 1
  b en15 1
end
node 2 Synths Analog
  id osc
  pos 360 1024
  f cutoff 2400.0
  f resonance 0.25
  f decay 0.45
  f volume 0.85
end
node 3 AudioEffects Field Effect
  id fx
  pos 720 1024
  s code param float shiftHz = 18.0 [-120.0, 120.0];\nparam float sideband = 0.85 [-1.0, 1.0];\nparam float feedback = 0.32 [0.0, 0.75];\nparam float toneHz = 4200.0 [800.0, 8000.0];\nparam float mix = 0.65 [0.0, 1.0];\nstate float osc = 0; state float fb = 0;\nstate float a1 = 0; state float a2 = 0; state float b1 = 0; state float b2 = 0;\nstate float lp = 0;\n\nx = in + fb * feedback;\n\n# 4-pole quadrature allpass Hilbert pair (I and Q 90-deg offset)\nyI1 = -0.69238 * x + a1; a1 = x + 0.69238 * yI1;\nyI2 = -0.93606 * yI1 + a2; a2 = yI1 + 0.93606 * yI2;\n\nyQ1 = -0.40219 * x + b1; b1 = x + 0.40219 * yQ1;\nyQ2 = -0.85617 * yQ1 + b2; b2 = yQ1 + 0.85617 * yQ2;\n\nosc = (osc + shiftHz / sr) % 1.0;\nc = cos(6.2831853 * osc);\ns = sin(6.2831853 * osc);\n\nssb = yI2 * c - yQ2 * s * sideband;\ng = clamp(2.0 * sin(3.14159265 * toneHz / sr), 0.04, 0.85);\nlp = lp + g * (ssb - lp);\nfb = clamp(lp, -0.95, 0.95);\n\nout = (in * (1.0 - mix) + lp * mix) * 0.68;\n
end
node 4 Utility Audio Out
  id speakers
  pos 1080 1024
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 0.28 0.22 0.16
  f size 0.24
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Hilbert Frequency Shifter FX. Single-sideband Bode-style quadrature frequency shifter with a 4-pole allpass Hilbert network, metallic detuning, and barber-pole spiral feedback.
  f width 340
  f height 120
end
note osc 0 notes
aud fx 0 osc
aud speakers 0 fx
cable out 0 pic
