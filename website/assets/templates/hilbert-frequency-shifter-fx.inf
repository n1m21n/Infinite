infinite-patch 1
# Hilbert Frequency Shifter FX: single-sideband frequency shifter with quadrature Hilbert network
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
end
node 2 Synths Analog
  id synth
  pos 480 1024
end
node 3 AudioEffects Field Effect
  id tape
  pos 1020 1024
  s code param float shiftHz = 45.0 [-500.0, 500.0]\nparam float feedback = 0.25 [0.0, 0.85]\nparam float drive = 1.6 [1.0, 4.0]\nparam float sideband = 1.0 [-1.0, 1.0]\nparam float mix = 0.85 [0.0, 1.0]\nstate float cPhase = 0\nstate float a1 = 0\nstate float a2 = 0\nstate float b1 = 0\nstate float b2 = 0\nstate float fb = 0\n\ncPhase = (cPhase + shiftHz / sr) % 1.0\ncarrierCos = cos(6.2831853 * cPhase)\ncarrierSin = sin(6.2831853 * cPhase)\n\nsig = in + fb * feedback\nu = sig * drive\nsat = u / (1.0 + abs(u) * 0.2)\n\napA1 = sat * 0.16 + a1 * 0.84\na1 = sat\napA2 = apA1 * 0.5 + a2 * 0.5\na2 = apA1\n\napB1 = sat * 0.32 + b1 * 0.68\nb1 = sat\napB2 = apB1 * 0.78 + b2 * 0.22\nb2 = apB1\n\nssb = apA2 * carrierCos - apB2 * carrierSin * sideband\nfb = ssb\n\nout = in * (1.0 - mix) + ssb * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1560 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.25
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Hilbert Frequency Shifter FX. Single-sideband analytic frequency shifter with quadrature carrier.
  f width 340
  f height 120
end
note synth 0 notes
aud tape 0 synth
aud speakers 0 tape
aud ana 0 tape
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
