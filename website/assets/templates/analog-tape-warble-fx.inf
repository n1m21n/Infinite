infinite-patch 1
# Analog Tape Warble FX: magnetic tape deck emulator with wow/flutter and saturation
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
end
node 2 Synths Analog
  id synth
  pos 480 1024
end
node 3 AudioEffects Field Effect
  id tape
  pos 1020 1024
  s code param float drive = 2.2 [1.0, 5.0]\nparam float wow = 0.45 [0.0, 1.0]\nparam float flutter = 0.35 [0.0, 1.0]\nparam float tapeLoss = 0.55 [0.0, 1.0]\nparam float mix = 0.95 [0.0, 1.0]\nstate float pWow = 0\nstate float pFlut = 0\nstate float d1 = 0\nstate float d2 = 0\nstate float lp = 0\n\npWow = (pWow + 0.6 / sr) % 1.0\npFlut = (pFlut + 6.2 / sr) % 1.0\nmod = sin(6.2831853 * pWow) * wow * 0.4 + sin(6.2831853 * pFlut) * flutter * 0.2\n\nu = in * drive\nsat = u / (1.0 + abs(u) * 0.35)\n\nd2 = d1\nd1 = sat\nwetRaw = d1 * (0.6 + mod * 0.3) + d2 * (0.4 - mod * 0.3)\n\ncut = clamp(0.45 - tapeLoss * 0.35, 0.05, 0.48)\nlp = lp + cut * (wetRaw - lp)\n\nout = in * (1.0 - mix) + lp * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1560 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 1.0 0.42 0.21
  f size 0.25
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Analog Tape Warble FX. Magnetic tape deck emulation with dual wow/flutter instability and hysteresis saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud tape 0 synth
aud speakers 0 tape
aud ana 0 tape
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
