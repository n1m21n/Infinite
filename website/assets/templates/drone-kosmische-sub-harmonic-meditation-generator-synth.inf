infinite-patch 1
# Drone Kosmische Sub-Harmonic Meditation Generator Synth
node 1 Notes Note Sequencer
  id notes
  pos 0 1024
  f rateBeats 0.5
  i steps 16
  i note0 43
  i note1 43
  i note2 50
  i note3 47
  i note4 43
  i note5 50
  i note6 48
  i note7 50
  i note8 38
  i note9 38
  i note10 45
  i note11 43
  i note12 36
  i note13 40
  i note14 45
  i note15 47
  b en0 1
  b en1 1
  b en2 1
  b en3 1
  b en4 1
  b en5 1
  b en6 1
  b en7 1
