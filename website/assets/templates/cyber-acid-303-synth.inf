infinite-patch 1
# Cyber Acid 303 Synth: saturated diode ladder acid bassline synthesizer
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
  i rangeLow 32
  i rangeHigh 56
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 1800.0 [80.0, 14000.0]\nparam float resonance = 0.88 [0.0, 0.98]\nparam float envMod = 0.75 [0.0, 1.0]\nparam float accent = 0.6 [0.0, 1.0]\nparam float drive = 2.4 [1.0, 6.0]\nstate float phase = 0\nstate float env = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float s4 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\nenv = if(target > env, env + (target - env) * 0.04, env - env * (0.0003 + accent * 0.0004))\n\nbaseFreq = clamp(freq, 20.0, 3000.0) / sr\nphase = (phase + baseFreq) % 1.0\n\nsaw = (phase * 2.0 - 1.0)\npulse = if(phase > 0.5, 0.8, -0.8)\nrawOsc = saw * 0.75 + pulse * 0.25\n\nfMod = cutoff * (1.0 + envMod * env * 3.5)\nf = clamp(fMod / sr * 2.2, 0.005, 0.44)\nkRes = resonance * 3.8\n\nfb = s4 * kRes\nuIn = rawOsc * drive - fb\nsatIn = uIn / (1.0 + abs(uIn) * 0.35)\n\ns1 = s1 + f * (satIn - s1)\ns2 = s2 + f * (s1 - s2)\ns3 = s3 + f * (s2 - s3)\ns4 = s4 + f * (s3 - s4)\n\nout = s4 * env * (0.8 + accent * 0.4)\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 1.0 0.42 0.21
  f size 0.25
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Cyber Acid 303 Synth. Saturated diode ladder bassline synthesizer with accent decay and transistor feedback.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
