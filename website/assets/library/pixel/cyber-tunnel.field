{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "cyber-tunnel",
    "author": "community",
    "description": "audio-reactive infinite cyber tunnel with perspective warping and speed modulation",
    "domain": "pixel"
  },
  "device": {
    "code": "param float audio_bass = 0.5 [0.0, 2.0];\nparam float speed = 2.0 [0.1, 10.0];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\nr = length(p);\na = atan2(p.y, p.x);\n\nu_coord = a / 3.14159265;\nv_coord = 1.0 / (r + 0.001) + t * speed;\n\ngrid_u = abs(fract(u_coord * 4.0) - 0.5);\ngrid_v = abs(fract(v_coord * 2.0) - 0.5);\nlines = smoothstep(0.45, 0.48, max(grid_u, grid_v));\n\ncol = vec3(lines) * vec3(0.1, 0.8, 1.0) + vec3(0.9, 0.1, 0.6) * (1.0 - smoothstep(0.0, 0.8, r));\ncol = col * (0.7 + 0.6 * audio_bass);",
    "params": {
      "audio_bass": 0.5,
      "speed": 2.0
    },
    "nodeSettings": {
      "width": 1280.0,
      "height": 720.0,
      "animate": 1.0
    }
  }
}