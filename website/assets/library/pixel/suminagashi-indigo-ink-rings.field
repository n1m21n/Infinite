{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Suminagashi Indigo Ink Rings",
    "author": "Infinite",
    "description": "Japanese Suminagashi floating sumi and Prussian indigo ink rings advected by curl-comb strokes and audio-reactive surfactant ripples.",
    "domain": "pixel"
  },
  "device": {
    "code": "param float ringDensity = 22.0 [8.0, 42.0];\nparam float combStrength = 0.42 [0.1, 1.0];\nparam float swirlFreq = 2.4 [0.8, 5.0];\nparam float inkContrast = 1.35 [0.6, 2.4];\nparam float drift = 0.18 [0.0, 0.8];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * 2.0;\n\n# Multi-pass curl/comb advection mimicking stylus drag across water basin\nq = p;\nw1 = vec2(sin(q.y * swirlFreq + t * drift), cos(q.x * swirlFreq - t * drift * 0.8));\nq = q + w1 * combStrength * 0.55;\nw2 = vec2(sin(q.y * swirlFreq * 1.9 - q.x * 1.3 + t * drift * 1.1), cos(q.x * swirlFreq * 2.1 + q.y * 1.4));\nq = q + w2 * combStrength * 0.28;\n\n# Concentric surfactant ink drops\nr1 = length(q - vec2(-0.28, 0.16));\nr2 = length(q - vec2(0.32, -0.22));\nr3 = length(q - vec2(0.05, 0.34));\nringField = sin(r1 * ringDensity - t * drift * 1.4) + 0.72 * sin(r2 * ringDensity * 0.88 + 1.2) + 0.55 * sin(r3 * ringDensity * 1.12 - 0.7);\ninkBand = 0.5 + 0.5 * sin(ringField * 1.65 * inkContrast);\n\n# Fine washi & surfactant rim highlight\nrim = exp(-abs(sin(ringField * 1.65)) * 7.5);\n\ncObsidian = vec3(0.035, 0.043, 0.063);\ncPrussian = vec3(0.055, 0.180, 0.322);\ncCobalt   = vec3(0.094, 0.302, 0.478);\ncWashi    = vec3(0.910, 0.902, 0.875);\ncGold     = vec3(0.784, 0.635, 0.322);\n\ncol = mix(cObsidian, cPrussian, smoothstep(0.15, 0.65, inkBand));\ncol = mix(col, cCobalt, smoothstep(0.50, 0.92, inkBand));\ncol = mix(col, cWashi, smoothstep(0.55, 0.96, rim * 0.88));\ncol = mix(col, cGold, smoothstep(0.78, 0.99, rim * (0.5 + 0.5 * sin(q.x * 4.2 + q.y * 3.1))));\ncol = clamp(col, 0.0, 1.0);\n",
    "params": {
      "ringDensity": 22.0,
      "combStrength": 0.42,
      "swirlFreq": 2.4,
      "inkContrast": 1.35,
      "drift": 0.18
    },
    "nodeSettings": {
      "width": 1080.0,
      "height": 1080.0,
      "animate": 1.0
    }
  }
}