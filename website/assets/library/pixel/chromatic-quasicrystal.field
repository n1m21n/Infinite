{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Chromatic Quasicrystal",
    "author": "Infinite",
    "description": "Aperiodic eight-fold quasicrystalline plane wave interference with iridescent diffraction vertices and audio-reactive phase resonance.",
    "domain": "pixel"
  },
  "device": {
    "code": "param float waveFreq = 16.0 [4.0, 32.0];\nparam float drift = 0.8 [0.1, 2.5];\nparam float sharpness = 4.2 [1.0, 8.0];\nparam float dispersion = 0.65 [0.0, 1.5];\nparam float hueShift = 0.60 [0.0, 1.0];\n\np = (uv - 0.5) * 2.2;\np.x = p.x * aspect;\n\nr = length(p);\ntCur = t * drift * 0.4;\n\nw0 = cos(p.x * waveFreq + tCur);\nw1 = cos((p.x * 0.9238 + p.y * 0.3826) * waveFreq + tCur * 1.1);\nw2 = cos((p.x * 0.7071 + p.y * 0.7071) * waveFreq - tCur * 0.9);\nw3 = cos((p.x * 0.3826 + p.y * 0.9238) * waveFreq + tCur * 1.3);\nw4 = cos(p.y * waveFreq - tCur * 1.2);\nw5 = cos((-p.x * 0.3826 + p.y * 0.9238) * waveFreq + tCur * 0.8);\nw6 = cos((-p.x * 0.7071 + p.y * 0.7071) * waveFreq - tCur * 1.4);\nw7 = cos((-p.x * 0.9238 + p.y * 0.3826) * waveFreq + tCur * 1.0);\n\npsi = (w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7) * 0.125;\npsiNorm = clamp(psi * 0.5 + 0.5, 0.0, 1.0);\npeaks = pow(psiNorm, sharpness);\n\nground = vec3(0.082, 0.098, 0.188);\nsignal = vec3(0.655, 0.694, 1.0);\nemerald = vec3(0.306, 0.949, 0.722);\nember = vec3(1.0, 0.42, 0.21);\n\nrings = sin(r * 18.0 - tCur * 2.0) * 0.5 + 0.5;\ncolorGrad = mix(signal, emerald, sin(psi * 4.0 + tCur) * 0.5 + 0.5);\ncolorGrad = mix(colorGrad, ember, rings * 0.35 * dispersion);\n\ncol = ground;\ncol = col + colorGrad * peaks * 2.2;\ncol = col + signal * rings * 0.18 * exp(-r * 1.2);\nalpha = 1.0;\n",
    "params": {
      "waveFreq": 16.0,
      "drift": 0.8,
      "sharpness": 4.2,
      "dispersion": 0.65,
      "hueShift": 0.6
    },
    "nodeSettings": {
      "width": 1280.0,
      "height": 720.0,
      "animate": 1.0
    }
  }
}
