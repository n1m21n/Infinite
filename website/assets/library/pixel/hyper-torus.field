{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "hyper torus",
    "author": "infinite",
    "description": "audio-reactive 4d clifford torus with spectrum frequency modulation",
    "domain": "pixel"
  },
  "device": {
    "code": "param float speed = 1.0 [0.1, 4.0];\nparam float rings = 12.0 [3.0, 32.0];\nparam float glow = 0.8 [0.1, 2.0];\nparam float audio_bass = 0.5 [0.0, 2.0];\nparam float audio_mid = 0.5 [0.0, 2.0];\nparam float audio_high = 0.5 [0.0, 2.0];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\nr = length(p);\na = atan2(p.y, p.x);\n\nz = sin(r * rings - t * speed * 2.0 + a * 3.0 + audio_bass * 2.0);\nw = cos(a * 4.0 - t * speed * 1.5 + r * 8.0 * audio_mid);\nring_val = abs(z * w);\nintensity = (0.015 * glow * (1.0 + audio_high)) / (ring_val + 0.008);\n\ncol = vec3(0.96, 0.49, 0.40) * intensity * (0.8 + 0.4 * sin(t + a));\ncol += vec3(0.66, 0.80, 0.95) * intensity * (0.8 + 0.4 * cos(t * 1.2 - r * 4.0));\ncol *= smoothstep(0.7, 0.0, r);\nalpha = 1.0;\n",
    "params": {
      "speed": 1.0,
      "rings": 12.0,
      "glow": 0.8,
      "audio_bass": 0.5,
      "audio_mid": 0.5,
      "audio_high": 0.5
    },
    "nodeSettings": {
      "width": 1280.0,
      "height": 720.0,
      "animate": 1.0
    }
  }
}
