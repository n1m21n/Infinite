{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Mineral Birefringence Thin Section",
    "author": "Infinite",
    "description": "Cross-polarized petrographic microscopy of Voronoi crystal domains with Michel-Levy interference bands and analyzer rotation.",
    "domain": "pixel"
  },
  "device": {
    "code": "param float grainScale = 4.8 [2.0, 10.0];\nparam float analyzer = 0.45 [0.0, 3.14];\nparam float retardation = 2.4 [0.8, 4.5];\nparam float twinning = 0.42 [0.0, 1.0];\nparam float borderWidth = 0.032 [0.01, 0.08];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * 2.0;\nq = p * grainScale;\niq = floor(q);\nfq = fract(q);\n\nc0 = iq + vec2(-1.0, -1.0); h0 = fract(sin(vec2(dot(c0, vec2(127.1, 311.7)), dot(c0, vec2(269.5, 183.3)))) * 43758.5453); d0 = length(vec2(-1.0, -1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h0) - fq);\nc1 = iq + vec2(0.0, -1.0);  h1 = fract(sin(vec2(dot(c1, vec2(127.1, 311.7)), dot(c1, vec2(269.5, 183.3)))) * 43758.5453); d1 = length(vec2(0.0, -1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h1) - fq);\nc2 = iq + vec2(1.0, -1.0);  h2 = fract(sin(vec2(dot(c2, vec2(127.1, 311.7)), dot(c2, vec2(269.5, 183.3)))) * 43758.5453); d2 = length(vec2(1.0, -1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h2) - fq);\nc3 = iq + vec2(-1.0, 0.0);  h3 = fract(sin(vec2(dot(c3, vec2(127.1, 311.7)), dot(c3, vec2(269.5, 183.3)))) * 43758.5453); d3 = length(vec2(-1.0, 0.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h3) - fq);\nc4 = iq + vec2(0.0, 0.0);   h4 = fract(sin(vec2(dot(c4, vec2(127.1, 311.7)), dot(c4, vec2(269.5, 183.3)))) * 43758.5453); d4 = length(vec2(0.0, 0.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h4) - fq);\nc5 = iq + vec2(1.0, 0.0);   h5 = fract(sin(vec2(dot(c5, vec2(127.1, 311.7)), dot(c5, vec2(269.5, 183.3)))) * 43758.5453); d5 = length(vec2(1.0, 0.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h5) - fq);\nc6 = iq + vec2(-1.0, 1.0);  h6 = fract(sin(vec2(dot(c6, vec2(127.1, 311.7)), dot(c6, vec2(269.5, 183.3)))) * 43758.5453); d6 = length(vec2(-1.0, 1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h6) - fq);\nc7 = iq + vec2(0.0, 1.0);   h7 = fract(sin(vec2(dot(c7, vec2(127.1, 311.7)), dot(c7, vec2(269.5, 183.3)))) * 43758.5453); d7 = length(vec2(0.0, 1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h7) - fq);\nc8 = iq + vec2(1.0, 1.0);   h8 = fract(sin(vec2(dot(c8, vec2(127.1, 311.7)), dot(c8, vec2(269.5, 183.3)))) * 43758.5453); d8 = length(vec2(1.0, 1.0) + 0.5 + 0.4 * sin(t * 0.1 + 6.2831 * h8) - fq);\n\nf1 = min(min(min(d0, d1), min(d2, d3)), min(min(d4, d5), min(min(d6, d7), d8)));\ne0 = if(d0 <= f1 + 0.0001, 10.0, d0); e1 = if(d1 <= f1 + 0.0001, 10.0, d1); e2 = if(d2 <= f1 + 0.0001, 10.0, d2);\ne3 = if(d3 <= f1 + 0.0001, 10.0, d3); e4 = if(d4 <= f1 + 0.0001, 10.0, d4); e5 = if(d5 <= f1 + 0.0001, 10.0, d5);\ne6 = if(d6 <= f1 + 0.0001, 10.0, d6); e7 = if(d7 <= f1 + 0.0001, 10.0, d7); e8 = if(d8 <= f1 + 0.0001, 10.0, d8);\nf2 = min(min(min(e0, e1), min(e2, e3)), min(min(e4, e5), min(min(e6, e7), e8)));\ncid = if(d0 <= f1 + 0.0001, h0.x, if(d1 <= f1 + 0.0001, h1.x, if(d2 <= f1 + 0.0001, h2.x, if(d3 <= f1 + 0.0001, h3.x, if(d4 <= f1 + 0.0001, h4.x, if(d5 <= f1 + 0.0001, h5.x, if(d6 <= f1 + 0.0001, h6.x, if(d7 <= f1 + 0.0001, h7.x, h8.x))))))));\n\n# Cross-polarized extinction angle + plagioclase polysynthetic twinning\nang = cid * 6.2831 + t * 0.28 + analyzer;\ntwin = 0.5 + 0.5 * sin((p.x * cos(ang) + p.y * sin(ang)) * 28.0 + cid * 12.0);\next = pow(abs(sin(2.0 * ang)), 0.75);\nret = (cid * 0.85 + twin * twinning * 0.35 + f1 * 0.25) * retardation;\nmichel = 0.5 + 0.5 * cos(ret * 6.2831853 + vec3(0.1, 2.15, 4.2));\ngrain = mix(vec3(0.08, 0.09, 0.12), michel, 0.25 + 0.75 * ext);\n\nedge = f2 - f1;\nseam = smoothstep(0.0, borderWidth, edge);\ncol = clamp(grain * (0.18 + 0.82 * seam), 0.0, 1.0);\n",
    "params": {
      "grainScale": 4.8,
      "analyzer": 0.45,
      "retardation": 2.4,
      "twinning": 0.42,
      "borderWidth": 0.032
    },
    "nodeSettings": {
      "width": 1080.0,
      "height": 1080.0,
      "animate": 1.0
    }
  }
}