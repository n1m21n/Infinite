{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Lichtenberg Corona Arc Lattice",
    "author": "Infinite",
    "description": "Radial dielectric corona discharge and Voronoi-fractured quartz insulator arcs radiating from a central high-voltage electrode.",
    "domain": "pixel"
  },
  "device": {
    "code": "param float cellFreq = 6.5 [3.0, 14.0];\nparam float arcSharp = 22.0 [8.0, 40.0];\nparam float swirl = 0.55 [0.0, 1.5];\nparam float pulse = 0.45 [0.0, 1.0];\nparam float corona = 1.2 [0.4, 2.2];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * 2.0;\nr = length(p);\na = atan2(p.y, p.x);\n\n# Radial log-polar warp for branching discharge channels\nlr = log(max(r, 0.04)) * 1.45 - t * 0.28 * pulse;\nang = a + swirl * 0.22 * sin(r * 4.5 - t * 0.6);\nwp = vec2(cos(ang), sin(ang)) * r * cellFreq + vec2(sin(lr * 2.5), cos(ang * 3.0)) * 0.65;\n\n# 2-level cellular ridge interference (unrolled Voronoi-like fracture)\ng1 = abs(sin(wp.x + 0.5 * sin(wp.y * 1.3)) - cos(wp.y + 0.5 * cos(wp.x * 1.2)));\ng2 = abs(sin(wp.x * 2.1 - wp.y * 1.7 + t * 0.35) - cos(wp.y * 2.2 + wp.x * 1.5));\nedge1 = exp(-g1 * arcSharp * 0.45);\nedge2 = exp(-g2 * arcSharp * 0.60) * 0.72;\n\n# Radial electrode corona core & concentric breakdown rings\nelectrode = exp(-r * 3.6) * 1.15;\nring = exp(-abs(r - 0.58 - 0.04 * sin(a * 5.0 + t)) * 14.0) * 0.45;\nintensity = (edge1 + edge2) * smoothstep(1.35, 0.08, r) * corona + electrode + ring;\n\ncObsidian = vec3(0.014, 0.024, 0.072);\ncCobalt = vec3(0.055, 0.310, 0.847);\ncIce = vec3(0.400, 0.780, 1.000);\ncCore = vec3(0.902, 0.969, 1.000);\n\ncol = cObsidian;\ncol = mix(col, cCobalt, smoothstep(0.06, 0.52, intensity));\ncol = mix(col, cIce, smoothstep(0.42, 1.05, intensity));\ncol = mix(col, cCore, smoothstep(0.92, 1.55, intensity));\ncol = clamp(col, 0.0, 1.0);\n",
    "params": {
      "cellFreq": 6.5,
      "arcSharp": 22.0,
      "swirl": 0.55,
      "pulse": 0.45,
      "corona": 1.2
    },
    "nodeSettings": {
      "width": 1080.0,
      "height": 1080.0,
      "animate": 1.0
    }
  }
}
