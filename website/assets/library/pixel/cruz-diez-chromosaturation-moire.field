{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Cruz-Diez Chromosaturation Moire",
    "author": "Infinite",
    "description": "Kinetic vertical chromatic louver bands and optical interference moire inspired by Carlos Cruz-Diez Physichromie reliefs.",
    "domain": "pixel"
  },
  "device": {
    "code": "param float slatFreq = 14.0 [6.0, 28.0];\nparam float waveSpan = 3.2 [1.0, 6.0];\nparam float drift = 0.65 [0.1, 2.0];\nparam float louverSharp = 0.25 [0.05, 0.45];\nparam float frameMargin = 0.45 [0.32, 0.49];\n\np = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\n\n# Curved optical interference envelope\nenv = sin(p.y * waveSpan + sin(p.x * 2.6 + t * drift) * 1.3);\nu = fract(p.x * slatFreq + env * 0.45 + t * drift * 0.15);\n\n# Physichromie tri-band louver: vermilion, ivory, teal separated by crisp shadow slots\ncRed = vec3(0.92, 0.22, 0.18);\ncTeal = vec3(0.12, 0.72, 0.68);\ncIvory = vec3(0.96, 0.92, 0.82);\ncCobalt = vec3(0.16, 0.34, 0.78);\n\nmA = smoothstep(0.28, 0.36, u);\nmB = smoothstep(0.62, 0.70, u);\nslatCol = mix(mix(cRed, cIvory, mA), cTeal, mB);\n\n# Diagonal counter-wave zone modulation\nz = 0.5 + 0.5 * sin(p.y * 4.2 - p.x * 2.1 + env * 1.4);\nslatCol = mix(slatCol, cCobalt, z * 0.42);\n\n# Crisp physical louver shadow rib between slats\nrib = smoothstep(0.0, louverSharp * 0.35, u) * (1.0 - smoothstep(1.0 - louverSharp * 0.35, 1.0, u));\ncol = mix(vec3(0.05, 0.06, 0.09), slatCol, 0.25 + 0.75 * rib);\n\n# Matte museum frame\nedgeX = smoothstep(frameMargin, frameMargin + 0.015, abs(uv.x - 0.5));\nedgeY = smoothstep(frameMargin, frameMargin + 0.015, abs(uv.y - 0.5));\nframeMask = max(edgeX, edgeY);\ncol = mix(col, vec3(0.08, 0.09, 0.12), frameMask);\ncol = clamp(col, 0.0, 1.0);\n",
    "params": {
      "slatFreq": 14.0,
      "waveSpan": 3.2,
      "drift": 0.65,
      "louverSharp": 0.25,
      "frameMargin": 0.45
    }
  }
}