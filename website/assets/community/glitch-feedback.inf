node 12 Source Formula
  pos 4040 -6060
  flags 1 0 1 0
  s formula    vec2 q = p;\n   float k = 6.0 + uA * 10.0;\n   for (int i = 0; i < 24; i++) {\n      float a = sin(q.x * k + t * 0.3) + cos(q.y * k - t * 0.2);\n      q += vec2(cos(a), sin(a)) * 0.008 * (0.5 + uB);\n   }\n   float v = sin(length(q) * 20.0 + atan(q.y, q.x) * 3.0);\n   return vec4(0.5 + 0.5 * cos(vec3(0.0, 2.0, 4.0) + v * 2.0 + uC * 6.0), 1.0);
