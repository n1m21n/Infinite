node 65 Synths Field Synth
  uid 128
  pos 26620 -480
  flags 1 0 1 0
  s code param float decay = 0.25 [0.05, 0.8]\nparam float snap = 0.70 [0.0, 1.0]\nparam float toneFreq = 185.0 [100.0, 350.0]\nparam float bodyDecay = 0.12 [0.02, 0.4]\nstate float toneEnv = 0.0\nstate float noiseEnv = 0.0\nstate float phase = 0.0\nstate float nseed = 0.0\nstate float hp = 0.0\n\ntCoeff = clamp(1.0 - 1.0 / (sr * max(bodyDecay, 0.01)), 0.9, 0.9999)\nnCoeff = clamp(1.0 - 1.0 / (sr * max(decay, 0.02)), 0.9, 0.9999)\n\ntoneEnv = if(noteOn > 0.5, noteVel, toneEnv * tCoeff)\nnoiseEnv = if(noteOn > 0.5, noteVel, noiseEnv * nCoeff)\n\nphase = (phase + toneFreq / sr) % 1.0\nbody = sin(6.283185 * phase) * toneEnv * (1.0 - snap * 0.5)\n\nnseed = (nseed + 1.0) % 9973.0\nhsrc = sin(nseed * 12.9898) * 43758.5453\nwhite = 2.0 * (hsrc - floor(hsrc)) - 1.0\nhp = hp + 0.25 * (white - hp)\nnoiseSig = (white - hp) * noiseEnv * snap\n\nmix = body * 1.3 + noiseSig * 1.0\nout = mix / (1.0 + abs(mix) * 0.6)\n
