  s formula    vec2 w = p * (3.0 + uA * 5.0);\n   float acc = 0.0, amp = 0.5;\n   for (int i = 0; i < 5; i++) {\n      vec2 g = floor(w), f = fract(w);\n      f = f * f * (3.0 - 2.0 * f);\n      float n = mix(mix(rand(g), rand(g + vec2(1.0, 0.0)), f.x),\n                    mix(rand(g + vec2(0.0, 1.0)), rand(g + vec2(1.0, 1.0)), f.x), f.y);\n      acc += n * amp;\n      amp *= 0.5;\n      w = w * 2.0 + vec2(acc * uB * 3.0 + t * 0.1, acc * uB * 3.0);\n   }\n   return vec4(0.5 + 0.5 * cos(vec3(0.0, 1.8, 3.6) + acc * 4.0 + uC * 6.0), 1.0);
  f width 1920
  f height 1920
  f knobA 0.549000025
