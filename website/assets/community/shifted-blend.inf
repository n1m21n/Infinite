node 17 Source Formula
  pos 5720 -2340
  flags 1 0 1 0
  s formula    float a = length(p - vec2(0.15 * sin(t * 0.4), 0.0)) * (40.0 + uA * 200.0);\n   float b = length(p + vec2(0.15 * sin(t * 0.4), 0.0)) * (40.0 + uA * 200.0);\n   float v = sin(a) * sin(b);\n   float mask = smoothstep(0.0, 0.02, v);\n   return vec4(mix(vec3(uB * 0.3), vec3(1.0, 1.0, uC), mask), 1.0);
  f width 1024
