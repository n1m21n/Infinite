node 10 Source FieldPixel
  uid 34
  pos 3143 -2317
  flags 1 0 1 0
  s code param float scale = 3.0 [0.5, 8.0];\nparam float speed = 0.5 [0.05, 2.0];\nparam float warp = 1.5 [0.2, 4.0];\nparam float hue = 0.0 [0.0, 1.0];\np = vec2(uv.x * aspect, uv.y) * scale;\nw1 = vec2(sin(p.y * 1.3 + t * speed), cos(p.x * 1.1 - t * speed * 0.8));\np1 = p + w1 * warp;\nw2 = vec2(sin(p1.y * 1.7 - t * speed * 0.6), cos(p1.x * 1.5 + t * speed * 0.9));\np2 = p1 + w2 * warp * 0.6;\nw3 = vec2(sin(p2.y * 2.1 + t * speed * 1.1), cos(p2.x * 1.9 - t * speed * 0.7));\np3 = p2 + w3 * warp * 0.35;\nfield1 = sin(p3.x * 1.3 + p3.y * 0.7);\nfield2 = cos(p3.x * 0.6 - p3.y * 1.4 + t * speed * 0.3);\nliquid = field1 * 0.6 + field2 * 0.4;\npc = liquid * 0.5 + 0.5 + hue;\ncolA = vec3(0.5, 0.45, 0.55);\ncolB = vec3(0.45, 0.4, 0.5);\ncolC = vec3(1.0, 0.9, 0.7);\ncolD = vec3(0.1, 0.35, 0.55);\nbase = colA + colB * cos(6.283185 * (colC * pc + colD));\nhighlight = pow(clamp(liquid - 0.6, 0.0, 1.0) * 2.5, 3.0);\ncol = base + vec3(highlight);
  f width 1440
  f height 1920
  b animate 1
  b exposeAuxTexture 0
  i field_nextParamId 8
  s field_paramMap cellScale:1,density:2,drift:4,hue:7,scale:5,speed:3,warp:6
  f p.cellScale 3.77999997
  f p.density 36.7547989
  f p.drift 0.206131324
  f p.hue 0
  f p.scale 3
  f p.speed 2
  f p.warp 1.5
  s __outputPins 
  s __inputPins 
end
