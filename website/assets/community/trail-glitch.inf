node 37 Source Formula
  pos 5100 -2040
  flags 1 0 1 0
  s formula    float v = 0.0;\n   for (int i = 0; i < 6; i++) {\n      float fi = float(i);\n      vec2 src = 0.4 * vec2(cos(fi * 1.7 + t * 0.2 * uB), sin(fi * 2.3 + t * 0.15 * uB));\n      v += sin(length(p - src) * (30.0 + uA * 120.0) - t * 3.0);\n   }\n   v /= 6.0;\n   vec3 col = 0.5 + 0.5 * cos(6.2831 * (vec3(0.0, 0.3, 0.6) + v + uC));\n   return vec4(col, 1.0);
  f width 1920
  f height 1920
  f knobA 0.5
  f knobB 0.5
  f knobC 0.5
  f knobD 0.5
