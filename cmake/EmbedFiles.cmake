# Turbo 0.70 (A5): text files (shaders/*.glsl, third-party GLSL headers) compiled
# into the exe as null-terminated strings, looked up by file name with
# EmbeddedFile() (src/core/EmbeddedFiles.h).
#   cmake -DFILES="a.glsl|b.h" -DOUT=<cpp> -P EmbedFiles.cmake
# Bytes, not string literals: MSVC caps a literal at ~16 KB and ffx_a.h alone is 180 KB.
# FILES is "|"-separated (a ";" list does not survive add_custom_command).
string(REPLACE "|" ";" FILES "${FILES}")
set(body "")
set(table "")
set(index 0)
foreach(path IN LISTS FILES)
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" hex HEX)
    # 32 bytes per line (MSVC dislikes megabyte-long lines).
    string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND body "static const unsigned char kFile${index}[] = {\n${hex}0x00 };\n")
    string(APPEND table "   { \"${name}\", kFile${index} },\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/EmbedFiles.cmake - do not edit.\n#include <cstring>\n${body}\nnamespace\n{\n   struct Entry\n   {\n      const char* name;\n      const unsigned char* data;\n   };\n   const Entry kFiles[] = {\n${table}   };\n}\n\nconst char* EmbeddedFile(const char* name)\n{\n   for (const Entry& e : kFiles)\n      if (std::strcmp(e.name, name) == 0)\n         return reinterpret_cast<const char*>(e.data);\n   return nullptr;\n}\n")
# Only touch the output when it changed, so an unrelated reconfigure does not rebuild it.
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
