# Turbo 0.62: turns the RTX module's compiled device code into a C++ source.
# cmake -DIN_IR=<optixir> -DIN_PTX=<ptx> -DOUT=<cpp> -P RtxEmbed.cmake
function(rtx_embed path name out)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR bytes "${len} / 2")
    # 16 bytes per line (MSVC dislikes megabyte-long lines).
    string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    set(${out} "${${out}}extern const unsigned char ${name}[] = {\n${body}0x00 };\nextern const size_t ${name}Size = ${bytes};\n" PARENT_SCOPE)
endfunction()

set(text "// Generated by cmake/RtxEmbed.cmake - do not edit.\n#include <cstddef>\n")
rtx_embed("${IN_IR}" kRtxDeviceIr text)
rtx_embed("${IN_PTX}" kRtxKernelsPtx text)
file(WRITE "${OUT}" "${text}")
