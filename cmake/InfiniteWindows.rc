#include <windows.h>

// GLFW's Win32 backend looks up this exact resource name for the native
// title-bar/taskbar icon. Keep IDI_ICON1 for conventional resource tools.
GLFW_ICON ICON "../assets/Infinite.ico"
IDI_ICON1 ICON "../assets/Infinite.ico"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Infinite Project\0"
            VALUE "FileDescription", "Infinite audiovisual modular workstation\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "Infinite\0"
            VALUE "OriginalFilename", "Infinite.exe\0"
            VALUE "ProductName", "Infinite\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
