+            if (!handle->capture.open(path))
+            {
+               outError = "OpenCV/FFmpeg could not open this video";
+               return nullptr;
+            }
          }
       }
 
@@ -216,7 +223,11 @@
          }
          if (v->publishedSerial != v->consumedSerial && !v->publishedPixels.empty())
          {
